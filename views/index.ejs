<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>KelselPDF - Master Your Exams with AI</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <style>
        /* Landing Page specific styles */
        body {
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        
        .hero {
            padding: 8rem 2rem 4rem;
            text-align: center;
            max-width: 1000px;
            margin: 0 auto;
            flex: 1;
        }
        
        .hero h1 {
            font-size: clamp(3rem, 5vw, 5rem);
            line-height: 1.1;
            margin-bottom: 1.5rem;
            background: linear-gradient(135deg, var(--cta-color), var(--success));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: fadeInDown 0.8s ease-out;
        }
        
        .hero p {
            font-size: clamp(1.1rem, 2vw, 1.3rem);
            color: var(--ntxt-color);
            margin-bottom: 2.5rem;
            max-width: 700px;
            margin-left: auto;
            margin-right: auto;
            animation: fadeInUp 0.8s ease-out 0.2s both;
        }
        
        .hero-btns {
            display: flex;
            gap: 1.5rem;
            justify-content: center;
            animation: fadeInUp 0.8s ease-out 0.4s both;
            flex-wrap: wrap;
        }
        
        .features {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            max-width: 1200px;
            margin: 4rem auto;
            padding: 0 2rem;
        }
        
        .feature-card {
            padding: 2.5rem 2rem;
            text-align: center;
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s;
            border: 1px solid var(--cbg-color-2);
        }
        
        .feature-card:hover {
            transform: translateY(-15px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1);
            border-color: var(--cta-color);
        }
        
        .feature-icon {
            font-size: 3.5rem;
            margin-bottom: 1.5rem;
            filter: drop-shadow(0 4px 6px rgba(0,0,0,0.1));
        }
        
        /* Animations */
        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        /* Navigation */
        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 2rem;
            background: var(--neu-color);
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 2px 10px var(--shd-color);
        }
        
        .nav-links {
            display: flex;
            gap: 1.5rem;
            align-items: center;
        }

        /* Mobile Responsiveness */
        @media (max-width: 768px) {
            .hero {
                padding: 4rem 1rem 2rem;
            }
            .hero h1 {
                font-size: 2.2rem;
                line-height: 1.2;
            }
            .hero p {
                font-size: 1rem;
            }
            .hero-btns {
                flex-direction: column;
                width: 100%;
                gap: 1rem;
            }
            .hero-btns .btn, .hero-btns .btn-ai {
                width: 100%;
                padding: 15px 20px !important;
                font-size: 1rem !important;
                box-sizing: border-box;
            }
            .features {
                grid-template-columns: 1fr;
                padding: 0 1rem;
                margin: 2rem auto;
            }
            nav {
                flex-direction: row; /* Keep logo and hamburger on same line */
                justify-content: space-between;
                align-items: center;
                padding: 1rem;
            }
            .mobile-landing-toggle {
                display: block;
                background: transparent;
                border: none;
                color: var(--ntxt-color);
                cursor: pointer;
            }
            .nav-links {
                display: none; /* Hidden by default on mobile */
                flex-direction: column;
                width: 100%;
                position: absolute;
                top: 100%;
                left: 0;
                background: var(--neu-color);
                padding: 1rem;
                box-shadow: 0 4px 6px var(--shd-color);
                border-top: 1px solid var(--cbg-color-2);
            }
            .nav-links.open {
                display: flex;
            }
            .feature-card {
                padding: 1.5rem 1rem;
            }
        }
    </style>
    <link rel="manifest" href="/manifest.json">
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').catch(err => console.log('SW setup failed: ', err));
            });
        }
    </script>
<link rel="icon" media="(prefers-color-scheme: light)" href="/acct/img/favicon-dark.png">
    <link rel="icon" media="(prefers-color-scheme: dark)" href="/acct/img/favicon-light.png">
</head>
<body>
    <nav style="position: sticky; top: 0; z-index: 1000; display: flex; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; justify-content: space-between; width: 100%; max-width: 1200px; margin: 0 auto;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <img id="navLogo" src="/acct/img/KelselPDF.png" alt="Logo" style="height: 40px; transition: 0.3s;">
            </div>
            
            <button class="mobile-landing-toggle" onclick="document.querySelector('.nav-links').classList.toggle('open')" style="display: none;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
            </button>

            <div class="nav-links">
                <% if(locals.user_id) { %>
                    <a href="/dashboard" class="btn btn-ai" style="padding: 10px 20px;">Dashboard</a>
                <% } else { %>
                    <a href="/login" style="color: var(--text-color); text-decoration: none; font-weight: 500;">Login</a>
                    <a href="/register" class="btn btn-ai" style="padding: 10px 20px;">Get Started</a>
                <% } %>
            </div>
        </div>
    </nav>

    <section class="hero">
        <h1>Master Your Exams with AI Intelligence</h1>
        <p>The ultimate platform for modern students. Practice with real exam questions, track your progress with deep analytics, and let our sophisticated AI tutor guide you to perfect scores.</p>
        <div class="hero-btns">
            <% if(locals.user_id) { %>
                <a href="/dashboard" class="btn btn-ai" style="font-size: 1.2rem; padding: 15px 40px; border-radius: 30px;">Go to Dashboard</a>
            <% } else { %>
                <a href="/register" class="btn btn-ai" style="font-size: 1.2rem; padding: 15px 40px; border-radius: 30px;">Start Learning Free</a>
                <a href="/login" class="btn" style="font-size: 1.2rem; padding: 15px 40px; border-radius: 30px;">Access Account</a>
            <% } %>
        </div>
    </section>

    <% if(!locals.user_id) { %>
    <section class="trial-banner" style="max-width: 900px; margin: 2rem auto; padding: 2.5rem; background: linear-gradient(135deg, rgba(76, 175, 80, 0.1), rgba(33, 150, 243, 0.1)); border: 1px solid var(--cbg-color-2); border-radius: 20px; text-align: center; animation: fadeInUp 0.8s ease-out 0.6s both;">
        <h2 style="margin-bottom: 1rem; color: var(--text-color);">Want to test your knowledge first?</h2>
        <p style="color: var(--ntxt-color); margin-bottom: 2rem; font-size: 1.1rem; max-width: 600px; margin-left: auto; margin-right: auto;">Take a one-time free trial exam for General Studies (GST) courses. No account required. Experience our real-time grading engine today!</p>
        <a href="/trial/setup" class="btn" style="background: var(--cta-color); color: white; padding: 15px 40px; font-size: 1.1rem; border-radius: 30px; display: inline-flex; align-items: center; gap: 10px;">
            <span>Take Free Trial Exam</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
    </section>
    <% } %>

    <section class="features">
        <div class="glass-panel feature-card">
            <div class="feature-icon"><img src="/acct/img/Gemini_Generated_Image_xt0afhxt0afhxt0a.png" alt="Mock Exams" style="width: 100px; height: 100px; object-fit: cover; border-radius: 50%; box-shadow: 0 4px 10px rgba(0,0,0,0.2);"></div>
            <h3>Mock Exams</h3>
            <p style="color: var(--ntxt-color); margin-top: 10px; line-height: 1.5;">Experience real exam conditions with strict countdown timers, secure testing environments, and instant grading engines.</p>
        </div>
        <div class="glass-panel feature-card">
            <div class="feature-icon"><img src="/acct/img/Gemini_Generated_Image_cx6v74cx6v74cx6v-removebg-preview.png" alt="AI Tutor" style="width: 100px; height: 100px; object-fit: contain;"></div>
            <h3>AI Tutor</h3>
            <p style="color: var(--ntxt-color); margin-top: 10px; line-height: 1.5;">Generate infinite custom practice questions and receive intelligent feedback on your theory answers instantly.</p>
        </div>
        <div class="glass-panel feature-card">
            <div class="feature-icon"><img src="/acct/img/Gemini_Generated_Image_jwul3ijwul3ijwul-removebg-preview.png" alt="Deep Analytics" style="width: 100px; height: 100px; object-fit: contain;"></div>
            <h3>Deep Analytics</h3>
            <p style="color: var(--ntxt-color); margin-top: 10px; line-height: 1.5;">Track your pass rates, exam completion times, and total course mastery through beautiful visual charts.</p>
        </div>
    </section>

    <footer style="background: var(--cbg-color); border-top: 1px solid var(--cbg-color-2); padding: 4rem 2rem 2rem; margin-top: auto;">
        <div style="max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 3rem; margin-bottom: 3rem;">
            <!-- Brand Column -->
            <div style="display: flex; flex-direction: column; gap: 1rem;">
                <img id="footerLogo" src="/acct/img/KelselPDF.png" alt="KelselPDF" style="height: 32px; width: auto; align-self: flex-start;">
                <p style="color: var(--ntxt-color); font-size: 0.95rem; line-height: 1.6;">
                    The ultimate AI-powered exam preparation platform. Master your courses with personalized tutors and intelligent mock exams.
                </p>
            </div>
            
            <!-- Links Columns -->
            <div style="display: flex; flex-direction: column; gap: 1rem;">
                <h4 style="color: var(--text-color); font-weight: 600; margin-bottom: 0.5rem;">Product</h4>
                <a href="/login" style="color: var(--ntxt-color); text-decoration: none; font-size: 0.95rem; transition: color 0.2s;">Mock Exams</a>
                <a href="/login" style="color: var(--ntxt-color); text-decoration: none; font-size: 0.95rem; transition: color 0.2s;">AI Tutor</a>
                <a href="/login" style="color: var(--ntxt-color); text-decoration: none; font-size: 0.95rem; transition: color 0.2s;">Study Analytics</a>
            </div>

            <div style="display: flex; flex-direction: column; gap: 1rem;">
                <h4 style="color: var(--text-color); font-weight: 600; margin-bottom: 0.5rem;">Company</h4>
                <a href="/vision" style="color: var(--ntxt-color); text-decoration: none; font-size: 0.95rem; transition: color 0.2s;">Our Vision</a>
                <a href="/privacy" style="color: var(--ntxt-color); text-decoration: none; font-size: 0.95rem; transition: color 0.2s;">Privacy Policy</a>
                <a href="/terms" style="color: var(--ntxt-color); text-decoration: none; font-size: 0.95rem; transition: color 0.2s;">Terms of Service</a>
            </div>

            <div style="display: flex; flex-direction: column; gap: 1rem;">
                <h4 style="color: var(--text-color); font-weight: 600; margin-bottom: 0.5rem;">Connect</h4>
                <a href="mailto:support@kelselpdf.com" style="color: var(--ntxt-color); text-decoration: none; font-size: 0.95rem; transition: color 0.2s;">Contact Support</a>
                <a href="#" style="color: var(--ntxt-color); text-decoration: none; font-size: 0.95rem; transition: color 0.2s;">Twitter / X</a>
                <a href="#" style="color: var(--ntxt-color); text-decoration: none; font-size: 0.95rem; transition: color 0.2s;">Discord Community</a>
            </div>
        </div>
        
        <div style="max-width: 1200px; margin: 0 auto; text-align: center; padding-top: 2rem; border-top: 1px solid var(--cbg-color-2);">
            <p style="color: var(--ntxt-color); font-size: 0.9rem;">&copy; 2026 KelselPDF. Built for student success.</p>
        </div>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const logo = document.getElementById('navLogo');
            const footerLogo = document.getElementById('footerLogo');
            
            // Watch for theme changes applied by theme.js
            const observer = new MutationObserver((mutations) => {
                mutations.forEach((mutation) => {
                    if (mutation.attributeName === 'data-theme') {
                        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
                        logo.src = isDark ? '/acct/img/KelselPDF 2.png' : '/acct/img/KelselPDF.png';
                        if (footerLogo) footerLogo.src = isDark ? '/acct/img/KelselPDF 2.png' : '/acct/img/KelselPDF.png';
                    }
                });
            });
            
            observer.observe(document.documentElement, { attributes: true });
            
            // Initial check
            const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
            if (isDark) {
                logo.src = '/acct/img/KelselPDF 2.png';
                if (footerLogo) footerLogo.src = '/acct/img/KelselPDF 2.png';
            }
        });
    </script>
</body>
</html>





