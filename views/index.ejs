    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const logo = document.getElementById('navLogo');
            const footerLogo = document.getElementById('footerLogo');
            
            // Watch for theme changes applied by theme.js
            const observer = new MutationObserver((mutations) => {
                mutations.forEach((mutation) => {
                    if (mutation.attributeName === 'data-theme') {
                        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
                        logo.src = isDark ? '/acct/img/KelselPDF 2.png' : '/acct/img/KelselPDF.png';
                        if (footerLogo) footerLogo.src = isDark ? '/acct/img/KelselPDF 2.png' : '/acct/img/KelselPDF.png';
                    }
                });
            });
            
            observer.observe(document.documentElement, { attributes: true });
            
            // Initial check
            const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
            if (isDark) {
                logo.src = '/acct/img/KelselPDF 2.png';
                if (footerLogo) footerLogo.src = '/acct/img/KelselPDF 2.png';
            }

            // --- GSAP Immersive Animations ---
            if (typeof gsap !== 'undefined') {
                gsap.registerPlugin(ScrollTrigger);

                // Ambient Orbs Floating
                gsap.to(".orb-1", { y: -50, x: 50, duration: 6, repeat: -1, yoyo: true, ease: "sine.inOut" });
                gsap.to(".orb-2", { y: 50, x: -50, duration: 8, repeat: -1, yoyo: true, ease: "sine.inOut" });
                gsap.to(".orb-3", { scale: 1.2, duration: 5, repeat: -1, yoyo: true, ease: "sine.inOut" });

                // Hero Reveal
                gsap.set(".hero h1, .hero p, .hero-btns", { y: 30 });
                const tl = gsap.timeline();
                tl.to(".hero h1", { opacity: 1, y: 0, duration: 1, ease: "power3.out", delay: 0.2 })
                  .to(".hero p", { opacity: 1, y: 0, duration: 1, ease: "power3.out" }, "-=0.6")
                  .to(".hero-btns", { opacity: 1, y: 0, duration: 1, ease: "power3.out" }, "-=0.6");

                // Dashboard 3D Parallax Reveal
                gsap.to(".dashboard-mockup", {
                    scrollTrigger: {
                        trigger: ".dashboard-preview",
                        start: "top 85%",
                        end: "center 50%",
                        scrub: 1
                    },
                    rotateX: 0,
                    scale: 1,
                    boxShadow: "0 30px 60px rgba(0,0,0,0.3)"
                });

                // Features Stagger Reveal
                gsap.set(".feature-card", { y: 40 });
                gsap.to(".feature-card", {
                    scrollTrigger: {
                        trigger: ".features",
                        start: "top 85%"
                    },
                    opacity: 1,
                    y: 0,
                    duration: 0.8,
                    stagger: 0.2,
                    ease: "power3.out"
                });
                // Testimonials Stagger Reveal
                gsap.to(".testimonial-card", {
                    scrollTrigger: {
                        trigger: ".testimonials",
                        start: "top 85%"
                    },
                    opacity: 1,
                    y: 0,
                    duration: 0.8,
                    stagger: 0.2,
                    ease: "power3.out"
                });

                // Contact Card Reveal
                gsap.to(".contact-card", {
                    scrollTrigger: {
                        trigger: ".contact-section",
                        start: "top 85%"
                    },
                    opacity: 1,
                    scale: 1,
                    duration: 0.8,
                    ease: "back.out(1.7)"
                });
            }
        });
    </script>
