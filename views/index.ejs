    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const logo = document.getElementById('navLogo');
            const footerLogo = document.getElementById('footerLogo');
            const isMobile = window.innerWidth <= 768;
            
            // Watch for theme changes applied by theme.js
            const observer = new MutationObserver((mutations) => {
                mutations.forEach((mutation) => {
                    if (mutation.attributeName === 'data-theme') {
                        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
                        if (logo) logo.src = isDark ? '/acct/img/KelselPDF 2.png' : '/acct/img/KelselPDF.png';
                        if (footerLogo) footerLogo.src = isDark ? '/acct/img/KelselPDF 2.png' : '/acct/img/KelselPDF.png';
                    }
                });
            });
            
            observer.observe(document.documentElement, { attributes: true });
            
            // Initial check
            const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
            if (isDark) {
                if (logo) logo.src = '/acct/img/KelselPDF 2.png';
                if (footerLogo) footerLogo.src = '/acct/img/KelselPDF 2.png';
            }

            // Disable vanilla tilt on mobile/touch screens to preserve smooth scrolling
            if (isMobile && typeof VanillaTilt !== 'undefined') {
                document.querySelectorAll('[data-tilt]').forEach(el => {
                    if (el.vanillaTilt) el.vanillaTilt.destroy();
                });
            }

            // --- GSAP Immersive Animations ---
            if (typeof gsap !== 'undefined') {
                gsap.registerPlugin(ScrollTrigger);

                // Ambient Orbs Floating
                gsap.to(".orb-1", { y: -50, x: 50, duration: 6, repeat: -1, yoyo: true, ease: "sine.inOut" });
                gsap.to(".orb-2", { y: 50, x: -50, duration: 8, repeat: -1, yoyo: true, ease: "sine.inOut" });
                gsap.to(".orb-3", { scale: 1.2, duration: 5, repeat: -1, yoyo: true, ease: "sine.inOut" });

                // Hero Reveal
                gsap.set(".hero-badge, .hero h1, .hero p, .hero-btns", { y: 25, opacity: 0 });
                const tl = gsap.timeline();
                tl.to(".hero-badge", { opacity: 1, y: 0, duration: 0.9, ease: "power3.out", delay: 0.15 })
                  .to(".hero h1", { opacity: 1, y: 0, duration: 0.9, ease: "power3.out" }, "-=0.7")
                  .to(".hero p", { opacity: 1, y: 0, duration: 0.9, ease: "power3.out" }, "-=0.7")
                  .to(".hero-btns", { opacity: 1, y: 0, duration: 0.9, ease: "power3.out" }, "-=0.7");

                // Dashboard Preview Reveal
                if (!isMobile) {
                    gsap.to(".dashboard-mockup", {
                        scrollTrigger: {
                            trigger: ".dashboard-preview",
                            start: "top 85%",
                            end: "center 50%",
                            scrub: 1
                        },
                        rotateX: 0,
                        scale: 1,
                        boxShadow: "0 30px 60px rgba(0,0,0,0.25)"
                    });
                } else {
                    gsap.fromTo(".dashboard-mockup", 
                        { opacity: 0, y: 25 },
                        { 
                            scrollTrigger: { trigger: ".dashboard-preview", start: "top 85%" },
                            opacity: 1, y: 0, duration: 0.8, ease: "power3.out" 
                        }
                    );
                }

                // ScrollTrigger for Feature Panels
                gsap.utils.toArray('.feature-panel').forEach(panel => {
                    const text = panel.querySelector('.feature-text');
                    const visual = panel.querySelector('.feature-visual');
                    
                    gsap.fromTo(text, 
                        { y: 35, opacity: 0 }, 
                        { 
                            scrollTrigger: { trigger: panel, start: "top 75%" }, 
                            y: 0, opacity: 1, duration: 0.8, ease: "power3.out" 
                        }
                    );
                    
                    gsap.fromTo(visual, 
                        { scale: 0.92, opacity: 0, y: 35 }, 
                        { 
                            scrollTrigger: { trigger: panel, start: "top 75%" }, 
                            scale: 1, opacity: 1, y: 0, duration: 0.8, ease: "power3.out", delay: 0.15 
                        }
                    );
                });

                // Testimonials Stagger Reveal
                gsap.to(".testimonial-card", {
                    scrollTrigger: {
                        trigger: ".testimonials",
                        start: "top 85%"
                    },
                    opacity: 1,
                    y: 0,
                    duration: 0.8,
                    stagger: 0.15,
                    ease: "power3.out"
                });

                // Contact Card Reveal
                gsap.to(".contact-card", {
                    scrollTrigger: {
                        trigger: ".contact-section",
                        start: "top 85%"
                    },
                    opacity: 1,
                    scale: 1,
                    duration: 0.8,
                    ease: "back.out(1.5)"
                });
            }
        });
    </script>
