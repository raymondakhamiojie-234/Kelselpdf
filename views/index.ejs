<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>KelselPDF - Master Your Exams with AI</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.0/vanilla-tilt.min.js"></script>
    <style>
        /* Immersive Landing Page styles */
        body {
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            background: var(--cbg-color); /* Fallback */
            position: relative;
        }

        /* 3D Dynamic Background */
        .ambient-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -1;
            overflow: hidden;
            pointer-events: none;
            background: var(--cbg-color);
        }
        
        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(100px);
            opacity: 0.4;
            will-change: transform;
        }

        .orb-1 { width: 40vw; height: 40vw; background: rgba(33, 150, 243, 0.4); top: -10%; left: -10%; }
        .orb-2 { width: 35vw; height: 35vw; background: rgba(76, 175, 80, 0.3); bottom: -10%; right: -10%; }
        .orb-3 { width: 30vw; height: 30vw; background: rgba(156, 39, 176, 0.3); top: 40%; left: 40%; }
        
        .hero {
            padding: 10rem 2rem 6rem;
            text-align: center;
            max-width: 1000px;
            margin: 0 auto;
            flex: 1;
            position: relative;
            z-index: 1;
        }
        
        .hero h1 {
            font-size: clamp(3rem, 6vw, 6rem);
            line-height: 1.1;
            margin-bottom: 1.5rem;
            background: linear-gradient(135deg, var(--cta-color), var(--success));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            opacity: 0; /* GSAP will reveal */
        }
        
        .hero p {
            font-size: clamp(1.1rem, 2vw, 1.3rem);
            color: var(--ntxt-color);
            margin-bottom: 2.5rem;
            max-width: 700px;
            margin-left: auto;
            margin-right: auto;
            opacity: 0; /* GSAP will reveal */
        }
        
        .hero-btns {
            display: flex;
            gap: 1.5rem;
            justify-content: center;
            flex-wrap: wrap;
            opacity: 0; /* GSAP will reveal */
        }
        
        /* 3D Dashboard Preview */
        .dashboard-preview {
            max-width: 1100px;
            margin: 4rem auto 8rem;
            padding: 0 2rem;
            perspective: 1200px;
            position: relative;
            z-index: 2;
        }
        
        .dashboard-mockup {
            width: 100%;
            height: 600px;
            background: var(--neu-color);
            border-radius: 20px;
            border: 1px solid var(--cbg-color-2);
            box-shadow: 0 25px 50px rgba(0,0,0,0.2), 0 0 0 1px rgba(255,255,255,0.05);
            overflow: hidden;
            transform: rotateX(20deg) scale(0.9);
            transform-style: preserve-3d;
            transition: box-shadow 0.5s;
        }
        
        .dashboard-mockup::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; height: 100%;
            background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, transparent 100%);
            pointer-events: none;
            z-index: 10;
        }
        
        .features { display: flex; flex-wrap: wrap; justify-content: center; gap: 2.5rem; max-width: 1200px; margin: 4rem auto 8rem; padding: 0 2rem; position: relative; z-index: 2; }
        
        .feature-card { flex: 1 1 300px; max-width: 350px; padding: 3rem 2rem; text-align: center;
            border: 1px solid var(--cbg-color-2);
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-radius: 24px;
            transform-style: preserve-3d;
            transform: perspective(1000px);
            opacity: 0; /* GSAP will reveal */
        }
        
        .feature-icon {
            font-size: 3.5rem;
            margin-bottom: 1.5rem;
            transform: translateZ(30px); /* 3D pop out */
        }
        
        .feature-card h3 {
            transform: translateZ(20px);
        }
        .feature-card p {
            transform: translateZ(10px);
        }
        
        /* Navigation */
        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 2rem;
            background: var(--neu-color);
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 2px 10px var(--shd-color);
        }
        
        .nav-links {
            display: flex;
            gap: 1.5rem;
            align-items: center;
        }

        /* Mobile Responsiveness */
        @media (max-width: 768px) {
            .hero {
                padding: 4rem 1rem 2rem;
            }
            .hero h1 {
                font-size: 2.2rem;
                line-height: 1.2;
            }
            .hero p {
                font-size: 1rem;
            }
            .hero-btns {
                flex-direction: column;
                width: 100%;
                gap: 1rem;
            }
            .hero-btns .btn, .hero-btns .btn-ai {
                width: 100%;
                padding: 15px 20px !important;
                font-size: 1rem !important;
                box-sizing: border-box;
            }
            .features {
                grid-template-columns: 1fr;
                padding: 0 1rem;
                margin: 2rem auto;
            }
            nav {
                flex-direction: row; /* Keep logo and hamburger on same line */
                justify-content: space-between;
                align-items: center;
                padding: 1rem;
            }
            .mobile-landing-toggle {
                display: block;
                background: transparent;
                border: none;
                color: var(--ntxt-color);
                cursor: pointer;
            }
            .nav-links {
                display: none; /* Hidden by default on mobile */
                flex-direction: column;
                width: 100%;
                position: absolute;
                top: 100%;
                left: 0;
                background: var(--neu-color);
                padding: 1rem;
                box-shadow: 0 4px 6px var(--shd-color);
                border-top: 1px solid var(--cbg-color-2);
            }
            .nav-links.open {
                display: flex;
            }
            .feature-card {
                padding: 1.5rem 1rem;
            }
        }
    </style>
    <link rel="manifest" href="/manifest.json">
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').catch(err => console.log('SW setup failed: ', err));
            });
        }
    </script>
<link rel="icon" media="(prefers-color-scheme: light)" href="/acct/img/favicon-dark.png">
