<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta charset="UTF-8">
    <title>Candidate & User Management - Executive Admin Console</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <link rel="manifest" href="/manifest.json">
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').catch(err => console.log('SW setup failed: ', err));
            });
        }
    </script>
    <link rel="icon" media="(prefers-color-scheme: light)" href="/acct/img/favicon-dark.png">
    <link rel="icon" media="(prefers-color-scheme: dark)" href="/acct/img/favicon-light.png">
</head>
<body class="dashboard-body admin-body">
    <%- include('./partials/admin_sidebar', { active_page: 'admin_users' }) %>

    <main class="admin-main-content">
        <!-- Top Executive Bar -->
        <header class="admin-topbar">
            <div style="display: flex; align-items: center; gap: 14px;">
                <button class="admin-mobile-toggle" onclick="toggleAdminNav()" aria-label="Toggle Navigation">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                </button>
                <div>
                    <h1 class="admin-title">Candidate & User Management</h1>
                    <p class="admin-subtitle">Master candidate directory, role delegation, security permissions & department assignments.</p>
                </div>
            </div>
            <div class="admin-topbar-actions">
                <button onclick="exportUsersCSV()" class="btn btn-outline" style="border-radius: 8px; font-weight: 600; font-size: 0.85rem; padding: 8px 14px; display: inline-flex; align-items: center; gap: 6px; cursor: pointer;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    <span>Export CSV</span>
                </button>
                <a href="/admin" class="btn btn-outline" style="border-radius: 8px; font-weight: 600; font-size: 0.85rem; padding: 8px 14px; text-decoration: none;">
                    &larr; Overview
                </a>
            </div>
        </header>

        <%
            let adminCount = 0;
            let studentCount = 0;
            const deptsSet = new Set();

            users.forEach(u => {
                if (u.role === 'admin') adminCount++;
                else studentCount++;
                if (u.department_id) deptsSet.add(u.department_id);
            });
        %>

        <!-- KPI Metrics Grid -->
        <div class="kpi-grid">
            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Total Registered Candidates</div>
                        <div class="kpi-value"><%= users.length.toLocaleString() %></div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(59, 130, 246, 0.12); color: #3b82f6;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #3b82f6; font-weight: 600;">Active Registry</span>
                    <span>&bull; Verified Accounts</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Platform Administrators</div>
                        <div class="kpi-value" style="color: #8b5cf6;"><%= adminCount %></div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(139, 92, 246, 0.12); color: #8b5cf6;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #8b5cf6; font-weight: 600;">Full Access</span>
                    <span>&bull; Super Admins</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Active Students</div>
                        <div class="kpi-value"><%= studentCount %></div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(16, 185, 129, 0.12); color: #10b981;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #10b981; font-weight: 600;">Learners</span>
                    <span>&bull; CBT Exam Takers</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Departments Active</div>
                        <div class="kpi-value"><%= deptsSet.size %></div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(245, 158, 11, 0.12); color: #f59e0b;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span>Faculty Segments</span>
                    <span>&bull; Level Groupings</span>
                </div>
            </div>
        </div>

        <!-- Directory Container -->
        <div class="admin-panel">
            <!-- Filter Toolbar -->
            <div class="admin-filter-bar">
                <div class="admin-search-box">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="text" id="userSearch" placeholder="Search candidate by name, email, department or level..." onkeyup="filterUsers()">
                </div>
                <div class="admin-filter-group">
                    <select id="roleFilter" class="admin-select" onchange="filterUsers()">
                        <option value="all">All Roles</option>
                        <option value="admin">Administrators</option>
                        <option value="student">Students</option>
                    </select>

                    <select id="deptFilter" class="admin-select" onchange="filterUsers()">
                        <option value="all">All Departments</option>
                        <option value="computer science">Computer Science</option>
                        <option value="electrical engineering">Electrical Engineering</option>
                        <option value="business administration">Business Administration</option>
                        <option value="general">General / Other</option>
                    </select>

                    <span style="font-size: 0.85rem; color: var(--ntxt-color); padding-left: 6px;">
                        Showing <strong id="visibleCount" style="color: var(--text-color);"><%= users.length %></strong> of <%= users.length %>
                    </span>
                </div>
            </div>

            <!-- Responsive Table -->
            <div class="table-responsive">
                <table class="data-table" id="usersTable">
                    <thead>
                        <tr>
                            <th>Candidate</th>
                            <th>Academic Profile</th>
                            <th>Role & Access</th>
                            <th>Date Registered</th>
                            <th style="text-align: right;">Administrative Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (users.length === 0) { %>
                            <tr>
                                <td colspan="5" style="text-align: center; padding: 3rem 1rem; color: var(--ntxt-color);">
                                    <div style="font-size: 2.2rem; margin-bottom: 8px;">👥</div>
                                    <div style="font-weight: 700; font-size: 1.05rem; color: var(--text-color);">No candidates found</div>
                                </td>
                            </tr>
                        <% } else { %>
                            <% users.forEach((u, idx) => { 
                                const isAdmin = u.role === 'admin';
                                let deptName = u.department_id || 'General';
                                if (deptName === '1') deptName = 'Computer Science';
                                else if (deptName === '2') deptName = 'Electrical Engineering';
                                else if (deptName === '3') deptName = 'Business Administration';

                                const initials = u.full_name ? u.full_name.split(' ').map(n=>n[0]).slice(0,2).join('').toUpperCase() : 'U';
                            %>
                            <tr class="user-row" 
                                data-name="<%= (u.full_name || '').toLowerCase() %>" 
                                data-email="<%= (u.email || '').toLowerCase() %>" 
                                data-dept="<%= deptName.toLowerCase() %>"
                                data-role="<%= (u.role || 'student').toLowerCase() %>">
                                <td>
                                    <div style="display: flex; align-items: center; gap: 12px;">
                                        <div class="user-avatar-initial" style="background: <%= isAdmin ? 'linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%)' : (idx % 2 === 0 ? 'linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%)' : 'linear-gradient(135deg, #10b981 0%, #059669 100%)') %>;">
                                            <%= initials %>
                                        </div>
                                        <div>
                                            <strong style="color: var(--text-color); font-size: 0.92rem; display: block;"><%= u.full_name || 'Anonymous User' %></strong>
                                            <span style="color: var(--ntxt-color); font-size: 0.8rem;"><%= u.email || 'N/A' %></span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div style="font-size: 0.88rem; color: var(--text-color); font-weight: 600;">
                                        <%= u.level ? `${u.level} Level` : 'Undergraduate' %>
                                    </div>
                                    <span style="font-size: 0.78rem; color: var(--ntxt-color);">
                                        <%= deptName %>
                                    </span>
                                </td>
                                <td>
                                    <% if (isAdmin) { %>
                                        <span class="badge-pill purple">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                                            <span>Administrator</span>
                                        </span>
                                    <% } else { %>
                                        <span class="badge-pill info">
                                            <span>Student</span>
                                        </span>
                                    <% } %>
                                </td>
                                <td>
                                    <div style="font-size: 0.88rem; color: var(--text-color);">
                                        <%= new Date(u.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                    </div>
                                    <small style="color: var(--ntxt-color); font-size: 0.75rem;">
                                        ID #<%= u.id %>
                                    </small>
                                </td>
                                <td style="text-align: right;">
                                    <div style="display: flex; gap: 8px; justify-content: flex-end; align-items: center; flex-wrap: wrap;">
                                        <!-- Role Toggle Form -->
                                        <form action="/admin/users/role" method="POST" style="margin: 0; display: inline-block;">
                                            <input type="hidden" name="user_id" value="<%= u.id %>">
                                            <% if (isAdmin) { %>
                                                <input type="hidden" name="role" value="student">
                                                <button type="submit" class="btn btn-outline" style="border-radius: 8px; font-weight: 600; font-size: 0.78rem; padding: 6px 10px; color: var(--ntxt-color); border-color: var(--border-color); cursor: pointer;" title="Revoke admin access">
                                                    Demote
                                                </button>
                                            <% } else { %>
                                                <input type="hidden" name="role" value="admin">
                                                <button type="submit" class="btn btn-outline" style="border-radius: 8px; font-weight: 600; font-size: 0.78rem; padding: 6px 10px; color: #8b5cf6; border-color: rgba(139, 92, 246, 0.4); cursor: pointer;" title="Grant administrative privileges">
                                                    Make Admin
                                                </button>
                                            <% } %>
                                        </form>

                                        <!-- Delete Account Form -->
                                        <form action="/admin/users/delete" method="POST" style="margin: 0; display: inline-block;" onsubmit="return confirm('Permanently delete <%= u.full_name %>? All attempts, submissions, and history will be deleted.');">
                                            <input type="hidden" name="user_id" value="<%= u.id %>">
                                            <button type="submit" class="btn btn-outline" style="border-radius: 8px; font-weight: 600; font-size: 0.78rem; padding: 6px 10px; color: #ef4444; border-color: rgba(239, 68, 68, 0.35); cursor: pointer;" title="Delete this account">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle;"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
                <div id="noMatchMessage" style="display: none; text-align: center; padding: 2.5rem 1rem; color: var(--ntxt-color);">
                    <div style="font-size: 2rem; margin-bottom: 6px;">🔍</div>
                    <div style="font-weight: 700; color: var(--text-color);">No matching candidates found</div>
                    <p style="margin: 4px 0 0 0; font-size: 0.85rem;">Try adjusting your search terms or role filters.</p>
                </div>
            </div>
        </div>
    </main>

    <script>
        function filterUsers() {
            const query = document.getElementById('userSearch').value.toLowerCase().trim();
            const roleFilter = document.getElementById('roleFilter').value.toLowerCase();
            const deptFilter = document.getElementById('deptFilter').value.toLowerCase();
            const rows = document.querySelectorAll('.user-row');
            let visible = 0;

            rows.forEach(row => {
                const name = row.getAttribute('data-name') || '';
                const email = row.getAttribute('data-email') || '';
                const dept = row.getAttribute('data-dept') || '';
                const role = row.getAttribute('data-role') || '';

                const matchesQuery = !query || name.includes(query) || email.includes(query) || dept.includes(query);
                const matchesRole = roleFilter === 'all' || role === roleFilter;
                const matchesDept = deptFilter === 'all' || dept.includes(deptFilter);

                if (matchesQuery && matchesRole && matchesDept) {
                    row.style.display = '';
                    visible++;
                } else {
                    row.style.display = 'none';
                }
            });

            const countEl = document.getElementById('visibleCount');
            if (countEl) countEl.textContent = visible;

            const noMatch = document.getElementById('noMatchMessage');
            if (noMatch) {
                noMatch.style.display = (visible === 0 && rows.length > 0) ? 'block' : 'none';
            }
        }

        function exportUsersCSV() {
            const rows = Array.from(document.querySelectorAll('#usersTable tr'));
            if (!rows.length) return;
            let csv = [];
            rows.forEach(row => {
                if (row.style.display === 'none') return;
                const cols = Array.from(row.querySelectorAll('th, td'));
                // Exclude action column
                const dataCols = cols.slice(0, cols.length - 1);
                const rowData = dataCols.map(col => {
                    let text = col.innerText.replace(/[\n\r]+/g, ' ').replace(/"/g, '""').trim();
                    return `"${text}"`;
                });
                csv.push(rowData.join(','));
            });
            const blob = new Blob([csv.join('\n')], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = `kelsel-candidates-registry-${new Date().toISOString().split('T')[0]}.csv`;
            link.click();
        }
    </script>
</body>
</html>
