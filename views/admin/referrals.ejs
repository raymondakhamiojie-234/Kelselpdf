<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta charset="UTF-8">
    <title>Referrals & Affiliates - Executive Admin Console</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <link rel="manifest" href="/manifest.json">
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').catch(err => console.log('SW setup failed: ', err));
            });
        }
    </script>
    <link rel="icon" media="(prefers-color-scheme: light)" href="/acct/img/favicon-dark.png">
    <link rel="icon" media="(prefers-color-scheme: dark)" href="/acct/img/favicon-light.png">
    <style>
        .voucher-code {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(59, 130, 246, 0.08);
            border: 1px dashed rgba(59, 130, 246, 0.4);
            padding: 5px 12px;
            border-radius: 6px;
            font-family: monospace;
            font-weight: 800;
            font-size: 0.95rem;
            color: var(--primary-color);
            letter-spacing: 0.5px;
        }
        .copy-toast {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: #10b981;
            color: #ffffff;
            padding: 12px 20px;
            border-radius: 10px;
            box-shadow: 0 10px 25px rgba(16, 185, 129, 0.4);
            font-weight: 600;
            font-size: 0.9rem;
            z-index: 9999;
            display: flex;
            align-items: center;
            gap: 10px;
            opacity: 0;
            transform: translateY(20px);
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            pointer-events: none;
        }
        .copy-toast.show {
            opacity: 1;
            transform: translateY(0);
        }
    </style>
</head>
<body class="dashboard-body admin-body">
    <%- include('./partials/admin_sidebar', { active_page: 'admin_referrals' }) %>

    <main class="admin-main-content">
        <!-- Top Executive Bar -->
        <header class="admin-topbar">
            <div style="display: flex; align-items: center; gap: 14px;">
                <button class="admin-mobile-toggle" onclick="toggleAdminNav()" aria-label="Toggle Navigation">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                </button>
                <div>
                    <h1 class="admin-title">Referrals & Affiliates</h1>
                    <p class="admin-subtitle">Generate referral campaigns, track affiliate signups and conversion metrics.</p>
                </div>
            </div>
            <div class="admin-topbar-actions">
                <a href="/admin" class="btn btn-outline" style="border-radius: 8px; font-weight: 600; font-size: 0.85rem; padding: 8px 14px; text-decoration: none;">
                    &larr; Overview
                </a>
            </div>
        </header>

        <%
            let totalSignups = 0;
            let totalPaid = 0;
            referrals.forEach(r => {
                totalSignups += parseInt(r.total_signups || 0);
                totalPaid += parseInt(r.paid_signups || 0);
            });
            const convRate = totalSignups > 0 ? Math.round((totalPaid / totalSignups) * 100) : 0;
        %>

        <!-- KPI Metrics Grid -->
        <div class="kpi-grid">
            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Active Campaigns</div>
                        <div class="kpi-value"><%= referrals.length %></div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(59, 130, 246, 0.12); color: #3b82f6;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #3b82f6; font-weight: 600;">Promo Links</span>
                    <span>&bull; Affiliate Codes</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Invited Registrations</div>
                        <div class="kpi-value"><%= totalSignups %></div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(139, 92, 246, 0.12); color: #8b5cf6;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span>New Candidates</span>
                    <span>&bull; via Referrals</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Paid Conversions</div>
                        <div class="kpi-value" style="color: #10b981;"><%= totalPaid %></div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(16, 185, 129, 0.12); color: #10b981;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #10b981; font-weight: 600;">Subscribers</span>
                    <span>&bull; Paid Checkouts</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Conversion Rate</div>
                        <div class="kpi-value"><%= convRate %>%</div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(245, 158, 11, 0.12); color: #f59e0b;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #f59e0b; font-weight: 600;">Signup to Paid</span>
                    <span>&bull; Efficiency</span>
                </div>
            </div>
        </div>

        <!-- Campaign Generator Panel -->
        <div class="admin-panel">
            <h2 style="font-size: 1.15rem; font-weight: 700; color: var(--text-color); margin: 0 0 6px 0;">Generate New Referral Campaign</h2>
            <p style="font-size: 0.85rem; color: var(--ntxt-color); margin: 0 0 18px 0;">Create a branded tracking code for student ambassadors, social channels, or school partners.</p>

            <form action="/admin/referrals" method="POST" style="display: flex; gap: 14px; align-items: flex-end; flex-wrap: wrap;">
                <div style="flex: 1; min-width: 220px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;">
                        <label style="font-size: 0.8rem; font-weight: 600; color: var(--text-color);">Referral Code *</label>
                        <button type="button" onclick="generateRandomCode()" style="background: none; border: none; color: var(--primary-color); font-size: 0.75rem; font-weight: 600; cursor: pointer; padding: 0;">
                            ↻ Randomize
                        </button>
                    </div>
                    <input type="text" id="refCodeInput" name="code" required placeholder="e.g. CAMPUS2026" style="width: 100%; box-sizing: border-box; text-transform: uppercase; padding: 10px 12px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--bg-color); color: var(--text-color); font-weight: 700; font-family: monospace;">
                </div>

                <div style="flex: 2; min-width: 280px;">
                    <label style="display: block; font-size: 0.8rem; font-weight: 600; color: var(--text-color); margin-bottom: 5px;">Affiliate / Campaign Description</label>
                    <input type="text" name="description" placeholder="e.g. AAU Student Union Ambassador - Faculty of Science" style="width: 100%; box-sizing: border-box; padding: 10px 12px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--bg-color); color: var(--text-color);">
                </div>

                <div>
                    <button type="submit" class="btn btn-primary" style="padding: 10.5px 22px; border-radius: 8px; font-weight: 700; font-size: 0.88rem; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        <span>Generate Link</span>
                    </button>
                </div>
            </form>
        </div>

        <!-- Active Referral Links Panel -->
        <div class="admin-panel">
            <!-- Filter Toolbar -->
            <div class="admin-filter-bar">
                <div class="admin-search-box">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="text" id="refSearch" placeholder="Search referral code or campaign description..." onkeyup="filterReferrals()">
                </div>
                <div class="admin-filter-group">
                    <span style="font-size: 0.85rem; color: var(--ntxt-color); padding-left: 6px;">
                        Showing <strong id="visibleRefCount" style="color: var(--text-color);"><%= referrals.length %></strong> of <%= referrals.length %>
                    </span>
                </div>
            </div>

            <!-- Responsive Table -->
            <div class="table-responsive">
                <table class="data-table" id="refTable">
                    <thead>
                        <tr>
                            <th>Referral Code</th>
                            <th>Campaign / Beneficiary</th>
                            <th>Registrations</th>
                            <th>Paid Conversions</th>
                            <th>Created Date</th>
                            <th style="text-align: right;">Share Link</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (referrals.length === 0) { %>
                            <tr>
                                <td colspan="6" style="text-align: center; padding: 3rem 1rem; color: var(--ntxt-color);">
                                    <div style="font-size: 2.2rem; margin-bottom: 8px;">🔗</div>
                                    <div style="font-weight: 700; font-size: 1.05rem; color: var(--text-color);">No referral campaigns active</div>
                                    <p style="margin: 4px 0 0 0; font-size: 0.85rem;">Generate your first referral code above to start tracking affiliate registrations.</p>
                                </td>
                            </tr>
                        <% } else { %>
                            <% referrals.forEach(r => { 
                                const signups = parseInt(r.total_signups || 0);
                                const paid = parseInt(r.paid_signups || 0);
                                const rate = signups > 0 ? Math.round((paid / signups) * 100) : 0;
                            %>
                            <tr class="ref-row"
                                data-code="<%= (r.code || '').toLowerCase() %>"
                                data-desc="<%= (r.description || '').toLowerCase() %>">
                                <td>
                                    <div class="voucher-code">
                                        <span>🏷 <%= r.code %></span>
                                    </div>
                                </td>
                                <td>
                                    <strong style="color: var(--text-color); font-size: 0.92rem; display: block;"><%= r.description || 'General Campaign' %></strong>
                                    <small style="color: var(--ntxt-color); font-size: 0.78rem;">Affiliate Channel</small>
                                </td>
                                <td>
                                    <span class="badge-pill info">
                                        <%= signups %> Candidate<%= signups === 1 ? '' : 's' %>
                                    </span>
                                </td>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <span class="badge-pill success">
                                            <%= paid %> Paid
                                        </span>
                                        <% if (signups > 0) { %>
                                            <small style="color: var(--ntxt-color); font-size: 0.75rem; font-weight: 600;">
                                                (<%= rate %>%)
                                            </small>
                                        <% } %>
                                    </div>
                                </td>
                                <td>
                                    <div style="font-size: 0.88rem; color: var(--text-color);">
                                        <%= new Date(r.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                    </div>
                                </td>
                                <td style="text-align: right;">
                                    <button onclick="copyReferralLink('<%= r.code %>')" class="btn btn-outline" style="border-radius: 8px; font-weight: 600; font-size: 0.8rem; padding: 6px 12px; display: inline-flex; align-items: center; gap: 6px; cursor: pointer;">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                                        <span>Copy Link</span>
                                    </button>
                                </td>
                            </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
                <div id="noRefMatchMessage" style="display: none; text-align: center; padding: 2.5rem 1rem; color: var(--ntxt-color);">
                    <div style="font-size: 2rem; margin-bottom: 6px;">🔍</div>
                    <div style="font-weight: 700; color: var(--text-color);">No matching referral campaigns found</div>
                    <p style="margin: 4px 0 0 0; font-size: 0.85rem;">Try searching for a different code or description keyword.</p>
                </div>
            </div>
        </div>
    </main>

    <!-- Floating Copy Toast -->
    <div id="copyToast" class="copy-toast">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span id="toastMsg">Referral link copied to clipboard!</span>
    </div>

    <script>
        function filterReferrals() {
            const query = document.getElementById('refSearch').value.toLowerCase().trim();
            const rows = document.querySelectorAll('.ref-row');
            let visible = 0;

            rows.forEach(row => {
                const code = row.getAttribute('data-code') || '';
                const desc = row.getAttribute('data-desc') || '';
                const matches = !query || code.includes(query) || desc.includes(query);

                if (matches) {
                    row.style.display = '';
                    visible++;
                } else {
                    row.style.display = 'none';
                }
            });

            const countEl = document.getElementById('visibleRefCount');
            if (countEl) countEl.textContent = visible;

            const noMatch = document.getElementById('noRefMatchMessage');
            if (noMatch) {
                noMatch.style.display = (visible === 0 && rows.length > 0) ? 'block' : 'none';
            }
        }

        function generateRandomCode() {
            const prefixes = ['KELSEL', 'STUDY', 'PASS', 'VIP', 'EXAM', 'ACE'];
            const randPrefix = prefixes[Math.floor(Math.random() * prefixes.length)];
            const randNum = Math.floor(1000 + Math.random() * 9000);
            const input = document.getElementById('refCodeInput');
            if (input) input.value = `${randPrefix}${randNum}`;
        }

        function copyReferralLink(code) {
            const url = window.location.origin + '/register?ref=' + encodeURIComponent(code);
            navigator.clipboard.writeText(url).then(() => {
                showToast(`Copied referral link: /register?ref=${code}`);
            }).catch(() => {
                prompt('Copy your referral URL below:', url);
            });
        }

        function showToast(msg) {
            const toast = document.getElementById('copyToast');
            const toastMsg = document.getElementById('toastMsg');
            if (!toast) return;
            if (toastMsg && msg) toastMsg.textContent = msg;
            toast.classList.add('show');
            setTimeout(() => {
                toast.classList.remove('show');
            }, 2500);
        }
    </script>
</body>
</html>
