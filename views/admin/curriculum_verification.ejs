<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Curriculum Verification - Admin Dashboard</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.0/vanilla-tilt.min.js"></script>
    <style>
        .dashboard-body { position: relative; background: transparent; display: flex; min-height: 100vh; margin: 0; font-family: system-ui, -apple-system, sans-serif; }
        
        .ambient-bg {
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
            z-index: -1; overflow: hidden; pointer-events: none; background: var(--cbg-color);
        }
        .orb {
            position: absolute; border-radius: 50%; filter: blur(100px); opacity: 0.2; will-change: transform;
        }
        .orb-1 { width: 40vw; height: 40vw; background: rgba(33, 150, 243, 0.4); top: -10%; left: -10%; }
        .orb-2 { width: 35vw; height: 35vw; background: rgba(156, 39, 176, 0.3); bottom: -10%; right: -10%; }

        .sidebar { 
            width: 250px; background: rgba(10, 10, 15, 0.8); backdrop-filter: blur(20px); 
            padding: 30px 20px; border-right: 1px solid rgba(255,255,255,0.05); z-index: 10;
        }
        .sidebar h2 { color: var(--sec-color); font-size: 1.5rem; margin-top: 0; margin-bottom: 2rem; }
        .nav-link { 
            display: block; margin: 15px 0; padding: 10px 15px; color: var(--ntxt-color); 
            text-decoration: none; border-radius: 8px; transition: background 0.3s, color 0.3s;
        }
        .nav-link:hover { background: rgba(255,255,255,0.05); color: #fff; }
        .nav-link.active { background: rgba(33, 150, 243, 0.1); color: var(--cta-color); font-weight: 600; border-left: 3px solid var(--cta-color); }

        .main-content { flex: 1; padding: 30px; overflow-y: auto; max-width: 1400px; margin: 0 auto; z-index: 5; }
        
        .header-title { color: var(--sec-color); font-size: 2.2rem; margin-top: 0; margin-bottom: 2rem; }

        .summary-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.5rem; margin-bottom: 2.5rem; }
        .summary-card { 
            background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; padding: 1.5rem; text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1); opacity: 0; transform: translateY(20px);
        }
        .summary-val { font-size: 2.2rem; font-weight: bold; margin-top: 10px; }

        .glass-panel {
            background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 20px; padding: 1.5rem;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1); opacity: 0; transform: translateY(20px);
        }
        
        .controls { display: flex; gap: 15px; margin-bottom: 20px; align-items: center; }
        select { 
            padding: 10px 15px; border-radius: 12px; background: rgba(255,255,255,0.05); 
            color: var(--txt-color); border: 1px solid rgba(255,255,255,0.1); font-size: 1rem;
        }
        select option { background: var(--nav-bg); }

        table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
        th, td { padding: 15px; text-align: left; border-bottom: 1px solid rgba(255,255,255,0.05); }
        th { color: var(--ntxt-color); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
        td { color: var(--txt-color); }
        tr:hover { background: rgba(255,255,255,0.02); }
        
        .badge { padding: 6px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: 600; color: #fff; display: inline-block; margin-bottom: 4px; box-shadow: 0 2px 5px rgba(0,0,0,0.2); }
        .bg-green { background: linear-gradient(135deg, #4caf50, #2e7d32); }
        .bg-yellow { background: linear-gradient(135deg, #ffc107, #f57f17); color: #000; }
        .bg-orange { background: linear-gradient(135deg, #ff9800, #e65100); }
        .bg-red { background: linear-gradient(135deg, #f44336, #c62828); }
        
        .btn { padding: 6px 12px; border-radius: 8px; border: none; cursor: pointer; font-size: 0.8rem; font-weight: 600; margin: 3px; color: white; transition: transform 0.2s; }
        .btn:hover { transform: translateY(-2px); }
        .btn-green { background: linear-gradient(135deg, #4caf50, #2e7d32); }
        .btn-yellow { background: linear-gradient(135deg, #ffc107, #f57f17); color: #000; }
        .btn-red { background: linear-gradient(135deg, #f44336, #c62828); }
        .btn-blue { background: linear-gradient(135deg, var(--cta-color), #1976d2); text-decoration: none; display: inline-block; }
        .btn-gray { background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); }
        .btn-gray:hover { background: rgba(255,255,255,0.2); }
    </style>
</head>
<body class="dashboard-body">
    <div class="ambient-bg">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
    </div>

    <div class="sidebar">
        <h2>Admin Console</h2>
        <a href="/admin" class="nav-link">Dashboard</a>
        <a href="/admin/curriculum-verification" class="nav-link active">Curriculum Verification</a>
        <a href="/admin/questions" class="nav-link">Exam Questions</a>
        <a href="/dashboard" class="nav-link" style="margin-top: 50px; border: 1px solid rgba(255,255,255,0.1);">Exit to App</a>
    </div>

    <div class="main-content">
        <h1 class="header-title">Curriculum Verification Dashboard</h1>
        
        <div class="summary-grid" id="summaryGrid">
            <div class="summary-card">
                <div style="color: var(--ntxt-color); font-weight: 600; text-transform: uppercase; font-size: 0.85rem;">Programmes</div>
                <div class="summary-val" id="sum-prog" style="color: var(--txt-color);">0</div>
            </div>
            <div class="summary-card">
                <div style="color: var(--ntxt-color); font-weight: 600; text-transform: uppercase; font-size: 0.85rem;">Total Courses</div>
                <div class="summary-val" id="sum-course" style="color: var(--txt-color);">0</div>
            </div>
            <div class="summary-card" style="border-bottom: 3px solid #4caf50;">
                <div style="color: var(--ntxt-color); font-weight: 600; text-transform: uppercase; font-size: 0.85rem;">Verified</div>
                <div class="summary-val" id="sum-verified" style="color: #4caf50;">0</div>
            </div>
            <div class="summary-card" style="border-bottom: 3px solid #ffc107;">
                <div style="color: var(--ntxt-color); font-weight: 600; text-transform: uppercase; font-size: 0.85rem;">Historical</div>
                <div class="summary-val" id="sum-hist" style="color: #ffc107;">0</div>
            </div>
            <div class="summary-card" style="border-bottom: 3px solid #ff9800;">
                <div style="color: var(--ntxt-color); font-weight: 600; text-transform: uppercase; font-size: 0.85rem;">Pending</div>
                <div class="summary-val" id="sum-pend" style="color: #ff9800;">0</div>
            </div>
            <div class="summary-card" style="border-bottom: 3px solid #f44336;">
                <div style="color: var(--ntxt-color); font-weight: 600; text-transform: uppercase; font-size: 0.85rem;">Conflicts</div>
                <div class="summary-val" id="sum-conf" style="color: #f44336;">0</div>
            </div>
        </div>

        <div class="glass-panel" id="table-container">
            <div class="controls">
                <select id="statusFilter" onchange="filterTable()">
                    <option value="all">View All Statuses</option>
                    <option value="current_official_verified">Current Verified (2026)</option>
                    <option value="official_historical">Official Historical</option>
                    <option value="pending_verification">Pending Verification</option>
                    <option value="conflicting_official_sources">Conflicting Sources</option>
                    <option value="department_confirmation_required">Department Confirmation Required</option>
                </select>
                <input type="text" id="searchFilter" onkeyup="filterTable()" placeholder="Search course code or programme..." style="padding: 10px 15px; border-radius: 12px; background: rgba(255,255,255,0.05); color: var(--txt-color); border: 1px solid rgba(255,255,255,0.1); font-size: 1rem; width: 300px;">
            </div>

            <div style="overflow-x: auto;">
                <table id="curriculumTable">
                    <thead>
                        <tr>
                            <th>Programme & Faculty</th>
                            <th>Level & Sem.</th>
                            <th>Course Code & Title</th>
                            <th>Status & Units</th>
                            <th>Source & Verification</th>
                            <th style="min-width: 280px;">Admin Actions</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <tr><td colspan="6" style="text-align: center; padding: 3rem; color: var(--ntxt-color);">Loading curriculum data...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        let allData = [];

        document.addEventListener('DOMContentLoaded', async () => {
            gsap.to(".summary-card", { opacity: 1, y: 0, duration: 0.5, stagger: 0.1, ease: "back.out(1.2)" });
            gsap.to("#table-container", { opacity: 1, y: 0, duration: 0.6, delay: 0.3, ease: "power2.out" });
            gsap.to(".orb-1", { x: "10vw", y: "5vh", rotation: 45, duration: 20, repeat: -1, yoyo: true, ease: "sine.inOut" });
            gsap.to(".orb-2", { x: "-10vw", y: "-10vh", rotation: -45, duration: 25, repeat: -1, yoyo: true, ease: "sine.inOut" });
            VanillaTilt.init(document.querySelectorAll(".summary-card"), { max: 5, speed: 400, glare: true, "max-glare": 0.1 });

            try {
                const res = await fetch('/api/curriculum/admin/verification-list');
                const result = await res.json();
                if(result.success) {
                    allData = result.data;
                    updateSummary();
                    renderTable(allData);
                }
            } catch(e) {
                document.getElementById('tableBody').innerHTML = '<tr><td colspan="6" style="text-align: center; color: var(--error);">Error loading data.</td></tr>';
            }
        });

        function updateSummary() {
            document.getElementById('sum-prog').innerText = new Set(allData.map(d => d.programme)).size;
            document.getElementById('sum-course').innerText = allData.length;
            document.getElementById('sum-verified').innerText = allData.filter(d => d.verification_status === 'current_official_verified').length;
            document.getElementById('sum-hist').innerText = allData.filter(d => d.verification_status === 'official_historical').length;
            document.getElementById('sum-pend').innerText = allData.filter(d => d.verification_status === 'pending_verification').length;
            document.getElementById('sum-conf').innerText = allData.filter(d => d.verification_status === 'conflicting_official_sources').length;
        }

        function getStatusBadge(status) {
            if(status === 'current_official_verified') return `<span class="badge bg-green">Verified Current</span>`;
            if(status === 'official_historical') return `<span class="badge bg-yellow">Historical</span>`;
            if(status === 'conflicting_official_sources') return `<span class="badge bg-red">Conflict Alert</span>`;
            if(status === 'department_confirmation_required') return `<span class="badge bg-orange">Dept Confirm Req</span>`;
            return `<span class="badge bg-orange">Pending</span>`;
        }

        function renderTable(data) {
            const tbody = document.getElementById('tableBody');
            tbody.innerHTML = '';
            
            if(data.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; color: var(--ntxt-color); padding: 3rem;">No curriculum mappings found matching criteria.</td></tr>';
                return;
            }

            data.forEach(row => {
                let tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><strong style="color: var(--sec-color);">${row.programme}</strong><br><small style="color:var(--ntxt-color)">${row.faculty}</small></td>
                    <td><strong style="color: var(--cta-color);">${row.level} Level</strong><br><small>${row.semester}</small></td>
                    <td><strong style="font-size: 1.1rem;">${row.course_code}</strong><br><small style="color:var(--ntxt-color)">${row.course_title || 'N/A'}</small></td>
                    <td><strong style="color: var(--txt-color);">${row.credit_units || '?'} Units</strong><br><small>${row.course_status || 'Core'}</small></td>
                    <td>
                        ${getStatusBadge(row.verification_status)}<br>
                        <small style="color:var(--ntxt-color)">${row.source_type || 'No source'} (${row.source_year || ''})</small>
                    </td>
                    <td>
                        <button class="btn btn-green" onclick="updateStatus('${row.course_code}', ${row.programme_id}, 'current_official_verified')">Verify</button>
                        <button class="btn btn-yellow" onclick="updateStatus('${row.course_code}', ${row.programme_id}, 'official_historical')">Historical</button>
                        <button class="btn btn-red" onclick="updateStatus('${row.course_code}', ${row.programme_id}, 'conflicting_official_sources')">Flag</button>
                        <button class="btn btn-gray" onclick="addNote('${row.course_code}', ${row.programme_id})">Note</button>
                        ${row.source_url ? `<a href="${row.source_url}" target="_blank" class="btn btn-blue">Source</a>` : ''}
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function filterTable() {
            const statusF = document.getElementById('statusFilter').value;
            const searchF = document.getElementById('searchFilter').value.toLowerCase();
            
            let filtered = allData;
            
            if(statusF !== 'all') {
                filtered = filtered.filter(d => d.verification_status === statusF);
            }
            if(searchF) {
                filtered = filtered.filter(d => 
                    d.course_code.toLowerCase().includes(searchF) || 
                    d.programme.toLowerCase().includes(searchF) ||
                    (d.course_title && d.course_title.toLowerCase().includes(searchF))
                );
            }
            
            renderTable(filtered);
        }

        async function updateStatus(course_code, programme_id, new_status) {
            let note = prompt("Optional: Enter a reason for this status change (stored securely in Audit Log):");
            if (note === null) return; // Cancelled
            
            try {
                const res = await fetch('/api/curriculum/admin/update-status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ course_code, programme_id, new_status, notes: note })
                });
                const result = await res.json();
                if(result.success) {
                    const item = allData.find(d => d.course_code === course_code && d.programme_id === programme_id);
                    if(item) item.verification_status = new_status;
                    updateSummary();
                    filterTable();
                } else {
                    alert("Error: " + result.error);
                }
            } catch(e) {
                alert("Network error.");
            }
        }

        function addNote(course_code, programme_id) {
            let note = prompt("Enter verification note/context:");
            if (note) {
                alert("Audit Note attached successfully (simulated via UI).");
            }
        }
    </script>
</body>
</html>
