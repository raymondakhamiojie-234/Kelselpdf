<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Curriculum Verification - Admin</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <style>
        body { display: flex; min-height: 100vh; background: var(--bg-color); color: var(--txt-color); margin:0; font-family: system-ui, -apple-system, sans-serif;}
        .sidebar { width: 250px; background: var(--nav-bg); padding: 20px; border-right: 1px solid var(--border-color); }
        .main-content { flex: 1; padding: 20px; overflow-y: auto; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; font-size: 0.9rem; }
        th, td { padding: 12px; text-align: left; border-bottom: 1px solid var(--border-color); }
        th { background: var(--nav-bg); color: var(--sec-color); }
        .badge { padding: 4px 8px; border-radius: 4px; font-size: 0.75rem; color: #fff; font-weight: bold;}
        .bg-green { background: #27c93f; }
        .bg-yellow { background: #ffb822; color: #000; }
        .bg-orange { background: #fd7e14; }
        .bg-red { background: #ff5e5e; }
        .btn { padding: 6px 12px; border-radius: 4px; border: none; cursor: pointer; font-size: 0.8rem; margin-right: 5px; color: white;}
        .btn-approve { background: #27c93f; }
        .btn-flag { background: #ff5e5e; }
        .btn-source { background: #007bff; text-decoration: none; display: inline-block;}
    </style>
</head>
<body>
    <div class="sidebar">
        <h2>Admin Panel</h2>
        <a href="/admin" style="display:block; margin: 10px 0; color: var(--cta-color); text-decoration: none;">Dashboard</a>
        <a href="/admin/curriculum-verification" style="display:block; margin: 10px 0; color: var(--cta-color); text-decoration: none; font-weight: bold;">Curriculum Verification</a>
        <a href="/admin/questions" style="display:block; margin: 10px 0; color: var(--cta-color); text-decoration: none;">Questions</a>
    </div>

    <div class="main-content">
        <h1>Curriculum Verification Console</h1>
        <p>Review and verify AAU curriculum sources.</p>

        <div style="margin: 20px 0;">
            <select id="statusFilter" onchange="filterTable()" style="padding: 8px; border-radius: 4px; background: var(--nav-bg); color: var(--txt-color); border: 1px solid var(--border-color);">
                <option value="all">All Statuses</option>
                <option value="current_official_verified">Current Verified</option>
                <option value="official_historical">Historical</option>
                <option value="pending_verification">Pending Verification</option>
                <option value="conflicting_official_sources">Conflicting</option>
                <option value="department_confirmation_required">Department Confirmation Required</option>
            </select>
        </div>

        <table id="curriculumTable">
            <thead>
                <tr>
                    <th>Programme</th>
                    <th>Level</th>
                    <th>Course Code</th>
                    <th>Title</th>
                    <th>Source Type</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                <tr><td colspan="7">Loading...</td></tr>
            </tbody>
        </table>
    </div>

    <script>
        let allData = [];

        document.addEventListener('DOMContentLoaded', async () => {
            try {
                const res = await fetch('/api/curriculum/admin/verification-list');
                const result = await res.json();
                if(result.success) {
                    allData = result.data;
                    renderTable(allData);
                }
            } catch(e) {
                document.getElementById('tableBody').innerHTML = '<tr><td colspan="7">Error loading data.</td></tr>';
            }
        });

        function getStatusBadge(status) {
            if(status === 'current_official_verified') return `<span class="badge bg-green">Verified</span>`;
            if(status === 'official_historical') return `<span class="badge bg-yellow">Historical</span>`;
            if(status === 'conflicting_official_sources') return `<span class="badge bg-red">Conflict</span>`;
            if(status === 'department_confirmation_required') return `<span class="badge bg-orange">Dept Confirm Req</span>`;
            return `<span class="badge bg-orange">Pending</span>`;
        }

        function renderTable(data) {
            const tbody = document.getElementById('tableBody');
            tbody.innerHTML = '';
            
            if(data.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7">No curriculum mappings found. Database is structurally ready.</td></tr>';
                return;
            }

            data.forEach(row => {
                let tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${row.programme} <br><small style="color:var(--ntxt-color)">${row.faculty}</small></td>
                    <td>${row.level}L<br><small>${row.semester}</small></td>
                    <td><strong>${row.course_code}</strong></td>
                    <td>${row.course_title || 'N/A'}<br><small>${row.credit_units ? row.credit_units + ' Units' : ''}</small></td>
                    <td>${row.source_type || 'Unknown'}<br><small>${row.source_year || ''}</small></td>
                    <td>${getStatusBadge(row.verification_status)}</td>
                    <td>
                        <button class="btn btn-approve" onclick="updateStatus('${row.course_code}', 'current_official_verified')">Approve</button>
                        <button class="btn btn-flag" onclick="updateStatus('${row.course_code}', 'conflicting_official_sources')">Flag</button>
                        ${row.source_url ? `<a href="${row.source_url}" target="_blank" class="btn btn-source">Source</a>` : ''}
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function filterTable() {
            const filter = document.getElementById('statusFilter').value;
            if(filter === 'all') {
                renderTable(allData);
            } else {
                renderTable(allData.filter(d => d.verification_status === filter));
            }
        }

        function updateStatus(course_code, new_status) {
            alert(`API Hook: Updating ${course_code} to ${new_status}`);
            // In a real implementation, this would POST to /admin/api/curriculum/update-status
        }
    </script>
</body>
</html>
