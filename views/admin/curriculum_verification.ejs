<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta charset="UTF-8">
    <title>Curriculum Verification - Executive Admin</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <link rel="manifest" href="/manifest.json">
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').catch(err => console.log('SW setup failed: ', err));
            });
        }
    </script>
    <link rel="icon" media="(prefers-color-scheme: light)" href="/acct/img/favicon-dark.png">
    <link rel="icon" media="(prefers-color-scheme: dark)" href="/acct/img/favicon-light.png">
    <style>
        .kpi-grid-6 {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 16px;
            margin-bottom: 2rem;
        }
        @media (max-width: 1200px) {
            .kpi-grid-6 {
                grid-template-columns: repeat(3, 1fr);
            }
        }
        @media (max-width: 768px) {
            .kpi-grid-6 {
                grid-template-columns: repeat(2, 1fr);
            }
        }
        @media (max-width: 480px) {
            .kpi-grid-6 {
                grid-template-columns: 1fr;
            }
        }
        .action-btn-group {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }
        .act-btn {
            padding: 5px 9px;
            border-radius: 6px;
            font-size: 0.74rem;
            font-weight: 600;
            cursor: pointer;
            border: 1px solid transparent;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            transition: all 0.2s ease;
            text-decoration: none;
            line-height: 1.2;
        }
        .act-btn:hover {
            transform: translateY(-1px);
        }
        .act-btn-verify {
            background: rgba(16, 185, 129, 0.12);
            color: #10b981;
            border-color: rgba(16, 185, 129, 0.3);
        }
        .act-btn-verify:hover {
            background: #10b981;
            color: #fff;
        }
        .act-btn-hist {
            background: rgba(245, 158, 11, 0.12);
            color: #f59e0b;
            border-color: rgba(245, 158, 11, 0.3);
        }
        .act-btn-hist:hover {
            background: #f59e0b;
            color: #fff;
        }
        .act-btn-flag {
            background: rgba(239, 68, 68, 0.12);
            color: #ef4444;
            border-color: rgba(239, 68, 68, 0.3);
        }
        .act-btn-flag:hover {
            background: #ef4444;
            color: #fff;
        }
        .act-btn-note {
            background: var(--bg-color);
            color: var(--text-color);
            border-color: var(--border-color);
        }
        .act-btn-note:hover {
            border-color: var(--primary-color);
            color: var(--primary-color);
        }
        .act-btn-source {
            background: rgba(59, 130, 246, 0.12);
            color: #3b82f6;
            border-color: rgba(59, 130, 246, 0.3);
        }
        .act-btn-source:hover {
            background: #3b82f6;
            color: #fff;
        }
        /* Toast notification */
        .toast-pill {
            position: fixed;
            bottom: 24px;
            right: 24px;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
            padding: 12px 20px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            gap: 10px;
            z-index: 2000;
            transform: translateY(100px);
            opacity: 0;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            font-size: 0.88rem;
            font-weight: 600;
        }
        .toast-pill.show {
            transform: translateY(0);
            opacity: 1;
        }
    </style>
</head>
<body class="dashboard-body admin-body">
    <%- include('./partials/admin_sidebar', { active_page: 'curriculum_verification' }) %>

    <main class="admin-main-content">
        <!-- Executive Topbar -->
        <header class="admin-topbar">
            <div style="display: flex; align-items: center; gap: 14px;">
                <button class="admin-mobile-toggle" onclick="toggleAdminNav()" aria-label="Toggle Navigation">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                </button>
                <div>
                    <h1 class="admin-title">Curriculum Verification & Audit</h1>
                    <p class="admin-subtitle">Verify official university programmes, syllabus versions, credit units, and audit conflict alerts.</p>
                </div>
            </div>
            <div class="admin-topbar-actions">
                <button onclick="loadCurriculumData()" class="btn btn-outline" id="refreshBtn" style="border-radius: 8px; font-weight: 600; font-size: 0.85rem; padding: 8px 14px; display: inline-flex; align-items: center; gap: 6px; cursor: pointer;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" id="refreshIcon"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
                    <span>Refresh Data</span>
                </button>
                <a href="/admin" class="btn btn-outline" style="border-radius: 8px; font-weight: 600; font-size: 0.85rem; padding: 8px 14px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                    &larr; Overview
                </a>
            </div>
        </header>

        <!-- KPI Metrics Grid (6 Metrics) -->
        <div class="kpi-grid-6">
            <div class="kpi-card" style="padding: 18px;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title" style="font-size: 0.76rem;">Programmes</div>
                        <div class="kpi-value" id="sum-prog" style="font-size: 1.6rem;">0</div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(59, 130, 246, 0.12); color: #3b82f6; width: 34px; height: 34px;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                    </div>
                </div>
                <div class="kpi-trend" style="font-size: 0.75rem; margin-top: 6px;">
                    <span style="color: #3b82f6; font-weight: 600;">Faculties</span>
                </div>
            </div>

            <div class="kpi-card" style="padding: 18px;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title" style="font-size: 0.76rem;">Total Courses</div>
                        <div class="kpi-value" id="sum-course" style="font-size: 1.6rem;">0</div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(139, 92, 246, 0.12); color: #8b5cf6; width: 34px; height: 34px;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                    </div>
                </div>
                <div class="kpi-trend" style="font-size: 0.75rem; margin-top: 6px;">
                    <span style="color: #8b5cf6; font-weight: 600;">Indexed Matrix</span>
                </div>
            </div>

            <div class="kpi-card" style="padding: 18px; border-bottom: 3px solid #10b981;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title" style="font-size: 0.76rem;">Verified Current</div>
                        <div class="kpi-value" id="sum-verified" style="font-size: 1.6rem; color: #10b981;">0</div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(16, 185, 129, 0.12); color: #10b981; width: 34px; height: 34px;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </div>
                </div>
                <div class="kpi-trend" style="font-size: 0.75rem; margin-top: 6px;">
                    <span style="color: #10b981; font-weight: 600;">2026 Canonical</span>
                </div>
            </div>

            <div class="kpi-card" style="padding: 18px; border-bottom: 3px solid #f59e0b;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title" style="font-size: 0.76rem;">Historical</div>
                        <div class="kpi-value" id="sum-hist" style="font-size: 1.6rem; color: #f59e0b;">0</div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(245, 158, 11, 0.12); color: #f59e0b; width: 34px; height: 34px;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
                    </div>
                </div>
                <div class="kpi-trend" style="font-size: 0.75rem; margin-top: 6px;">
                    <span style="color: #f59e0b; font-weight: 600;">Previous Curricula</span>
                </div>
            </div>

            <div class="kpi-card" style="padding: 18px; border-bottom: 3px solid #ff9800;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title" style="font-size: 0.76rem;">Pending Audit</div>
                        <div class="kpi-value" id="sum-pend" style="font-size: 1.6rem; color: #ff9800;">0</div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(255, 152, 0, 0.12); color: #ff9800; width: 34px; height: 34px;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    </div>
                </div>
                <div class="kpi-trend" style="font-size: 0.75rem; margin-top: 6px;">
                    <span style="color: #ff9800; font-weight: 600;">Awaiting Review</span>
                </div>
            </div>

            <div class="kpi-card" style="padding: 18px; border-bottom: 3px solid #ef4444;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title" style="font-size: 0.76rem;">Conflict Alerts</div>
                        <div class="kpi-value" id="sum-conf" style="font-size: 1.6rem; color: #ef4444;">0</div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(239, 68, 68, 0.12); color: #ef4444; width: 34px; height: 34px;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"></polygon><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    </div>
                </div>
                <div class="kpi-trend" style="font-size: 0.75rem; margin-top: 6px;">
                    <span style="color: #ef4444; font-weight: 600;">Discrepancies</span>
                </div>
            </div>
        </div>

        <!-- Main Curriculum Verification Workspace -->
        <div class="admin-panel">
            <!-- Filter Toolbar -->
            <div class="admin-filter-bar">
                <div class="admin-search-box">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="text" id="searchFilter" onkeyup="filterTable()" placeholder="Search course code, title, programme or faculty...">
                </div>

                <div class="admin-filter-group">
                    <select id="statusFilter" class="admin-select" onchange="filterTable()">
                        <option value="all">All Statuses</option>
                        <option value="current_official_verified">Verified Current (2026)</option>
                        <option value="official_historical">Official Historical</option>
                        <option value="pending_verification">Pending Verification</option>
                        <option value="conflicting_official_sources">Conflicting Sources</option>
                        <option value="department_confirmation_required">Department Confirmation Required</option>
                    </select>

                    <span style="font-size: 0.85rem; color: var(--ntxt-color); padding-left: 6px;">
                        Showing <strong id="visibleCount" style="color: var(--text-color);">0</strong> of <span id="totalCount">0</span>
                    </span>
                </div>
            </div>

            <!-- Responsive Curriculum Table -->
            <div class="table-responsive">
                <table class="data-table" id="curriculumTable">
                    <thead>
                        <tr>
                            <th>Programme & Faculty</th>
                            <th>Level & Sem.</th>
                            <th>Course Code & Title</th>
                            <th>Units & Cat.</th>
                            <th>Status & Source</th>
                            <th style="text-align: right; min-width: 260px;">Administrative Actions</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <tr>
                            <td colspan="6" style="text-align: center; padding: 4rem 1rem; color: var(--ntxt-color);">
                                <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px;">
                                    <div class="spinner" style="width: 32px; height: 32px; border: 3px solid var(--border-color); border-top-color: var(--primary-color); border-radius: 50%; animation: spin 0.8s linear infinite;"></div>
                                    <span style="font-size: 0.9rem;">Fetching canonical curriculum registry...</span>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <!-- Toast Notification Element -->
    <div class="toast-pill" id="actionToast">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        <span id="toastMessage">Status updated successfully</span>
    </div>

    <script>
        let allData = [];

        document.addEventListener('DOMContentLoaded', () => {
            loadCurriculumData();
        });

        async function loadCurriculumData() {
            const refreshIcon = document.getElementById('refreshIcon');
            if (refreshIcon) refreshIcon.style.animation = 'spin 0.8s linear infinite';
            
            try {
                const res = await fetch('/api/curriculum/admin/verification-list');
                const result = await res.json();
                if (result.success) {
                    allData = result.data || [];
                    updateSummary();
                    filterTable();
                } else {
                    document.getElementById('tableBody').innerHTML = `
                        <tr><td colspan="6" style="text-align: center; color: var(--error); padding: 3rem;">
                            Failed to load curriculum records: ${result.error || 'Server error'}
                        </td></tr>
                    `;
                }
            } catch(e) {
                console.error(e);
                document.getElementById('tableBody').innerHTML = `
                    <tr><td colspan="6" style="text-align: center; color: var(--error); padding: 3rem;">
                        Network error while contacting curriculum verification API.
                    </td></tr>
                `;
            } finally {
                if (refreshIcon) refreshIcon.style.animation = 'none';
            }
        }

        function updateSummary() {
            const progCount = new Set(allData.map(d => d.programme)).size;
            document.getElementById('sum-prog').innerText = progCount;
            document.getElementById('sum-course').innerText = allData.length;
            document.getElementById('sum-verified').innerText = allData.filter(d => d.verification_status === 'current_official_verified').length;
            document.getElementById('sum-hist').innerText = allData.filter(d => d.verification_status === 'official_historical').length;
            document.getElementById('sum-pend').innerText = allData.filter(d => d.verification_status === 'pending_verification').length;
            document.getElementById('sum-conf').innerText = allData.filter(d => d.verification_status === 'conflicting_official_sources').length;
            document.getElementById('totalCount').innerText = allData.length;
        }

        function getStatusBadge(status) {
            switch(status) {
                case 'current_official_verified':
                    return `<span class="badge-pill success">Verified Current</span>`;
                case 'official_historical':
                    return `<span class="badge-pill warning">Official Historical</span>`;
                case 'conflicting_official_sources':
                    return `<span class="badge-pill danger">Conflict Alert</span>`;
                case 'department_confirmation_required':
                    return `<span class="badge-pill purple">Dept Confirm Req</span>`;
                default:
                    return `<span class="badge-pill gray">Pending Review</span>`;
            }
        }

        function renderTable(data) {
            const tbody = document.getElementById('tableBody');
            tbody.innerHTML = '';
            document.getElementById('visibleCount').innerText = data.length;

            if (data.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" style="text-align: center; color: var(--ntxt-color); padding: 3.5rem 1rem;">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 10px; opacity: 0.5;">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                            <p style="font-weight: 600; margin: 0; color: var(--text-color);">No curriculum records found</p>
                            <p style="font-size: 0.82rem; margin: 4px 0 0 0;">Try adjusting your search criteria or status filter.</p>
                        </td>
                    </tr>
                `;
                return;
            }

            data.forEach(row => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>
                        <div style="font-weight: 600; color: var(--text-color);">${escapeHtml(row.programme || 'Unassigned')}</div>
                        <small style="color: var(--ntxt-color); font-size: 0.78rem;">${escapeHtml(row.faculty || 'General Faculty')}</small>
                    </td>
                    <td>
                        <span class="badge-pill info" style="font-size: 0.74rem;">${row.level ? row.level + 'L' : '100L'}</span>
                        <div style="font-size: 0.78rem; color: var(--ntxt-color); margin-top: 3px;">${escapeHtml(row.semester || '1st Sem')}</div>
                    </td>
                    <td>
                        <div style="font-weight: 700; font-family: monospace; font-size: 0.95rem; color: var(--cta-color);">${escapeHtml(row.course_code)}</div>
                        <small style="color: var(--ntxt-color); font-size: 0.8rem; display: block; max-width: 240px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${escapeHtml(row.course_title || 'Untitled Syllabus')}</small>
                    </td>
                    <td>
                        <div style="font-weight: 600; color: var(--text-color);">${row.credit_units || 0} Units</div>
                        <small style="color: var(--ntxt-color); font-size: 0.76rem;">${escapeHtml(row.course_status || 'Core')}</small>
                    </td>
                    <td>
                        <div>${getStatusBadge(row.verification_status)}</div>
                        <small style="color: var(--ntxt-color); font-size: 0.75rem; margin-top: 3px; display: block;">
                            ${escapeHtml(row.source_type || 'Unspecified')} ${row.source_year ? `(${escapeHtml(row.source_year)})` : ''}
                        </small>
                    </td>
                    <td style="text-align: right;">
                        <div class="action-btn-group" style="justify-content: flex-end;">
                            <button class="act-btn act-btn-verify" onclick="updateStatus('${escapeAttr(row.course_code)}', '${escapeAttr(row.programme_id)}', 'current_official_verified')" title="Mark Verified">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Verify</span>
                            </button>
                            <button class="act-btn act-btn-hist" onclick="updateStatus('${escapeAttr(row.course_code)}', '${escapeAttr(row.programme_id)}', 'official_historical')" title="Mark Historical">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
                                <span>Historical</span>
                            </button>
                            <button class="act-btn act-btn-flag" onclick="updateStatus('${escapeAttr(row.course_code)}', '${escapeAttr(row.programme_id)}', 'conflicting_official_sources')" title="Flag Conflict">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                                <span>Flag</span>
                            </button>
                            <button class="act-btn act-btn-note" onclick="addNote('${escapeAttr(row.course_code)}', '${escapeAttr(row.programme_id)}')" title="Attach Audit Note">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                                <span>Note</span>
                            </button>
                            ${row.source_url ? `
                                <a href="${escapeAttr(row.source_url)}" target="_blank" rel="noopener noreferrer" class="act-btn act-btn-source" title="View Source Link">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                                    <span>Source</span>
                                </a>
                            ` : ''}
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function filterTable() {
            const statusFilter = document.getElementById('statusFilter').value;
            const searchFilter = document.getElementById('searchFilter').value.toLowerCase().trim();

            let filtered = allData;

            if (statusFilter !== 'all') {
                filtered = filtered.filter(d => d.verification_status === statusFilter);
            }

            if (searchFilter) {
                filtered = filtered.filter(d =>
                    (d.course_code && d.course_code.toLowerCase().includes(searchFilter)) ||
                    (d.programme && d.programme.toLowerCase().includes(searchFilter)) ||
                    (d.faculty && d.faculty.toLowerCase().includes(searchFilter)) ||
                    (d.course_title && d.course_title.toLowerCase().includes(searchFilter))
                );
            }

            renderTable(filtered);
        }

        async function updateStatus(course_code, programme_id, new_status) {
            const note = prompt(`Enter an audit reason / note for setting "${course_code}" to "${new_status}":`);
            if (note === null) return; // Cancelled

            try {
                const res = await fetch('/api/curriculum/admin/update-status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ course_code, programme_id, new_status, notes: note })
                });
                const result = await res.json();
                if (result.success) {
                    const item = allData.find(d => d.course_code === course_code && d.programme_id === programme_id);
                    if (item) item.verification_status = new_status;
                    updateSummary();
                    filterTable();
                    showToast(`Updated "${course_code}" status to ${new_status.replace(/_/g, ' ')}`);
                } else {
                    alert("Update failed: " + (result.error || "Server rejection"));
                }
            } catch(e) {
                alert("Network communication error.");
            }
        }

        async function addNote(course_code, programme_id) {
            const note = prompt(`Enter verification or faculty note for "${course_code}":`);
            if (note && note.trim().length > 0) {
                try {
                    const res = await fetch('/api/curriculum/admin/update-status', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ course_code, programme_id, notes: note.trim() })
                    });
                    const result = await res.json();
                    if (result.success) {
                        showToast(`Audit note saved for ${course_code}`);
                    } else {
                        alert("Failed to save note: " + (result.error || "Server rejection"));
                    }
                } catch(e) {
                    alert("Network communication error.");
                }
            }
        }

        function showToast(msg) {
            const toast = document.getElementById('actionToast');
            const toastMessage = document.getElementById('toastMessage');
            toastMessage.innerText = msg;
            toast.classList.add('show');
            setTimeout(() => {
                toast.classList.remove('show');
            }, 3500);
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function escapeAttr(str) {
            if (!str) return '';
            return String(str).replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }
    </script>
</body>
</html>
