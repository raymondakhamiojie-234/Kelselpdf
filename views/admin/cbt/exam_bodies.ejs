<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CBT Admin - Exam Bodies</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <style>
        .cbt-container { display: flex; height: 100vh; background: var(--bg-color); }
        .cbt-sidebar { width: 250px; background: var(--card-bg); border-right: 1px solid var(--border-color); padding: 2rem 1rem; }
        .cbt-sidebar a { display: block; padding: 10px 15px; color: var(--text-color); text-decoration: none; border-radius: 8px; margin-bottom: 5px; }
        .cbt-sidebar a:hover, .cbt-sidebar a.active { background: var(--primary-color); color: white; }
        .cbt-content { flex: 1; padding: 2rem; overflow-y: auto; }
        .data-table { width: 100%; border-collapse: collapse; margin-top: 1rem; background: var(--card-bg); border-radius: 8px; overflow: hidden; }
        .data-table th, .data-table td { padding: 15px; text-align: left; border-bottom: 1px solid var(--border-color); }
        .data-table th { background: rgba(0,0,0,0.05); }
        .form-group { margin-bottom: 15px; }
        .form-control { width: 100%; padding: 10px; border-radius: 6px; border: 1px solid var(--border-color); background: var(--bg-color); color: var(--text-color); }
        .glass-panel { background: var(--card-bg); padding: 1.5rem; border-radius: 12px; border: 1px solid var(--border-color); margin-bottom: 2rem; }
    </style>
</head>
<body class="dark-mode">
    <div class="cbt-container">
        <div class="cbt-sidebar">
            <h3 style="margin-bottom: 2rem; padding-left: 15px; color: var(--primary-color);">CBT Engine Admin</h3>
            <a href="/admin/cbt/exam_bodies" class="active">Exam Bodies</a>
            <a href="/admin/cbt/exams">Exams</a>
            <a href="/admin/cbt/subjects">Subjects</a>
            <a href="/admin/cbt/topics">Topics</a>
            <a href="/admin/cbt/questions">Question Bank</a>
            <hr style="border-color: var(--border-color); margin: 2rem 0;">
            <a href="/admin">Back to Main Admin</a>
        </div>
        
        <div class="cbt-content">
            <h2 style="margin-bottom: 1rem;">Examination Bodies</h2>
            <p style="color: var(--ntxt-color); margin-bottom: 2rem;">Manage top-level examination boards (e.g. JAMB, WAEC).</p>
            
            <div class="glass-panel">
                <h3>Add New Exam Body</h3>
                <form method="POST" action="/admin/cbt/exam_bodies" style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 1rem;">
                    <div class="form-group">
                        <label>Name (e.g., Joint Admissions and Matriculation Board)</label>
                        <input type="text" name="name" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Code (e.g., JAMB)</label>
                        <input type="text" name="code" class="form-control" required>
                    </div>
                    <div class="form-group" style="grid-column: 1 / -1;">
                        <label>Description</label>
                        <textarea name="description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="form-group">
                        <label>Website URL (Optional)</label>
                        <input type="url" name="website" class="form-control">
                    </div>
                    <div class="form-group" style="display: flex; align-items: flex-end;">
                        <button type="submit" class="btn btn-primary" style="width: 100%;">Create Exam Body</button>
                    </div>
                </form>
            </div>

            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (bodies && bodies.length > 0) { %>
                        <% bodies.forEach(body => { %>
                            <tr>
                                <td><%= body.id %></td>
                                <td><strong><%= body.code %></strong></td>
                                <td><%= body.name %></td>
                                <td><%= body.status %></td>
                                <td>
                                    <a href="/admin/cbt/exams?body_id=<%= body.id %>" class="btn btn-sm btn-outline">View Exams</a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" style="text-align: center;">No exam bodies found.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
