<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CBT Admin - exam_bodies</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
</head>
<body class="dashboard-body">
    <%- include('./partials/sidebar', { active_page: 'cbt_exam_bodies' }) %>
    <main class="main-content">
            <h2 style="margin-bottom: 1rem;">Examination Bodies</h2>
            <p style="color: var(--ntxt-color); margin-bottom: 2rem;">Manage top-level examination boards (e.g. JAMB, WAEC).</p>
            
            <div class="glass-panel">
                <h3>Add New Exam Body</h3>
                <form method="POST" action="/admin/cbt/exam_bodies" style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 1rem;">
                    <div class="form-group">
                        <label>Name (e.g., Joint Admissions and Matriculation Board)</label>
                        <input type="text" name="name" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Code (e.g., JAMB)</label>
                        <input type="text" name="code" class="form-control" required>
                    </div>
                    <div class="form-group" style="grid-column: 1 / -1;">
                        <label>Description</label>
                        <textarea name="description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="form-group">
                        <label>Website URL (Optional)</label>
                        <input type="url" name="website" class="form-control">
                    </div>
                    <div class="form-group" style="display: flex; align-items: flex-end;">
                        <button type="submit" class="btn btn-primary" style="width: 100%;">Create Exam Body</button>
                    </div>
                </form>
            </div>

            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (bodies && bodies.length > 0) { %>
                        <% bodies.forEach(body => { %>
                            <tr>
                                <td><%= body.id %></td>
                                <td><strong><%= body.code %></strong></td>
                                <td><%= body.name %></td>
                                <td><span class="badge badge-success"><%= body.status %></span></td>
                                <td>
                                    <a href="/admin/cbt/exams?body_id=<%= body.id %>" class="btn btn-sm btn-outline">View Exams</a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" style="text-align: center;">No exam bodies found.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
            </main>
</body>
</html>
