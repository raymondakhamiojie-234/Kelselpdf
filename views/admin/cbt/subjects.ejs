<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CBT Admin - subjects</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
</head>
<body class="dashboard-body">
    <%- include('./partials/sidebar', { active_page: 'cbt_subjects' }) %>
    <main class="main-content">
            <h2 style="margin-bottom: 1rem;">Subjects</h2>
            <p style="color: var(--ntxt-color); margin-bottom: 2rem;">Manage subjects under specific examinations.</p>
            
            <div class="glass-panel">
                <h3>Add New Subject</h3>
                <form method="POST" action="/admin/cbt/subjects" style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 1rem;">
                    <div class="form-group">
                        <label>Exam</label>
                        <select name="exam_id" class="form-control" required>
                            <option value="">Select Exam</option>
                            <% exams.forEach(e => { %>
                                <option value="<%= e.id %>" <%= selected_exam == e.id ? 'selected' : '' %>><%= e.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Name (e.g., Mathematics, Use of English)</label>
                        <input type="text" name="name" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Code (Optional)</label>
                        <input type="text" name="code" class="form-control">
                    </div>
                    <div class="form-group">
                        <label>Description</label>
                        <input type="text" name="description" class="form-control">
                    </div>
                    <div class="form-group" style="grid-column: 1 / -1;">
                        <button type="submit" class="btn btn-primary">Create Subject</button>
                    </div>
                </form>
            </div>

            <div style="margin-bottom: 15px;">
                <form method="GET" action="/admin/cbt/subjects" style="display: flex; gap: 10px;">
                    <select name="exam_id" class="form-control" style="width: auto;">
                        <option value="">All Exams</option>
                        <% exams.forEach(e => { %>
                            <option value="<%= e.id %>" <%= selected_exam == e.id ? 'selected' : '' %>><%= e.name %></option>
                        <% }) %>
                    </select>
                    <button type="submit" class="btn btn-secondary">Filter</button>
                </form>
            </div>

            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Exam Body</th>
                        <th>Exam</th>
                        <th>Subject Name</th>
                        <th>Code</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (subjects && subjects.length > 0) { %>
                        <% subjects.forEach(subject => { %>
                            <tr>
                                <td><%= subject.id %></td>
                                <td><%= subject.body_name %></td>
                                <td><%= subject.exam_name %></td>
                                <td><strong><%= subject.name %></strong></td>
                                <td><%= subject.code || '-' %></td>
                                <td>
                                    <a href="/admin/cbt/topics?subject_id=<%= subject.id %>" class="btn btn-sm btn-outline">View Topics</a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" style="text-align: center;">No subjects found.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
            </main>
</body>
</html>
