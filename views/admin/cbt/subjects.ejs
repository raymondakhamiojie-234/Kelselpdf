<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta charset="UTF-8">
    <title>Curricular Subjects - CBT Admin</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <link rel="manifest" href="/manifest.json">
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').catch(err => console.log('SW setup failed: ', err));
            });
        }
    </script>
    <link rel="icon" media="(prefers-color-scheme: light)" href="/acct/img/favicon-dark.png">
    <link rel="icon" media="(prefers-color-scheme: dark)" href="/acct/img/favicon-light.png">
    <style>
        .subjects-layout-grid {
            display: grid;
            grid-template-columns: 0.95fr 1.05fr;
            gap: 24px;
            align-items: start;
        }
        @media (max-width: 1024px) {
            .subjects-layout-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body class="dashboard-body admin-body">
    <%- include('./partials/sidebar', { active_page: 'cbt_subjects' }) %>

    <main class="admin-main-content">
        <!-- Executive Topbar -->
        <header class="admin-topbar">
            <div style="display: flex; align-items: center; gap: 14px;">
                <button class="admin-mobile-toggle" onclick="toggleAdminNav()" aria-label="Toggle Navigation">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                </button>
                <div>
                    <h1 class="admin-title">Curricular Subjects Registry</h1>
                    <p class="admin-subtitle">Configure academic subjects across examination authorities (e.g. Mathematics, English, Biology).</p>
                </div>
            </div>
            <div class="admin-topbar-actions">
                <a href="/admin/cbt" class="btn btn-outline" style="border-radius: 8px; font-weight: 600; font-size: 0.85rem; padding: 8px 14px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                    &larr; CBT Hub
                </a>
                <a href="/admin" class="btn btn-outline" style="border-radius: 8px; font-weight: 600; font-size: 0.85rem; padding: 8px 14px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                    Overview
                </a>
            </div>
        </header>

        <%
            const subjCount = (locals.subjects && subjects.length) ? subjects.length : 0;
            const exCount = (locals.exams && exams.length) ? exams.length : 0;
        %>

        <!-- KPI Metrics Grid -->
        <div class="kpi-grid">
            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Total Subjects</div>
                        <div class="kpi-value"><%= subjCount %></div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(59, 130, 246, 0.12); color: #3b82f6;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #3b82f6; font-weight: 600;">Academic Disciplines</span>
                    <span>&bull; Registered</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Examination Series</div>
                        <div class="kpi-value"><%= exCount %></div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(16, 185, 129, 0.12); color: #10b981;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #10b981; font-weight: 600;">Active Exams</span>
                    <span>&bull; Mapped</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Assessment Depth</div>
                        <div class="kpi-value" style="font-size: 1.45rem;">CBT Multi-choice</div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(139, 92, 246, 0.12); color: #8b5cf6;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="2" x2="12" y2="6"></line><line x1="12" y1="18" x2="12" y2="22"></line><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line><line x1="2" y1="12" x2="6" y2="12"></line><line x1="18" y1="12" x2="22" y2="12"></line><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"></line><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"></line></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #8b5cf6; font-weight: 600;">Simulated Testing</span>
                    <span>&bull; Adaptive</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Syllabus Link</div>
                        <div class="kpi-value" style="font-size: 1.45rem;">Topic Connected</div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(245, 158, 11, 0.12); color: #f59e0b;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #f59e0b; font-weight: 600;">Topic Hierarchy</span>
                    <span>&bull; Modular</span>
                </div>
            </div>
        </div>

        <% if (locals.error) { %>
            <div class="alert alert-error" style="border-radius: 10px; margin-bottom: 24px; display: flex; align-items: center; gap: 12px; padding: 14px 18px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                <span><%= error %></span>
            </div>
        <% } %>

        <!-- Two-Column Workspace -->
        <div class="subjects-layout-grid">
            <!-- Left Column: Add Subject Form -->
            <div class="admin-panel">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px;">
                    <div>
                        <h2 style="font-size: 1.15rem; font-weight: 700; margin: 0; color: var(--text-color);">Register New Subject</h2>
                        <p style="font-size: 0.85rem; color: var(--ntxt-color); margin: 4px 0 0 0;">Add an academic subject discipline to an examination series.</p>
                    </div>
                    <span class="badge-pill info">Curriculum</span>
                </div>

                <form method="POST" action="/admin/cbt/subjects">
                    <div class="form-group" style="margin-bottom: 14px;">
                        <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 6px;">Target Examination</label>
                        <select name="exam_id" class="admin-select" style="width: 100%; box-sizing: border-box;" required>
                            <option value="">Select Examination</option>
                            <% exams.forEach(e => { %>
                                <option value="<%= e.id %>" <%= selected_exam == e.id ? 'selected' : '' %>><%= e.name %> (<%= e.code %>)</option>
                            <% }) %>
                        </select>
                    </div>

                    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 12px; margin-bottom: 14px;">
                        <div class="form-group">
                            <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 6px;">Subject Name</label>
                            <input type="text" name="name" placeholder="e.g. Mathematics, Use of English" class="admin-select" style="width: 100%; box-sizing: border-box;" required>
                        </div>
                        <div class="form-group">
                            <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 6px;">Code (Optional)</label>
                            <input type="text" name="code" placeholder="e.g. MTH" class="admin-select" style="width: 100%; box-sizing: border-box; text-transform: uppercase;">
                        </div>
                    </div>

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 6px;">Description (Optional)</label>
                        <input type="text" name="description" placeholder="Curriculum scope, department requirements..." class="admin-select" style="width: 100%; box-sizing: border-box;">
                    </div>

                    <button type="submit" class="btn btn-ai" style="width: 100%; padding: 12px; font-weight: 600; display: inline-flex; justify-content: center; align-items: center; gap: 8px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        <span>Create Subject Discipline</span>
                    </button>
                </form>
            </div>

            <!-- Right Column: Subjects Table -->
            <div class="admin-panel">
                <div class="admin-filter-bar">
                    <div class="admin-search-box">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        <input type="text" id="subjSearchInput" placeholder="Search subject name, code, or exam..." onkeyup="filterSubjectsTable()">
                    </div>

                    <div class="admin-filter-group">
                        <select id="subjExamFilter" class="admin-select" onchange="filterSubjectsTable()">
                            <option value="all">All Exams</option>
                            <% exams.forEach(e => { %>
                                <option value="<%= e.name.toLowerCase() %>" <%= selected_exam == e.id ? 'selected' : '' %>><%= e.name %></option>
                            <% }) %>
                        </select>

                        <span style="font-size: 0.85rem; color: var(--ntxt-color); padding-left: 6px;">
                            Showing <strong id="subjVisibleCount" style="color: var(--text-color);"><%= subjCount %></strong> of <%= subjCount %>
                        </span>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="data-table" id="subjectsTable">
                        <thead>
                            <tr>
                                <th>Subject & Code</th>
                                <th>Exam Context</th>
                                <th style="text-align: right;">Syllabus</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (subjects && subjects.length > 0) { %>
                                <% subjects.forEach(subject => { %>
                                    <tr class="subj-row" data-name="<%= (subject.name || '').toLowerCase() %>" data-code="<%= (subject.code || '').toLowerCase() %>" data-exam="<%= (subject.exam_name || '').toLowerCase() %>">
                                        <td>
                                            <div style="font-weight: 700; color: var(--text-color); font-size: 0.92rem;"><%= subject.name %></div>
                                            <% if (subject.code) { %>
                                                <span class="badge-pill gray" style="font-family: monospace; font-size: 0.72rem; margin-top: 3px;"><%= subject.code %></span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <span class="badge-pill info" style="font-size: 0.78rem;"><%= subject.exam_name %></span>
                                            <div style="font-size: 0.75rem; color: var(--ntxt-color); margin-top: 3px;"><%= subject.body_name %></div>
                                        </td>
                                        <td style="text-align: right;">
                                            <a href="/admin/cbt/topics?subject_id=<%= subject.id %>" class="btn btn-outline" style="padding: 5px 10px; font-size: 0.78rem; border-radius: 6px; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
                                                <span>Topics</span>
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                                            </a>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="3" style="text-align: center; padding: 3.5rem 1rem; color: var(--ntxt-color);">
                                        No subjects registered yet.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <script>
        function filterSubjectsTable() {
            const query = document.getElementById('subjSearchInput').value.toLowerCase().trim();
            const examFilter = document.getElementById('subjExamFilter').value;
            const rows = document.querySelectorAll('.subj-row');
            let visible = 0;

            rows.forEach(r => {
                const name = r.getAttribute('data-name');
                const code = r.getAttribute('data-code');
                const exam = r.getAttribute('data-exam');

                const matchesQuery = !query || name.includes(query) || code.includes(query) || exam.includes(query);
                const matchesExam = (examFilter === 'all') || exam.includes(examFilter);

                if (matchesQuery && matchesExam) {
                    r.style.display = '';
                    visible++;
                } else {
                    r.style.display = 'none';
                }
            });

            document.getElementById('subjVisibleCount').innerText = visible;
        }
    </script>
</body>
</html>
