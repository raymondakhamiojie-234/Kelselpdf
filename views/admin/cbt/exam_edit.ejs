<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Examination - <%= exam.code %></title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
</head>
<body class="dashboard-body admin-body">
    <%- include('./partials/sidebar', { active_page: 'cbt_exams' }) %>
    <main class="main-content">
        <div style="margin-bottom: 20px;">
            <a href="/admin/cbt/exams" style="color: var(--ntxt-color); text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
                &larr; Back to Examinations
            </a>
        </div>

        <div class="page-header">
            <h2>Edit Examination: <%= exam.code %></h2>
            <p>Update configuration, default duration, or status for this examination.</p>
        </div>

        <% if (error) { %>
            <div class="alert alert-danger" style="margin-bottom: 20px;"><%= error %></div>
        <% } %>

        <div class="glass-panel" style="max-width: 800px;">
            <form method="POST" action="/admin/cbt/exams/<%= exam.id %>/edit" style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <div class="form-group">
                    <label>Exam Body</label>
                    <select name="exam_body_id" class="form-control" required>
                        <% bodies.forEach(b => { %>
                            <option value="<%= b.id %>" <%= exam.exam_body_id == b.id ? 'selected' : '' %>><%= b.code %> - <%= b.name %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="form-group">
                    <label>Status</label>
                    <select name="status" class="form-control">
                        <option value="ACTIVE" <%= exam.status === 'ACTIVE' ? 'selected' : '' %>>ACTIVE</option>
                        <option value="INACTIVE" <%= exam.status === 'INACTIVE' ? 'selected' : '' %>>INACTIVE</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Examination Name (e.g. Senior School Certificate Examination)</label>
                    <input type="text" name="name" class="form-control" value="<%= exam.name %>" required>
                </div>

                <div class="form-group">
                    <label>Examination Code (e.g. SSCE, UTME, WASSCE)</label>
                    <input type="text" name="code" class="form-control" value="<%= exam.code %>" required>
                </div>

                <div class="form-group" style="grid-column: 1 / -1;">
                    <label>Default Duration (Minutes)</label>
                    <input type="number" name="duration" class="form-control" value="<%= exam.duration || '' %>" placeholder="e.g. 120">
                </div>

                <div class="form-group" style="grid-column: 1 / -1;">
                    <label>Description</label>
                    <textarea name="description" class="form-control" rows="4"><%= exam.description || '' %></textarea>
                </div>

                <div class="form-group" style="grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: center; margin-top: 10px;">
                    <a href="/admin/cbt/exams" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary" style="padding: 10px 24px;">Save Changes</button>
                </div>
            </form>
        </div>
    </main>
</body>
</html>
