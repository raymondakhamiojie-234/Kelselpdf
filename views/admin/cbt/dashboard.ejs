<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>CBT Engine Dashboard - Executive Admin</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <link rel="manifest" href="/manifest.json">
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').catch(err => console.log('SW setup failed: ', err));
            });
        }
    </script>
    <link rel="icon" media="(prefers-color-scheme: light)" href="/acct/img/favicon-dark.png">
    <link rel="icon" media="(prefers-color-scheme: dark)" href="/acct/img/favicon-light.png">
    <style>
        .dashboard-layout-grid {
            display: grid;
            grid-template-columns: 1.8fr 1.2fr;
            gap: 24px;
            align-items: start;
        }
        @media (max-width: 1024px) {
            .dashboard-layout-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body class="dashboard-body admin-body">
    <%- include('./partials/sidebar', { active_page: locals.active_page }) %>

    <main class="admin-main-content">
        <!-- Executive Topbar -->
        <header class="admin-topbar">
            <div style="display: flex; align-items: center; gap: 14px;">
                <button class="admin-mobile-toggle" onclick="toggleAdminNav()" aria-label="Toggle Navigation">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                </button>
                <div>
                    <h1 class="admin-title">CBT Engine Hub</h1>
                    <p class="admin-subtitle">Real-time telemetry, mock blueprints, AI ingestion pipeline, and question bank metrics.</p>
                </div>
            </div>
            <div class="admin-topbar-actions">
                <a href="/admin/cbt/import" class="btn btn-primary" style="border-radius: 8px; font-weight: 600; font-size: 0.85rem; padding: 8px 14px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    <span>Upload Exam PDF</span>
                </a>
                <a href="/admin" class="btn btn-outline" style="border-radius: 8px; font-weight: 600; font-size: 0.85rem; padding: 8px 14px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                    &larr; Overview
                </a>
            </div>
        </header>

        <!-- KPI Metrics Grid -->
        <div class="kpi-grid">
            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Total Questions</div>
                        <div class="kpi-value"><%= (stats && stats.total_questions) ? stats.total_questions.toLocaleString() : 0 %></div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(59, 130, 246, 0.12); color: #3b82f6;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="9" x2="20" y2="9"></line><line x1="4" y1="15" x2="20" y2="15"></line><line x1="10" y1="3" x2="8" y2="21"></line><line x1="16" y1="3" x2="14" y2="21"></line></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #3b82f6; font-weight: 600;">Live in Central Bank</span>
                    <span>&bull; Verified</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Pending Review</div>
                        <div class="kpi-value" style="color: <%= (stats && stats.pending_review > 0) ? '#ef4444' : 'var(--text-color)' %>">
                            <%= (stats && stats.pending_review) ? stats.pending_review.toLocaleString() : 0 %>
                        </div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(245, 158, 11, 0.12); color: #f59e0b;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #f59e0b; font-weight: 600;">Awaiting Approval</span>
                    <span>&bull; Staged</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Published Mocks</div>
                        <div class="kpi-value" style="color: #10b981;">
                            <%= (stats && stats.total_mocks) ? stats.total_mocks.toLocaleString() : 0 %>
                        </div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(16, 185, 129, 0.12); color: #10b981;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #10b981; font-weight: 600;">Active Blueprints</span>
                    <span>&bull; Students ready</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Candidate Sessions</div>
                        <div class="kpi-value">
                            <%= (stats && stats.total_candidates) ? stats.total_candidates.toLocaleString() : 0 %>
                        </div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(139, 92, 246, 0.12); color: #8b5cf6;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #8b5cf6; font-weight: 600;">Exam Attempts</span>
                    <span>&bull; Simulated</span>
                </div>
            </div>
        </div>

        <!-- Dashboard Layout -->
        <div class="dashboard-layout-grid">
            <!-- Left: Needs Review Queue -->
            <div class="admin-panel">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                    <div>
                        <h2 style="font-size: 1.15rem; font-weight: 700; margin: 0; color: var(--text-color);">Needs Review (Drafts)</h2>
                        <p style="font-size: 0.82rem; color: var(--ntxt-color); margin: 3px 0 0 0;">Questions extracted via AI awaiting human approval.</p>
                    </div>
                    <a href="/admin/cbt/review" class="copy-pill" style="text-decoration: none; font-size: 0.8rem;">
                        <span>View Queue &rarr;</span>
                    </a>
                </div>

                <div class="table-responsive">
                    <% if (recentDrafts && recentDrafts.length > 0) { %>
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Subject & ID</th>
                                    <th>Question Snippet</th>
                                    <th>Status</th>
                                    <th style="text-align: right;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% recentDrafts.forEach(q => { %>
                                    <tr>
                                        <td>
                                            <span class="badge-pill info" style="font-size: 0.74rem;"><%= q.subject_name %></span>
                                            <div style="font-size: 0.75rem; color: var(--ntxt-color); margin-top: 2px;">#<%= q.id %></div>
                                        </td>
                                        <td>
                                            <div style="font-size: 0.85rem; color: var(--text-color); max-width: 260px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                                <%= q.question_text %>
                                            </div>
                                        </td>
                                        <td><span class="badge-pill warning">DRAFT</span></td>
                                        <td style="text-align: right;">
                                            <a href="/admin/cbt/review" class="btn btn-outline" style="padding: 4px 10px; font-size: 0.75rem; border-radius: 6px; text-decoration: none;">Review</a>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <div style="text-align: center; padding: 3rem 1rem; color: var(--ntxt-color);">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 10px; opacity: 0.4;">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <p style="font-weight: 600; margin: 0; color: var(--text-color);">Queue is Empty</p>
                            <p style="font-size: 0.82rem; margin: 4px 0 0 0;">No questions are waiting for review. You are all caught up!</p>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Right: Exam Breakdown -->
            <div class="admin-panel">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                    <div>
                        <h2 style="font-size: 1.15rem; font-weight: 700; margin: 0; color: var(--text-color);">Exam Distribution</h2>
                        <p style="font-size: 0.82rem; color: var(--ntxt-color); margin: 3px 0 0 0;">Questions indexed across registered exam series.</p>
                    </div>
                    <a href="/admin/cbt/exams" class="copy-pill" style="text-decoration: none; font-size: 0.8rem;">
                        <span>Manage &rarr;</span>
                    </a>
                </div>

                <% if (examStats && examStats.length > 0) { %>
                    <div style="display: flex; flex-direction: column; gap: 10px;">
                        <% examStats.forEach(e => { %>
                            <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 14px; background: var(--bg-color); border: 1px solid var(--border-color); border-radius: 8px;">
                                <div>
                                    <strong style="color: var(--text-color); font-size: 0.92rem;"><%= e.code %></strong>
                                    <div style="font-size: 0.76rem; color: var(--ntxt-color);"><%= e.name || 'Examination Series' %></div>
                                </div>
                                <span class="badge-pill success" style="font-weight: 700;"><%= e.question_count %> Questions</span>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div style="text-align: center; padding: 2.5rem 1rem; color: var(--ntxt-color);">
                        No examinations with questions logged yet.
                    </div>
                <% } %>
            </div>
        </div>
    </main>
</body>
</html>
