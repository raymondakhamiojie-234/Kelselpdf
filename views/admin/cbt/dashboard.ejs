<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CBT Engine Dashboard - Admin</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <style>
        .kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 30px; }
        .kpi-card { background: var(--card-bg); padding: 25px; border-radius: 12px; border: 1px solid var(--border-color); box-shadow: 0 4px 15px rgba(0,0,0,0.03); display: flex; flex-direction: column; }
        .kpi-title { font-size: 0.85rem; color: var(--ntxt-color); text-transform: uppercase; font-weight: bold; letter-spacing: 0.5px; margin-bottom: 10px; }
        .kpi-value { font-size: 2.5rem; font-weight: 800; color: var(--text-color); margin-bottom: 5px; }
        .kpi-trend { font-size: 0.85rem; color: #10b981; font-weight: 500; }
        .kpi-trend.danger { color: #ef4444; }

        .dashboard-layout { display: grid; grid-template-columns: 2fr 1fr; gap: 20px; }
        .panel { background: var(--card-bg); padding: 25px; border-radius: 12px; border: 1px solid var(--border-color); }
        .panel h3 { margin-bottom: 20px; color: var(--text-color); font-size: 1.2rem; }

        .data-table { width: 100%; border-collapse: collapse; }
        .data-table th, .data-table td { padding: 12px 15px; text-align: left; border-bottom: 1px solid var(--border-color); }
        .data-table th { color: var(--ntxt-color); font-size: 0.85rem; text-transform: uppercase; }
        .data-table td { color: var(--text-color); font-size: 0.95rem; }
        
        .empty-state { text-align: center; padding: 2rem; color: var(--ntxt-color); }
        
        /* Modern Badges */
        .badge { display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: bold; }
        .badge-warning { background: rgba(245, 158, 11, 0.1); color: #f59e0b; }
        .badge-success { background: rgba(16, 185, 129, 0.1); color: #10b981; }
    </style>
</head>
<body class="dashboard-body">
    <%- include('./partials/sidebar', { active_page: locals.active_page }) %>

    <main class="main-content">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
            <div>
                <h1 style="color: var(--text-color); font-size: 2rem; font-weight: 800;">Platform Overview</h1>
                <p style="color: var(--ntxt-color);">Welcome back. Here is what is happening on the KelselPDF CBT Engine today.</p>
            </div>
            <a href="/admin/cbt/import" class="btn btn-primary" style="padding: 10px 20px; font-weight: bold; font-size: 0.95rem; background: var(--primary-color);">+ Upload Exam PDF</a>
        </div>

        <div class="kpi-grid">
            <div class="kpi-card">
                <div class="kpi-title">Total Questions</div>
                <div class="kpi-value"><%= stats.total_questions.toLocaleString() %></div>
                <div class="kpi-trend">Live in Bank</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-title">Pending Review</div>
                <div class="kpi-value" style="color: <%= stats.pending_review > 0 ? '#ef4444' : 'var(--text-color)' %>"><%= stats.pending_review.toLocaleString() %></div>
                <div class="kpi-trend <%= stats.pending_review > 0 ? 'danger' : '' %>">Awaiting Approval</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-title">Published Mocks</div>
                <div class="kpi-value"><%= stats.total_mocks.toLocaleString() %></div>
                <div class="kpi-trend">Active Blueprints</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-title">Total Candidates</div>
                <div class="kpi-value"><%= stats.total_candidates.toLocaleString() %></div>
                <div class="kpi-trend">Exam Sessions</div>
            </div>
        </div>

        <div class="dashboard-layout">
            <div class="panel">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                    <h3 style="margin: 0;">Needs Review (Drafts)</h3>
                    <a href="/admin/cbt/review" style="color: var(--primary-color); text-decoration: none; font-size: 0.9rem; font-weight: bold;">View Queue →</a>
                </div>
                
                <% if (recentDrafts && recentDrafts.length > 0) { %>
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Subject</th>
                                <th>Question Snippet</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% recentDrafts.forEach(q => { %>
                                <tr>
                                    <td style="color: var(--ntxt-color);">#<%= q.id %></td>
                                    <td><strong><%= q.subject_name %></strong></td>
                                    <td><%= q.question_text.substring(0, 40) %>...</td>
                                    <td><span class="badge badge-warning">DRAFT</span></td>
                                    <td><a href="/admin/cbt/review" style="color: var(--primary-color);">Review</a></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } else { %>
                    <div class="empty-state">
                        <div style="font-size: 2rem; margin-bottom: 10px;">🎉</div>
                        <strong>Queue is Empty</strong>
                        <p>No questions are waiting for review. You are all caught up!</p>
                    </div>
                <% } %>
            </div>

            <div class="panel">
                <h3>Exam Breakdown</h3>
                <% if (examStats && examStats.length > 0) { %>
                    <ul style="list-style: none; padding: 0; margin: 0;">
                        <% examStats.forEach(e => { %>
                            <li style="display: flex; justify-content: space-between; padding: 15px 0; border-bottom: 1px solid var(--border-color);">
                                <strong style="color: var(--text-color);"><%= e.code %></strong>
                                <span class="badge badge-success"><%= e.question_count %> Qs</span>
                            </li>
                        <% }) %>
                    </ul>
                <% } else { %>
                    <div class="empty-state">No exams found.</div>
                <% } %>
            </div>
        </div>
    </main>
</body>
</html>
