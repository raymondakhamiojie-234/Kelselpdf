<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta charset="UTF-8">
    <title>Syllabus Topics - CBT Admin</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <link rel="manifest" href="/manifest.json">
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').catch(err => console.log('SW setup failed: ', err));
            });
        }
    </script>
    <link rel="icon" media="(prefers-color-scheme: light)" href="/acct/img/favicon-dark.png">
    <link rel="icon" media="(prefers-color-scheme: dark)" href="/acct/img/favicon-light.png">
    <style>
        .topics-layout-grid {
            display: grid;
            grid-template-columns: 0.95fr 1.05fr;
            gap: 24px;
            align-items: start;
        }
        @media (max-width: 1024px) {
            .topics-layout-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body class="dashboard-body admin-body">
    <%- include('./partials/sidebar', { active_page: 'cbt_topics' }) %>

    <main class="admin-main-content">
        <!-- Executive Topbar -->
        <header class="admin-topbar">
            <div style="display: flex; align-items: center; gap: 14px;">
                <button class="admin-mobile-toggle" onclick="toggleAdminNav()" aria-label="Toggle Navigation">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                </button>
                <div>
                    <h1 class="admin-title">Curricular Syllabus Topics</h1>
                    <p class="admin-subtitle">Manage modular topics and syllabus units mapped to specific examination subjects.</p>
                </div>
            </div>
            <div class="admin-topbar-actions">
                <a href="/admin/cbt" class="btn btn-outline" style="border-radius: 8px; font-weight: 600; font-size: 0.85rem; padding: 8px 14px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                    &larr; CBT Hub
                </a>
                <a href="/admin" class="btn btn-outline" style="border-radius: 8px; font-weight: 600; font-size: 0.85rem; padding: 8px 14px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                    Overview
                </a>
            </div>
        </header>

        <%
            const topicCount = (locals.topics && topics.length) ? topics.length : 0;
            const subCount = (locals.subjects && subjects.length) ? subjects.length : 0;
        %>

        <!-- KPI Metrics Grid -->
        <div class="kpi-grid">
            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Registered Topics</div>
                        <div class="kpi-value"><%= topicCount %></div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(59, 130, 246, 0.12); color: #3b82f6;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #3b82f6; font-weight: 600;">Syllabus Units</span>
                    <span>&bull; Modular Taxonomy</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Parent Subjects</div>
                        <div class="kpi-value"><%= subCount %></div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(16, 185, 129, 0.12); color: #10b981;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #10b981; font-weight: 600;">Subject Domains</span>
                    <span>&bull; Mapped</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Granularity</div>
                        <div class="kpi-value" style="font-size: 1.45rem;">Topic Practice</div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(139, 92, 246, 0.12); color: #8b5cf6;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #8b5cf6; font-weight: 600;">Focused Diagnostics</span>
                    <span>&bull; Drill down</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Taxonomy Level</div>
                        <div class="kpi-value" style="font-size: 1.45rem;">2-Tier System</div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(245, 158, 11, 0.12); color: #f59e0b;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #f59e0b; font-weight: 600;">Subject &rarr; Topic</span>
                    <span>&bull; Standardized</span>
                </div>
            </div>
        </div>

        <% if (locals.error) { %>
            <div class="alert alert-error" style="border-radius: 10px; margin-bottom: 24px; display: flex; align-items: center; gap: 12px; padding: 14px 18px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                <span><%= error %></span>
            </div>
        <% } %>

        <!-- Two-Column Workspace -->
        <div class="topics-layout-grid">
            <!-- Left Column: Add Topic Form -->
            <div class="admin-panel">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px;">
                    <div>
                        <h2 style="font-size: 1.15rem; font-weight: 700; margin: 0; color: var(--text-color);">Create Syllabus Topic</h2>
                        <p style="font-size: 0.85rem; color: var(--ntxt-color); margin: 4px 0 0 0;">Add a new curriculum topic under a specific subject.</p>
                    </div>
                    <span class="badge-pill info">Module</span>
                </div>

                <form method="POST" action="/admin/cbt/topics">
                    <div class="form-group" style="margin-bottom: 16px;">
                        <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 6px;">Target Subject</label>
                        <select name="subject_id" class="admin-select" style="width: 100%; box-sizing: border-box;" required>
                            <option value="">Select Subject</option>
                            <% subjects.forEach(s => { %>
                                <option value="<%= s.id %>" <%= selected_subject == s.id ? 'selected' : '' %>><%= s.name %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="form-group" style="margin-bottom: 16px;">
                        <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 6px;">Topic Name</label>
                        <input type="text" name="name" placeholder="e.g. Quadratic Equations, Photosynthesis" class="admin-select" style="width: 100%; box-sizing: border-box;" required>
                    </div>

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 6px;">Description (Optional)</label>
                        <textarea name="description" rows="3" placeholder="Syllabus objectives, sub-themes, or scope..." class="admin-select" style="width: 100%; box-sizing: border-box; resize: vertical;"></textarea>
                    </div>

                    <button type="submit" class="btn btn-ai" style="width: 100%; padding: 12px; font-weight: 600; display: inline-flex; justify-content: center; align-items: center; gap: 8px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        <span>Create Syllabus Topic</span>
                    </button>
                </form>
            </div>

            <!-- Right Column: Topics Table -->
            <div class="admin-panel">
                <div class="admin-filter-bar">
                    <div class="admin-search-box">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        <input type="text" id="topicSearchInput" placeholder="Search topic name or subject..." onkeyup="filterTopicsTable()">
                    </div>

                    <div class="admin-filter-group">
                        <select id="topicSubjectFilter" class="admin-select" onchange="filterTopicsTable()">
                            <option value="all">All Subjects</option>
                            <% subjects.forEach(s => { %>
                                <option value="<%= s.name.toLowerCase() %>" <%= selected_subject == s.id ? 'selected' : '' %>><%= s.name %></option>
                            <% }) %>
                        </select>

                        <span style="font-size: 0.85rem; color: var(--ntxt-color); padding-left: 6px;">
                            Showing <strong id="topicVisibleCount" style="color: var(--text-color);"><%= topicCount %></strong> of <%= topicCount %>
                        </span>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="data-table" id="topicsTable">
                        <thead>
                            <tr>
                                <th>Subject Domain</th>
                                <th>Topic Title</th>
                                <th style="text-align: right;">ID</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (topics && topics.length > 0) { %>
                                <% topics.forEach(topic => { %>
                                    <tr class="topic-row" data-name="<%= (topic.name || '').toLowerCase() %>" data-subject="<%= (topic.subject_name || '').toLowerCase() %>">
                                        <td>
                                            <span class="badge-pill info" style="font-weight: 700; font-size: 0.78rem;">
                                                <%= topic.subject_name %>
                                            </span>
                                        </td>
                                        <td>
                                            <strong style="color: var(--text-color); font-size: 0.92rem;"><%= topic.name %></strong>
                                        </td>
                                        <td style="text-align: right; color: var(--ntxt-color); font-family: monospace; font-size: 0.8rem;">
                                            #<%= topic.id %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="3" style="text-align: center; padding: 3.5rem 1rem; color: var(--ntxt-color);">
                                        No syllabus topics registered yet.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <script>
        function filterTopicsTable() {
            const query = document.getElementById('topicSearchInput').value.toLowerCase().trim();
            const subjectFilter = document.getElementById('topicSubjectFilter').value;
            const rows = document.querySelectorAll('.topic-row');
            let visible = 0;

            rows.forEach(r => {
                const name = r.getAttribute('data-name');
                const subject = r.getAttribute('data-subject');

                const matchesQuery = !query || name.includes(query) || subject.includes(query);
                const matchesSubject = (subjectFilter === 'all') || subject === subjectFilter;

                if (matchesQuery && matchesSubject) {
                    r.style.display = '';
                    visible++;
                } else {
                    r.style.display = 'none';
                }
            });

            document.getElementById('topicVisibleCount').innerText = visible;
        }
    </script>
</body>
</html>
