<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CBT Admin - Import Questions</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <style>
        .cbt-container { display: flex; height: 100vh; background: var(--bg-color); }
        .cbt-sidebar { width: 250px; background: var(--card-bg); border-right: 1px solid var(--border-color); padding: 2rem 1rem; }
        .cbt-sidebar a { display: block; padding: 10px 15px; color: var(--text-color); text-decoration: none; border-radius: 8px; margin-bottom: 5px; }
        .cbt-sidebar a:hover, .cbt-sidebar a.active { background: var(--primary-color); color: white; }
        .cbt-content { flex: 1; padding: 2rem; overflow-y: auto; }
        .form-group { margin-bottom: 15px; }
        .form-control { width: 100%; padding: 10px; border-radius: 6px; border: 1px solid var(--border-color); background: var(--bg-color); color: var(--text-color); }
        .glass-panel { background: var(--card-bg); padding: 1.5rem; border-radius: 12px; border: 1px solid var(--border-color); margin-bottom: 2rem; }
        .alert { padding: 15px; border-radius: 8px; margin-bottom: 20px; font-weight: bold; }
        .alert-warning { background: #fff3cd; color: #856404; border: 1px solid #ffeeba; }
        .alert-success { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
        .alert-danger { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
    </style>
</head>
<body class="dark-mode">
    <div class="cbt-container">
        <div class="cbt-sidebar">
            <h3 style="margin-bottom: 2rem; padding-left: 15px; color: var(--primary-color);">CBT Engine Admin</h3>
            <a href="/admin/cbt/exam_bodies">Exam Bodies</a>
            <a href="/admin/cbt/exams">Exams</a>
            <a href="/admin/cbt/subjects">Subjects</a>
            <a href="/admin/cbt/topics">Topics</a>
            <a href="/admin/cbt/questions">Question Bank</a>`n            <a href="/admin/cbt/import">Import Questions</a>`n            <a href="/admin/cbt/review">Review Queue</a>
            <a href="/admin/cbt/import" class="active">Import Questions</a>
            <a href="/admin/cbt/review">Review Queue</a>
            <hr style="border-color: var(--border-color); margin: 2rem 0;">
            <a href="/admin/dashboard">Back to Main Admin</a>
        </div>
        
        <div class="cbt-content">
            <h2 style="margin-bottom: 1rem;">Import & Extract Questions</h2>
            <p style="color: var(--ntxt-color); margin-bottom: 2rem;">Upload Past Question PDFs. The Gemini AI will extract text, detect questions, and push them to the Review Queue.</p>
            
            <% if (success) { %>
                <div class="alert alert-success"><%= success %></div>
            <% } %>
            <% if (error) { %>
                <div class="alert alert-danger"><%= error %></div>
            <% } %>

            <div class="alert alert-warning">
                ?? SECURITY WARNING: Verify ownership, licensing, or permission before publishing externally sourced examination material. All AI-extracted questions are placed in PENDING REVIEW status.
            </div>

            <div class="glass-panel">
                <h3>PDF Upload (Gemini AI Extraction)</h3>
                <form method="POST" action="/admin/cbt/import/pdf" enctype="multipart/form-data" style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 1rem;">
                    
                    <div class="form-group">
                        <label>Exam Body</label>
                        <select name="exam_body_id" id="bodySelect" class="form-control" required>
                            <option value="">Select Exam Body</option>
                            <% bodies.forEach(b => { %>
                                <option value="<%= b.id %>"><%= b.code %> - <%= b.name %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Exam</label>
                        <select name="exam_id" id="examSelect" class="form-control" required disabled>
                            <option value="">Select Exam</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Subject</label>
                        <select name="subject_id" id="subjectSelect" class="form-control" required disabled>
                            <option value="">Select Subject</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Year (Optional)</label>
                        <input type="number" name="year" class="form-control" placeholder="e.g. 2019">
                    </div>
                    
                    <div class="form-group" style="grid-column: 1 / -1;">
                        <label>Select PDF File</label>
                        <input type="file" name="pdf_file" accept=".pdf" class="form-control" required style="padding: 10px; background: rgba(0,0,0,0.1);">
                    </div>

                    <div class="form-group" style="grid-column: 1 / -1; display: flex; justify-content: flex-end;">
                        <button type="submit" class="btn btn-primary" onclick="this.innerHTML='Extracting... Please wait (up to 30s) '; this.style.opacity=0.7;">Upload & Extract</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        const bodySelect = document.getElementById('bodySelect');
        const examSelect = document.getElementById('examSelect');
        const subjectSelect = document.getElementById('subjectSelect');

        bodySelect.addEventListener('change', async () => {
            examSelect.innerHTML = '<option value="">Select Exam</option>';
            subjectSelect.innerHTML = '<option value="">Select Subject</option>';
            examSelect.disabled = true;
            subjectSelect.disabled = true;

            if (bodySelect.value) {
                const res = await fetch('/api/cbt/exams/' + bodySelect.value);
                const exams = await res.json();
                exams.forEach(e => {
                    examSelect.innerHTML += `<option value="${e.id}">${e.name}</option>`;
                });
                examSelect.disabled = false;
            }
        });

        examSelect.addEventListener('change', async () => {
            subjectSelect.innerHTML = '<option value="">Select Subject</option>';
            subjectSelect.disabled = true;

            if (examSelect.value) {
                const res = await fetch('/api/cbt/subjects/' + examSelect.value);
                const subjects = await res.json();
                subjects.forEach(s => {
                    subjectSelect.innerHTML += `<option value="${s.id}">${s.name}</option>`;
                });
                subjectSelect.disabled = false;
            }
        });
    </script>
</body>
</html>
