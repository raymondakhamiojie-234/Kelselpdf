<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CBT Admin - import</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
</head>
<body class="dashboard-body">
    <%- include('./partials/sidebar', { active_page: 'cbt_import' }) %>
    <main class="main-content">
            <h2 style="margin-bottom: 1rem;">Import & Extract Questions</h2>
            <p style="color: var(--ntxt-color); margin-bottom: 2rem;">Upload Past Question PDFs. The Gemini AI will extract text, detect questions, and push them to the Review Queue.</p>
            
            <% if (success) { %>
                <div class="alert alert-success" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.35); padding: 14px 18px; border-radius: 8px;">
                    <div style="flex: 1; min-width: 250px; font-weight: 500;"><%= success %></div>
                    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                        <a href="/cbt/setup" target="_blank" class="btn btn-primary" style="padding: 7px 14px; font-size: 0.82rem; text-decoration: none; border-radius: 6px;">View Mock Page ↗</a>
                        <a href="/admin/cbt/mocks" class="btn btn-secondary" style="padding: 7px 14px; font-size: 0.82rem; text-decoration: none; border-radius: 6px;">Manage Blueprints</a>
                        <a href="/admin/cbt/review" class="btn btn-secondary" style="padding: 7px 14px; font-size: 0.82rem; text-decoration: none; border-radius: 6px;">Review Queue</a>
                    </div>
                </div>
            <% } %>
            <% if (error) { %>
                <div class="alert alert-danger"><%= error %></div>
            <% } %>

            <div class="alert alert-warning">
                ?? SECURITY WARNING: Verify ownership, licensing, or permission before publishing externally sourced examination material. All AI-extracted questions are placed in PENDING REVIEW status.
            </div>

            <div class="glass-panel">
                <h3>PDF Upload (Gemini AI Extraction)</h3>
                <form method="POST" action="/admin/cbt/import/pdf" enctype="multipart/form-data" style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 1rem;">
                    
                    <div class="form-group">
                        <label>Exam Body</label>
                        <select name="exam_body_id" id="bodySelect" class="form-control" required>
                            <option value="">Select Exam Body</option>
                            <% bodies.forEach(b => { %>
                                <option value="<%= b.id %>"><%= b.code %> - <%= b.name %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Exam</label>
                        <select name="exam_id" id="examSelect" class="form-control" required disabled>
                            <option value="">Select Exam</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Subject</label>
                        <select name="subject_id" id="subjectSelect" class="form-control" required disabled>
                            <option value="">Select Subject</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Year (Optional)</label>
                        <input type="number" name="year" class="form-control" placeholder="e.g. 2019">
                    </div>
                    
                    <div class="form-group" style="grid-column: 1 / -1;">
                        <label>Select PDF File</label>
                        <input type="file" name="pdf_file" accept=".pdf" class="form-control" required style="padding: 10px; background: rgba(0,0,0,0.1);">
                    </div>

                    <div class="form-group" style="grid-column: 1 / -1; background: rgba(59, 130, 246, 0.06); border: 1px solid rgba(59, 130, 246, 0.2); border-radius: 8px; padding: 14px 16px;">
                        <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; margin-bottom: 8px;">
                            <input type="checkbox" name="direct_publish" checked>
                            <span style="color: var(--text-color); font-weight: 600;">Directly Publish to Live Bank</span>
                            <span style="font-size: 0.82rem; color: #10b981;">(Questions immediately become available for student mocks)</span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; margin-bottom: 0;">
                            <input type="checkbox" name="auto_create_mock" checked>
                            <span style="color: var(--text-color); font-weight: 600;">Automatically Create/Update Mock Examination</span>
                            <span style="font-size: 0.82rem; color: var(--ntxt-color);">(Instantly adds this mock to the student Mock Exam page)</span>
                        </label>
                    </div>

                    <div class="form-group" style="grid-column: 1 / -1; display: flex; justify-content: flex-end;">
                        <button type="submit" class="btn btn-primary" onclick="this.innerHTML='Extracting... Please wait (up to 30s) '; this.style.opacity=0.7;">Upload & Extract</button>
                    </div>
                </form>
            </div>
        <script>
        const bodySelect = document.getElementById('bodySelect');
        const examSelect = document.getElementById('examSelect');
        const subjectSelect = document.getElementById('subjectSelect');

        bodySelect.addEventListener('change', async () => {
            examSelect.innerHTML = '<option value="">Select Exam</option>';
            subjectSelect.innerHTML = '<option value="">Select Subject</option>';
            examSelect.disabled = true;
            subjectSelect.disabled = true;

            if (bodySelect.value) {
                const res = await fetch('/api/cbt/exams/' + bodySelect.value);
                const exams = await res.json();
                exams.forEach(e => {
                    examSelect.innerHTML += `<option value="${e.id}">${e.name}</option>`;
                });
                examSelect.disabled = false;
            }
        });

        examSelect.addEventListener('change', async () => {
            subjectSelect.innerHTML = '<option value="">Select Subject</option>';
            subjectSelect.disabled = true;

            if (examSelect.value) {
                const res = await fetch('/api/cbt/subjects/' + examSelect.value);
                const subjects = await res.json();
                subjects.forEach(s => {
                    subjectSelect.innerHTML += `<option value="${s.id}">${s.name}</option>`;
                });
                subjectSelect.disabled = false;
            }
        });
    </script>
</body>
</html>
