<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CBT Admin - Content Review Queue</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
</head>
<body class="dashboard-body admin-body">
    <%- include('./partials/sidebar', { active_page: 'cbt_review' }) %>
    <main class="main-content">
        <div class="page-header">
            <h2>Content Review Queue</h2>
            <p>Verify and approve AI-extracted examination questions before releasing them into the live student bank.</p>
        </div>

        <% if (questions && questions.length > 0) { %>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3); border-radius: 10px; padding: 12px 18px;">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <span style="font-size: 1.2rem;">⚠️</span>
                    <strong style="color: #f59e0b;"><%= questions.length %> question<%= questions.length > 1 ? 's' : '' %> awaiting review</strong>
                </div>
                <span style="font-size: 0.85rem; color: var(--ntxt-color);">Status: DRAFT</span>
            </div>
            
            <% questions.forEach(q => { %>
                <div class="review-card">
                    <div class="review-header">
                        <div>
                            <strong style="font-size: 1.05rem; color: var(--text-color);"><%= q.subject_name %></strong>
                            <span style="color: var(--ntxt-color); font-size: 0.9rem;"> &mdash; Year: <%= q.year || 'N/A' %></span>
                            <% if (q.topic) { %>
                                <span class="badge badge-info" style="margin-left: 8px; font-size: 0.72rem;">Topic: <%= q.topic %></span>
                            <% } %>
                            <div style="font-size: 0.8rem; color: var(--ntxt-color); margin-top: 4px;">
                                Source: <%= q.source || 'Uploaded Document' %> &bull; Difficulty: <%= q.difficulty || 'MEDIUM' %>
                            </div>
                        </div>
                        <div>
                            <span class="badge badge-warning">PENDING REVIEW</span>
                        </div>
                    </div>

                    <form id="approve-form-<%= q.id %>" method="POST" action="/admin/cbt/questions/<%= q.id %>/approve">
                        <div class="form-group">
                            <label style="color: var(--primary-color); font-weight: 700;">Question Text</label>
                            <textarea name="question_text" class="form-control" rows="3" required><%= q.question_text %></textarea>
                        </div>
                        
                        <div class="opt-grid">
                            <div class="form-group">
                                <label>Option A</label>
                                <input type="text" name="option_a" class="form-control" value="<%= q.option_a %>" required>
                            </div>
                            <div class="form-group">
                                <label>Option B</label>
                                <input type="text" name="option_b" class="form-control" value="<%= q.option_b %>" required>
                            </div>
                            <div class="form-group">
                                <label>Option C</label>
                                <input type="text" name="option_c" class="form-control" value="<%= q.option_c %>" required>
                            </div>
                            <div class="form-group">
                                <label>Option D</label>
                                <input type="text" name="option_d" class="form-control" value="<%= q.option_d %>" required>
                            </div>
                            <% if (q.option_e) { %>
                                <div class="form-group" style="grid-column: 1 / -1;">
                                    <label>Option E</label>
                                    <input type="text" name="option_e" class="form-control" value="<%= q.option_e %>">
                                </div>
                            <% } %>
                        </div>
                        
                        <!-- Review Action Toolbar -->
                        <div style="display: flex; justify-content: space-between; align-items: flex-end; gap: 15px; margin-top: 20px; padding-top: 18px; border-top: 1px solid var(--border-color); flex-wrap: wrap;">
                            <div style="display: flex; gap: 15px; flex: 1; min-width: 280px; flex-wrap: wrap;">
                                <div class="form-group" style="flex: 1; min-width: 130px; margin-bottom: 0;">
                                    <label>Correct Answer</label>
                                    <select name="correct_answer" class="form-control">
                                        <option value="A" <%= q.correct_answer === 'A' ? 'selected' : '' %>>A</option>
                                        <option value="B" <%= q.correct_answer === 'B' ? 'selected' : '' %>>B</option>
                                        <option value="C" <%= q.correct_answer === 'C' ? 'selected' : '' %>>C</option>
                                        <option value="D" <%= q.correct_answer === 'D' ? 'selected' : '' %>>D</option>
                                        <option value="E" <%= q.correct_answer === 'E' ? 'selected' : '' %>>E</option>
                                    </select>
                                </div>
                                <div class="form-group" style="flex: 2; min-width: 180px; margin-bottom: 0;">
                                    <label>License & Distribution</label>
                                    <select name="license_status" class="form-control">
                                        <option value="AUTHORIZED" <%= q.license_status === 'AUTHORIZED' ? 'selected' : '' %>>Authorized (Safe to Publish)</option>
                                        <option value="RESTRICTED" <%= q.license_status === 'RESTRICTED' ? 'selected' : '' %>>Restricted (Internal Only)</option>
                                    </select>
                                </div>
                            </div>

                            <div style="display: flex; gap: 10px; align-items: center; margin-top: 10px;">
                                <button type="button" class="btn btn-outline" onclick="confirmReject(<%= q.id %>)" style="color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.4); background: rgba(239, 68, 68, 0.05); padding: 9px 18px; border-radius: 8px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
                                    <span>✕</span>
                                    <span>Reject & Delete</span>
                                </button>
                                <button type="submit" class="btn btn-primary" style="background: #10b981; border: none; padding: 9px 22px; border-radius: 8px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25);">
                                    <span>✓</span>
                                    <span>Approve & Publish</span>
                                </button>
                            </div>
                        </div>
                    </form>

                    <!-- Separate Hidden Reject Form -->
                    <form id="reject-form-<%= q.id %>" method="POST" action="/admin/cbt/questions/<%= q.id %>/reject" style="display: none;"></form>
                </div>
            <% }) %>
        <% } else { %>
            <div style="padding: 3.5rem 1.5rem; text-align: center; background: var(--card-bg); border-radius: 14px; border: 1px dashed var(--border-color); max-width: 600px; margin: 2rem auto;">
                <div style="font-size: 3rem; margin-bottom: 12px;">🎉</div>
                <h3 style="color: #10b981; margin: 0 0 6px 0; font-size: 1.4rem;">Queue is Empty!</h3>
                <p style="color: var(--ntxt-color); margin: 0 0 20px 0;">All extracted examination questions have been reviewed and published.</p>
                <a href="/admin/cbt/import" class="btn btn-primary" style="padding: 9px 20px; font-weight: 600; border-radius: 8px; text-decoration: none;">+ Upload Another PDF</a>
            </div>
        <% } %>
    </main>

    <script>
        function confirmReject(questionId) {
            if (confirm('Are you sure you want to permanently delete and reject this question?')) {
                const form = document.getElementById('reject-form-' + questionId);
                if (form) {
                    form.submit();
                }
            }
        }
    </script>
</body>
</html>
