<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta charset="UTF-8">
    <title>Mock Blueprints - CBT Admin</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <link rel="manifest" href="/manifest.json">
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').catch(err => console.log('SW setup failed: ', err));
            });
        }
    </script>
    <link rel="icon" media="(prefers-color-scheme: light)" href="/acct/img/favicon-dark.png">
    <link rel="icon" media="(prefers-color-scheme: dark)" href="/acct/img/favicon-light.png">
    <style>
        .blueprint-table {
            width: 100%;
            border-collapse: collapse;
        }
        .blueprint-table th {
            padding: 10px 14px;
            text-align: left;
            font-size: 0.75rem;
            text-transform: uppercase;
            color: var(--ntxt-color);
            border-bottom: 1px solid var(--border-color);
            background: rgba(0,0,0,0.05);
        }
        .blueprint-table td {
            padding: 12px 14px;
            border-bottom: 1px solid var(--border-color);
            color: var(--text-color);
            font-size: 0.88rem;
        }
    </style>
</head>
<body class="dashboard-body admin-body">
    <%- include('./partials/sidebar', { active_page: 'cbt_mocks' }) %>

    <main class="admin-main-content">
        <!-- Executive Topbar -->
        <header class="admin-topbar">
            <div style="display: flex; align-items: center; gap: 14px;">
                <button class="admin-mobile-toggle" onclick="toggleAdminNav()" aria-label="Toggle Navigation">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                </button>
                <div>
                    <h1 class="admin-title">Mock Examination Blueprints</h1>
                    <p class="admin-subtitle">Configure, publish, and manage multi-subject simulated CBT mock examinations.</p>
                </div>
            </div>
            <div class="admin-topbar-actions">
                <a href="/admin/cbt/mocks/create" class="btn btn-primary" style="border-radius: 8px; font-weight: 600; font-size: 0.85rem; padding: 8px 14px; display: inline-flex; align-items: center; gap: 6px; text-decoration: none;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    <span>Create New Mock</span>
                </a>
                <a href="/admin" class="btn btn-outline" style="border-radius: 8px; font-weight: 600; font-size: 0.85rem; padding: 8px 14px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                    &larr; Overview
                </a>
            </div>
        </header>

        <%
            const totalCount = stats ? stats.total : mocks.length;
            const pubCount = stats ? stats.published : mocks.filter(m => m.status === 'PUBLISHED').length;
            const draftCount = stats ? stats.draft : mocks.filter(m => m.status === 'DRAFT').length;
            const totalQuestionsCount = stats ? stats.total_questions : mocks.reduce((a, m) => a + (parseInt(m.total_questions) || 0), 0);
        %>

        <!-- KPI Metrics Grid -->
        <div class="kpi-grid">
            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Total Blueprints</div>
                        <div class="kpi-value"><%= totalCount %></div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(59, 130, 246, 0.12); color: #3b82f6;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #3b82f6; font-weight: 600;">Configured Sessions</span>
                    <span>&bull; Full Matrix</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Published Live</div>
                        <div class="kpi-value" style="color: #10b981;"><%= pubCount %></div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(16, 185, 129, 0.12); color: #10b981;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #10b981; font-weight: 600;">Active for Students</span>
                    <span>&bull; Ready</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">In Draft</div>
                        <div class="kpi-value" style="color: #f59e0b;"><%= draftCount %></div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(245, 158, 11, 0.12); color: #f59e0b;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #f59e0b; font-weight: 600;">Staging Status</span>
                    <span>&bull; Hidden</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Question Volume</div>
                        <div class="kpi-value" style="color: #8b5cf6;"><%= totalQuestionsCount %></div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(139, 92, 246, 0.12); color: #8b5cf6;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="9" x2="20" y2="9"></line><line x1="4" y1="15" x2="20" y2="15"></line><line x1="10" y1="3" x2="8" y2="21"></line><line x1="16" y1="3" x2="14" y2="21"></line></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #8b5cf6; font-weight: 600;">Allocated Questions</span>
                    <span>&bull; Balanced</span>
                </div>
            </div>
        </div>

        <!-- Main Panel -->
        <div class="admin-panel">
            <div class="admin-filter-bar">
                <div class="admin-search-box">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="text" id="mockSearchInput" placeholder="Search mock title, exam name, or code..." onkeyup="filterMocksTable()">
                </div>

                <div class="admin-filter-group">
                    <select id="mockStatusFilter" class="admin-select" onchange="filterMocksTable()">
                        <option value="all">All Statuses</option>
                        <option value="PUBLISHED">Published Live</option>
                        <option value="DRAFT">In Draft</option>
                    </select>

                    <span style="font-size: 0.85rem; color: var(--ntxt-color); padding-left: 6px;">
                        Showing <strong id="mockVisibleCount" style="color: var(--text-color);"><%= mocks.length %></strong> of <%= mocks.length %>
                    </span>
                </div>
            </div>

            <!-- Table -->
            <div class="table-responsive">
                <table class="data-table" id="mocksTable">
                    <thead>
                        <tr>
                            <th>Mock Blueprint & Access</th>
                            <th>Target Exam</th>
                            <th>Duration</th>
                            <th>Structure & Allocation</th>
                            <th>Status</th>
                            <th style="text-align: right; min-width: 170px;">Administrative Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!mocks || mocks.length === 0) { %>
                            <tr>
                                <td colspan="6" style="text-align: center; padding: 4rem 1rem; color: var(--ntxt-color);">
                                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 12px; opacity: 0.4;">
                                        <circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle>
                                    </svg>
                                    <p style="font-weight: 600; margin: 0; color: var(--text-color);">No Mock Blueprints Created Yet</p>
                                    <p style="font-size: 0.85rem; margin: 4px 0 16px 0;">Design your first simulated multi-subject mock examination.</p>
                                    <a href="/admin/cbt/mocks/create" class="btn btn-primary" style="padding: 8px 18px; font-size: 0.85rem; text-decoration: none;">+ Create First Mock</a>
                                </td>
                            </tr>
                        <% } else { %>
                            <% mocks.forEach(m => { %>
                                <tr class="mock-row" data-title="<%= (m.title || '').toLowerCase() %>" data-exam="<%= (m.exam_code || m.exam_name || '').toLowerCase() %>" data-status="<%= m.status %>">
                                    <td>
                                        <div style="font-weight: 700; font-size: 0.96rem; color: var(--text-color); margin-bottom: 4px;">
                                            <%= m.title %>
                                        </div>
                                        <div style="display: flex; gap: 6px; align-items: center; flex-wrap: wrap;">
                                            <% if (m.is_premium) { %>
                                                <span class="badge-pill purple" style="font-size: 0.72rem;">★ Premium</span>
                                            <% } else { %>
                                                <span class="badge-pill success" style="font-size: 0.72rem;">Free Access</span>
                                            <% } %>

                                            <% if (m.candidate_subject_selection) { %>
                                                <span class="badge-pill info" style="font-size: 0.72rem;">
                                                    Candidate Choice (<%= m.required_elective_count %> electives)
                                                </span>
                                            <% } %>
                                        </div>
                                        <% if (m.description) { %>
                                            <div style="font-size: 0.78rem; color: var(--ntxt-color); margin-top: 4px; max-width: 260px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= m.description %>">
                                                <%= m.description %>
                                            </div>
                                        <% } %>
                                    </td>

                                    <td>
                                        <span class="badge-pill info" style="font-weight: 700; font-size: 0.85rem;">
                                            <%= m.exam_code || m.exam_name %>
                                        </span>
                                        <% if (m.exam_code && m.exam_name && m.exam_code !== m.exam_name) { %>
                                            <div style="font-size: 0.76rem; color: var(--ntxt-color); margin-top: 3px;">
                                                <%= m.exam_name %>
                                            </div>
                                        <% } %>
                                    </td>

                                    <td>
                                        <div style="font-weight: 600; color: var(--text-color); font-size: 0.88rem; display: flex; align-items: center; gap: 6px;">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
                                            <span><%= m.time_limit_minutes %> mins</span>
                                        </div>
                                    </td>

                                    <td>
                                        <div style="font-weight: 600; color: var(--text-color); font-size: 0.88rem;">
                                            <%= m.subject_count || (m.subjects ? m.subjects.length : 0) %> Subjects &bull; <%= m.total_questions || 0 %> Qs
                                        </div>
                                        <% if (m.subjects && m.subjects.length > 0) { %>
                                            <button type="button" class="copy-pill" onclick='openBlueprintModal(<%- JSON.stringify(m) %>)' style="margin-top: 5px; font-size: 0.74rem;">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                                                <span>View Blueprint</span>
                                            </button>
                                        <% } %>
                                    </td>

                                    <td>
                                        <% if (m.status === 'PUBLISHED') { %>
                                            <span class="badge-pill success">Published</span>
                                        <% } else { %>
                                            <span class="badge-pill warning">In Draft</span>
                                        <% } %>
                                    </td>

                                    <td style="text-align: right;">
                                        <div style="display: inline-flex; align-items: center; gap: 6px;">
                                            <!-- Status Toggle -->
                                            <form action="/admin/cbt/mocks/status" method="POST" style="margin: 0;">
                                                <input type="hidden" name="mock_id" value="<%= m.id %>">
                                                <input type="hidden" name="status" value="<%= m.status === 'PUBLISHED' ? 'DRAFT' : 'PUBLISHED' %>">
                                                <% if (m.status === 'PUBLISHED') { %>
                                                    <button type="submit" class="btn btn-outline" style="padding: 5px 9px; font-size: 0.78rem; border-radius: 6px; display: inline-flex; align-items: center; gap: 4px;" title="Unpublish this mock">
                                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
                                                        <span>Pause</span>
                                                    </button>
                                                <% } else { %>
                                                    <button type="submit" class="btn btn-ai" style="padding: 5px 9px; font-size: 0.78rem; border-radius: 6px; display: inline-flex; align-items: center; gap: 4px;" title="Publish live">
                                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                                                        <span>Publish</span>
                                                    </button>
                                                <% } %>
                                            </form>

                                            <!-- Delete Mock -->
                                            <form action="/admin/cbt/mocks/delete" method="POST" style="margin: 0;" onsubmit="return confirm('Are you sure you want to delete this mock examination blueprint? This action cannot be undone.');">
                                                <input type="hidden" name="mock_id" value="<%= m.id %>">
                                                <button type="submit" class="btn btn-outline" style="padding: 5px 8px; font-size: 0.78rem; border-radius: 6px; color: #ef4444; border-color: rgba(239, 68, 68, 0.3);" title="Delete Blueprint">
                                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <!-- Modal for Blueprint Details -->
    <div id="blueprintModal" class="modal-backdrop" style="display: none;">
        <div class="modal-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--border-color);">
                <div>
                    <h3 id="modalMockTitle" style="margin: 0; color: var(--text-color); font-size: 1.2rem; font-weight: 700;">Mock Blueprint Details</h3>
                    <div id="modalMockExam" style="font-size: 0.85rem; color: var(--ntxt-color); margin-top: 3px;">Target Exam</div>
                </div>
                <button type="button" onclick="closeBlueprintModal()" class="modal-close-btn" aria-label="Close dialog">&times;</button>
            </div>

            <div id="modalMockMeta" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 20px; background: var(--bg-color); padding: 14px; border-radius: 8px; border: 1px solid var(--border-color);">
                <div>
                    <span style="font-size: 0.75rem; text-transform: uppercase; color: var(--ntxt-color); display: block; font-weight: 700;">Duration</span>
                    <strong id="modalDuration" style="color: var(--text-color); font-size: 0.95rem;">--</strong>
                </div>
                <div>
                    <span style="font-size: 0.75rem; text-transform: uppercase; color: var(--ntxt-color); display: block; font-weight: 700;">Access Tier</span>
                    <strong id="modalAccess" style="color: var(--text-color); font-size: 0.95rem;">--</strong>
                </div>
                <div>
                    <span style="font-size: 0.75rem; text-transform: uppercase; color: var(--ntxt-color); display: block; font-weight: 700;">Status</span>
                    <strong id="modalStatus" style="color: var(--text-color); font-size: 0.95rem;">--</strong>
                </div>
            </div>

            <h4 style="margin-bottom: 8px; color: var(--text-color); font-size: 0.92rem; font-weight: 600;">Subject Question Allocation</h4>
            <div class="table-responsive">
                <table class="blueprint-table">
                    <thead>
                        <tr>
                            <th>Subject</th>
                            <th>Questions</th>
                            <th>Requirement</th>
                        </tr>
                    </thead>
                    <tbody id="modalSubjectsBody">
                    </tbody>
                </table>
            </div>

            <div style="display: flex; justify-content: flex-end; margin-top: 20px; padding-top: 14px; border-top: 1px solid var(--border-color);">
                <button type="button" class="btn btn-outline" onclick="closeBlueprintModal()" style="padding: 8px 18px; border-radius: 6px;">Close</button>
            </div>
        </div>
    </div>

    <script>
        function filterMocksTable() {
            const query = document.getElementById('mockSearchInput').value.toLowerCase().trim();
            const statusFilter = document.getElementById('mockStatusFilter').value;
            const rows = document.querySelectorAll('.mock-row');
            let visible = 0;

            rows.forEach(r => {
                const title = r.getAttribute('data-title');
                const exam = r.getAttribute('data-exam');
                const status = r.getAttribute('data-status');

                const matchesQuery = !query || title.includes(query) || exam.includes(query);
                const matchesStatus = (statusFilter === 'all') || status === statusFilter;

                if (matchesQuery && matchesStatus) {
                    r.style.display = '';
                    visible++;
                } else {
                    r.style.display = 'none';
                }
            });

            document.getElementById('mockVisibleCount').innerText = visible;
        }

        function openBlueprintModal(mock) {
            document.getElementById('modalMockTitle').innerText = mock.title || 'Mock Blueprint';
            document.getElementById('modalMockExam').innerText = (mock.exam_name || '') + (mock.exam_code ? ` (${mock.exam_code})` : '');
            document.getElementById('modalDuration').innerText = (mock.time_limit_minutes || '--') + ' mins';
            document.getElementById('modalAccess').innerText = mock.is_premium ? '★ Premium' : 'Free Access';
            document.getElementById('modalStatus').innerText = mock.status || 'DRAFT';

            const tbody = document.getElementById('modalSubjectsBody');
            tbody.innerHTML = '';

            if (mock.subjects && mock.subjects.length > 0) {
                mock.subjects.forEach(s => {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td><strong>${s.subject_name || 'Subject #' + s.subject_id}</strong></td>
                        <td>${s.question_count || 0} questions</td>
                        <td>
                            <span class="badge-pill ${s.is_compulsory ? 'info' : 'gray'}" style="font-size: 0.72rem;">
                                ${s.is_compulsory ? 'Compulsory' : 'Elective'}
                            </span>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            } else {
                tbody.innerHTML = '<tr><td colspan="3" style="text-align: center; color: var(--ntxt-color);">No specific subject allocations defined.</td></tr>';
            }

            document.getElementById('blueprintModal').style.display = 'flex';
        }

        function closeBlueprintModal() {
            document.getElementById('blueprintModal').style.display = 'none';
        }

        window.onclick = function(e) {
            const modal = document.getElementById('blueprintModal');
            if (e.target === modal) {
                closeBlueprintModal();
            }
        };
    </script>
</body>
</html>
