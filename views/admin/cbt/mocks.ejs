<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Mock Examination Blueprints - CBT Admin</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <style>
        .kpi-grid { 
            display: grid; 
            grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); 
            gap: 16px; 
            margin-bottom: 24px; 
        }
        .kpi-card { 
            background: var(--card-bg); 
            padding: 20px 22px; 
            border-radius: 12px; 
            border: 1px solid var(--border-color); 
            box-shadow: 0 4px 15px rgba(0,0,0,0.05); 
            display: flex; 
            flex-direction: column; 
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .kpi-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.08);
        }
        .kpi-title { 
            font-size: 0.78rem; 
            color: var(--ntxt-color); 
            text-transform: uppercase; 
            font-weight: 700; 
            letter-spacing: 0.6px; 
            margin-bottom: 8px; 
        }
        .kpi-value { 
            font-size: 2.1rem; 
            font-weight: 800; 
            color: var(--text-color); 
            line-height: 1.1; 
            margin-bottom: 6px; 
        }
        .kpi-subtitle {
            font-size: 0.82rem;
            color: var(--ntxt-color);
        }

        .panel { 
            background: var(--card-bg); 
            border-radius: 12px; 
            border: 1px solid var(--border-color); 
            box-shadow: 0 4px 20px rgba(0,0,0,0.06); 
            overflow: hidden; 
        }
        .panel-header {
            padding: 18px 24px; 
            border-bottom: 1px solid var(--border-color); 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            flex-wrap: wrap; 
            gap: 12px;
            background: rgba(255, 255, 255, 0.015);
        }

        .table-responsive {
            width: 100%;
            overflow-x: auto;
        }

        .data-table { 
            width: 100%; 
            border-collapse: collapse; 
            text-align: left;
        }
        .data-table th { 
            padding: 14px 20px; 
            background: rgba(0, 0, 0, 0.12); 
            color: var(--ntxt-color); 
            font-size: 0.78rem; 
            text-transform: uppercase; 
            letter-spacing: 0.6px; 
            font-weight: 700;
            border-bottom: 1px solid var(--border-color);
            white-space: nowrap;
        }
        .data-table td { 
            padding: 16px 20px; 
            border-bottom: 1px solid var(--border-color); 
            color: var(--text-color); 
            font-size: 0.92rem;
            vertical-align: middle;
        }
        .data-table tr:hover td { 
            background: rgba(255, 255, 255, 0.02); 
        }
        .data-table tr:last-child td {
            border-bottom: none;
        }

        .badge-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 9px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            line-height: 1.3;
        }
        .badge-premium {
            background: rgba(168, 85, 247, 0.15);
            color: #c084fc;
            border: 1px solid rgba(168, 85, 247, 0.3);
        }
        .badge-free {
            background: rgba(148, 163, 184, 0.12);
            color: var(--ntxt-color);
            border: 1px solid rgba(148, 163, 184, 0.25);
        }
        .badge-status-published {
            background: rgba(16, 185, 129, 0.12);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.3);
            font-weight: 700;
        }
        .badge-status-draft {
            background: rgba(245, 158, 11, 0.12);
            color: #f59e0b;
            border: 1px solid rgba(245, 158, 11, 0.3);
            font-weight: 700;
        }
        .status-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            display: inline-block;
        }

        .btn-action-outline {
            padding: 6px 14px;
            border-radius: 6px;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
            border: 1px solid;
            background: transparent;
        }
        .btn-unpublish {
            border-color: rgba(245, 158, 11, 0.4);
            color: #f59e0b;
            background: rgba(245, 158, 11, 0.08);
        }
        .btn-unpublish:hover {
            background: #f59e0b;
            color: #0f172a;
        }
        .btn-publish {
            border-color: rgba(16, 185, 129, 0.4);
            color: #10b981;
            background: rgba(16, 185, 129, 0.08);
        }
        .btn-publish:hover {
            background: #10b981;
            color: #ffffff;
        }
        .btn-delete-row {
            border-color: rgba(239, 68, 68, 0.4);
            color: #ef4444;
            background: rgba(239, 68, 68, 0.08);
            padding: 6px 10px;
        }
        .btn-delete-row:hover {
            background: #ef4444;
            color: #ffffff;
        }

        .empty-state-box {
            padding: 60px 20px;
            text-align: center;
        }
        .empty-state-icon {
            font-size: 3rem;
            margin-bottom: 16px;
            opacity: 0.7;
        }

        /* Subject Blueprint pills inside modal */
        .blueprint-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 12px;
        }
        .blueprint-table th {
            padding: 10px 14px;
            text-align: left;
            font-size: 0.75rem;
            text-transform: uppercase;
            color: var(--ntxt-color);
            border-bottom: 1px solid var(--border-color);
            background: rgba(0,0,0,0.1);
        }
        .blueprint-table td {
            padding: 12px 14px;
            border-bottom: 1px solid var(--border-color);
            color: var(--text-color);
            font-size: 0.9rem;
        }
    </style>
</head>
<body class="dashboard-body admin-body">
    <%- include('./partials/sidebar', { active_page: 'cbt_mocks' }) %>

    <main class="main-content">
        <!-- Page Header -->
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; flex-wrap: wrap; gap: 16px; padding-top: 10px;">
            <div>
                <h1 style="color: var(--text-color); font-size: 1.85rem; font-weight: 800; letter-spacing: -0.5px; margin-bottom: 6px;">Mock Examination Blueprints</h1>
                <p style="color: var(--ntxt-color); font-size: 0.95rem; margin: 0;">Configure, publish, and manage multi-subject simulated CBT mock examinations.</p>
            </div>
            <a href="/admin/cbt/mocks/create" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 8px; padding: 12px 22px; font-weight: 600; font-size: 0.95rem; border-radius: 8px; box-shadow: 0 4px 15px rgba(59, 130, 246, 0.35); text-decoration: none;">
                <span style="font-size: 1.1rem; line-height: 1;">+</span>
                <span>Create New Mock</span>
            </a>
        </div>

        <!-- Metric KPI Cards -->
        <div class="kpi-grid">
            <div class="kpi-card">
                <div class="kpi-title">Total Blueprints</div>
                <div class="kpi-value"><%= stats ? stats.total : mocks.length %></div>
                <div class="kpi-subtitle">Configured examinations</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-title">Published Live</div>
                <div class="kpi-value" style="color: #10b981;"><%= stats ? stats.published : mocks.filter(m => m.status === 'PUBLISHED').length %></div>
                <div class="kpi-subtitle" style="color: #10b981; font-weight: 500;">Active for students</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-title">In Draft</div>
                <div class="kpi-value" style="color: #f59e0b;"><%= stats ? stats.draft : mocks.filter(m => m.status === 'DRAFT').length %></div>
                <div class="kpi-subtitle" style="color: #f59e0b; font-weight: 500;">Unpublished sessions</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-title">Total Questions</div>
                <div class="kpi-value" style="color: #3b82f6;"><%= stats ? stats.total_questions : mocks.reduce((a, m) => a + (parseInt(m.total_questions) || 0), 0) %></div>
                <div class="kpi-subtitle">Across all blueprint subjects</div>
            </div>
        </div>

        <!-- Main Data Table Panel -->
        <div class="panel">
            <div class="panel-header">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <h3 style="margin: 0; color: var(--text-color); font-size: 1.15rem; font-weight: 700;">Mock Examinations Registry</h3>
                    <span style="background: rgba(255,255,255,0.06); color: var(--ntxt-color); padding: 3px 10px; border-radius: 12px; font-size: 0.78rem; font-weight: 600;">
                        <%= mocks.length %> <%= mocks.length === 1 ? 'Exam' : 'Exams' %>
                    </span>
                </div>
            </div>

            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th style="min-width: 220px;">Mock Title & Access</th>
                            <th style="min-width: 140px;">Target Exam</th>
                            <th style="min-width: 120px;">Duration</th>
                            <th style="min-width: 190px;">Blueprint Structure</th>
                            <th style="min-width: 130px;">Status</th>
                            <th style="min-width: 180px; text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!mocks || mocks.length === 0) { %>
                            <tr>
                                <td colspan="6">
                                    <div class="empty-state-box">
                                        <div class="empty-state-icon">📋</div>
                                        <h3 style="color: var(--text-color); font-size: 1.25rem; font-weight: 700; margin-bottom: 8px;">No Mock Examinations Created Yet</h3>
                                        <p style="color: var(--ntxt-color); font-size: 0.95rem; max-width: 480px; margin: 0 auto 20px auto;">
                                            Design your first CBT mock blueprint by setting subject question counts, duration, and candidate elective rules.
                                        </p>
                                        <a href="/admin/cbt/mocks/create" class="btn btn-primary" style="padding: 10px 22px; font-weight: 600;">+ Create Your First Mock</a>
                                    </div>
                                </td>
                            </tr>
                        <% } else { %>
                            <% mocks.forEach(m => { %>
                                <tr>
                                    <!-- Title & Access -->
                                    <td>
                                        <div style="font-weight: 700; font-size: 1.02rem; color: var(--text-color); margin-bottom: 5px;">
                                            <%= m.title %>
                                        </div>
                                        <div style="display: flex; gap: 6px; align-items: center; flex-wrap: wrap;">
                                            <% if (m.is_premium) { %>
                                                <span class="badge-pill badge-premium">★ Premium</span>
                                            <% } else { %>
                                                <span class="badge-pill badge-free">Free Access</span>
                                            <% } %>

                                            <% if (m.candidate_subject_selection) { %>
                                                <span class="badge-pill" style="background: rgba(59, 130, 246, 0.12); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3);">
                                                    Candidate Selection (<%= m.required_elective_count %> electives)
                                                </span>
                                            <% } %>
                                        </div>
                                        <% if (m.description) { %>
                                            <div style="font-size: 0.8rem; color: var(--ntxt-color); margin-top: 5px; max-width: 280px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= m.description %>">
                                                <%= m.description %>
                                            </div>
                                        <% } %>
                                    </td>

                                    <!-- Target Exam -->
                                    <td>
                                        <span class="badge-pill" style="background: rgba(59, 130, 246, 0.12); color: #3b82f6; border: 1px solid rgba(59, 130, 246, 0.28); font-weight: 700; font-size: 0.85rem; padding: 4px 10px;">
                                            <%= m.exam_code || m.exam_name %>
                                        </span>
                                        <% if (m.exam_code && m.exam_name && m.exam_code !== m.exam_name) { %>
                                            <div style="font-size: 0.78rem; color: var(--ntxt-color); margin-top: 3px;">
                                                <%= m.exam_name %>
                                            </div>
                                        <% } %>
                                    </td>

                                    <!-- Duration -->
                                    <td>
                                        <div style="font-weight: 600; color: var(--text-color); font-size: 0.95rem; display: flex; align-items: center; gap: 6px;">
                                            <span style="opacity: 0.7;">⏱</span>
                                            <span><%= m.time_limit_minutes %> mins</span>
                                        </div>
                                    </td>

                                    <!-- Blueprint Structure -->
                                    <td>
                                        <div style="font-weight: 600; color: var(--text-color); font-size: 0.93rem;">
                                            <%= m.subject_count || (m.subjects ? m.subjects.length : 0) %> Subject<%= (m.subject_count == 1 || (m.subjects && m.subjects.length === 1)) ? '' : 's' %> • <%= m.total_questions || 0 %> Qs
                                        </div>
                                        <% if (m.subjects && m.subjects.length > 0) { %>
                                            <button type="button" class="btn-action-outline" onclick='openBlueprintModal(<%- JSON.stringify(m) %>)' style="margin-top: 6px; padding: 3px 8px; font-size: 0.75rem; border-color: var(--border-color); color: var(--ntxt-color);">
                                                <span>🔍 View Blueprint</span>
                                            </button>
                                        <% } %>
                                    </td>

                                    <!-- Status Badge -->
                                    <td>
                                        <% if (m.status === 'PUBLISHED') { %>
                                            <span class="badge-pill badge-status-published">
                                                <span class="status-dot" style="background: #10b981;"></span>
                                                PUBLISHED
                                            </span>
                                        <% } else { %>
                                            <span class="badge-pill badge-status-draft">
                                                <span class="status-dot" style="background: #f59e0b;"></span>
                                                DRAFT
                                            </span>
                                        <% } %>
                                    </td>

                                    <!-- Actions -->
                                    <td style="text-align: right; white-space: nowrap;">
                                        <div style="display: inline-flex; align-items: center; gap: 8px;">
                                            <!-- Status Toggle -->
                                            <form action="/admin/cbt/mocks/status" method="POST" style="margin: 0;">
                                                <input type="hidden" name="mock_id" value="<%= m.id %>">
                                                <input type="hidden" name="status" value="<%= m.status === 'PUBLISHED' ? 'DRAFT' : 'PUBLISHED' %>">
                                                <% if (m.status === 'PUBLISHED') { %>
                                                    <button type="submit" class="btn-action-outline btn-unpublish" title="Unpublish this mock (hide from students)">
                                                        <span>⏸</span>
                                                        <span>Unpublish</span>
                                                    </button>
                                                <% } else { %>
                                                    <button type="submit" class="btn-action-outline btn-publish" title="Publish live for students">
                                                        <span>🚀</span>
                                                        <span>Publish</span>
                                                    </button>
                                                <% } %>
                                            </form>

                                            <!-- Delete Mock -->
                                            <form action="/admin/cbt/mocks/delete" method="POST" style="margin: 0;" onsubmit="return confirm('Are you sure you want to delete this mock examination blueprint? This action cannot be undone.');">
                                                <input type="hidden" name="mock_id" value="<%= m.id %>">
                                                <button type="submit" class="btn-action-outline btn-delete-row" title="Delete Blueprint">
                                                    <span>🗑️</span>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <!-- Modal for Blueprint Details -->
    <div id="blueprintModal" class="modal-backdrop" style="display: none;">
        <div class="modal-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--border-color);">
                <div>
                    <h3 id="modalMockTitle" style="margin: 0; color: var(--text-color); font-size: 1.25rem; font-weight: 700;">Mock Blueprint Details</h3>
                    <div id="modalMockExam" style="font-size: 0.85rem; color: var(--ntxt-color); margin-top: 3px;">Target Exam</div>
                </div>
                <button type="button" onclick="closeBlueprintModal()" class="modal-close-btn" aria-label="Close dialog">&times;</button>
            </div>

            <div id="modalMockMeta" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 20px; background: rgba(0,0,0,0.15); padding: 14px; border-radius: 8px; border: 1px solid var(--border-color);">
                <div>
                    <span style="font-size: 0.75rem; text-transform: uppercase; color: var(--ntxt-color); display: block; font-weight: 700;">Duration</span>
                    <strong id="modalDuration" style="color: var(--text-color); font-size: 0.95rem;">--</strong>
                </div>
                <div>
                    <span style="font-size: 0.75rem; text-transform: uppercase; color: var(--ntxt-color); display: block; font-weight: 700;">Access</span>
                    <strong id="modalAccess" style="color: var(--text-color); font-size: 0.95rem;">--</strong>
                </div>
                <div>
                    <span style="font-size: 0.75rem; text-transform: uppercase; color: var(--ntxt-color); display: block; font-weight: 700;">Status</span>
                    <strong id="modalStatus" style="color: var(--text-color); font-size: 0.95rem;">--</strong>
                </div>
            </div>

            <h4 style="margin-bottom: 8px; color: var(--text-color); font-size: 0.95rem;">Included Subjects & Question Allocation</h4>
            <div class="table-responsive">
                <table class="blueprint-table">
                    <thead>
                        <tr>
                            <th>Subject</th>
                            <th>Questions</th>
                            <th>Requirement</th>
                        </tr>
                    </thead>
                    <tbody id="modalSubjectsBody">
                    </tbody>
                </table>
            </div>

            <div style="display: flex; justify-content: flex-end; margin-top: 24px; padding-top: 14px; border-top: 1px solid var(--border-color);">
                <button type="button" class="btn btn-secondary" onclick="closeBlueprintModal()" style="padding: 8px 20px;">Close</button>
            </div>
        </div>
    </div>

    <script>
        function openBlueprintModal(mock) {
            document.getElementById('modalMockTitle').innerText = mock.title;
            document.getElementById('modalMockExam').innerText = 'Target Exam: ' + (mock.exam_code || mock.exam_name);
            document.getElementById('modalDuration').innerText = mock.time_limit_minutes + ' minutes';
            document.getElementById('modalAccess').innerText = mock.is_premium ? '★ Premium' : 'Free Access';
            document.getElementById('modalStatus').innerText = mock.status;

            const tbody = document.getElementById('modalSubjectsBody');
            tbody.innerHTML = '';

            if (mock.subjects && mock.subjects.length > 0) {
                mock.subjects.forEach(s => {
                    const tr = document.createElement('tr');
                    const reqBadge = s.is_compulsory 
                        ? '<span class="badge-pill" style="background: rgba(239, 68, 68, 0.12); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3);">Compulsory</span>'
                        : '<span class="badge-pill" style="background: rgba(59, 130, 246, 0.12); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3);">Elective</span>';

                    tr.innerHTML = `
                        <td><strong>${s.subject_name || ('Subject #' + s.subject_id)}</strong></td>
                        <td>${s.question_count} questions</td>
                        <td>${reqBadge}</td>
                    `;
                    tbody.appendChild(tr);
                });
            } else {
                tbody.innerHTML = '<tr><td colspan="3" style="text-align: center; color: var(--ntxt-color); padding: 15px;">No subjects configured in this blueprint.</td></tr>';
            }

            document.getElementById('blueprintModal').style.display = 'flex';
        }

        function closeBlueprintModal() {
            document.getElementById('blueprintModal').style.display = 'none';
        }

        window.addEventListener('click', function(e) {
            const modal = document.getElementById('blueprintModal');
            if (e.target === modal) {
                closeBlueprintModal();
            }
        });

        window.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeBlueprintModal();
            }
        });
    </script>
</body>
</html>
