<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta charset="UTF-8">
    <title>Examinations Registry - CBT Admin</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <link rel="manifest" href="/manifest.json">
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').catch(err => console.log('SW setup failed: ', err));
            });
        }
    </script>
    <link rel="icon" media="(prefers-color-scheme: light)" href="/acct/img/favicon-dark.png">
    <link rel="icon" media="(prefers-color-scheme: dark)" href="/acct/img/favicon-light.png">
    <style>
        .exams-layout-grid {
            display: grid;
            grid-template-columns: 0.95fr 1.05fr;
            gap: 24px;
            align-items: start;
        }
        @media (max-width: 1024px) {
            .exams-layout-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body class="dashboard-body admin-body">
    <%- include('./partials/sidebar', { active_page: 'cbt_exams' }) %>

    <main class="admin-main-content">
        <!-- Executive Topbar -->
        <header class="admin-topbar">
            <div style="display: flex; align-items: center; gap: 14px;">
                <button class="admin-mobile-toggle" onclick="toggleAdminNav()" aria-label="Toggle Navigation">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                </button>
                <div>
                    <h1 class="admin-title">Examinations Registry</h1>
                    <p class="admin-subtitle">Manage national and professional examinations (e.g. UTME, SSCE, WASSCE, NABTEB) and configure default parameters.</p>
                </div>
            </div>
            <div class="admin-topbar-actions">
                <a href="/admin/cbt" class="btn btn-outline" style="border-radius: 8px; font-weight: 600; font-size: 0.85rem; padding: 8px 14px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                    &larr; CBT Hub
                </a>
                <a href="/admin" class="btn btn-outline" style="border-radius: 8px; font-weight: 600; font-size: 0.85rem; padding: 8px 14px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                    Overview
                </a>
            </div>
        </header>

        <%
            const examCount = (locals.exams && exams.length) ? exams.length : 0;
            const bodyCount = (locals.bodies && bodies.length) ? bodies.length : 0;
        %>

        <!-- KPI Metrics Grid -->
        <div class="kpi-grid">
            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Registered Exams</div>
                        <div class="kpi-value"><%= examCount %></div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(59, 130, 246, 0.12); color: #3b82f6;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #3b82f6; font-weight: 600;">Standard Series</span>
                    <span>&bull; UTME / SSCE</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Exam Bodies</div>
                        <div class="kpi-value"><%= bodyCount %></div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(16, 185, 129, 0.12); color: #10b981;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11M20 10v11M8 14v4M12 14v4M16 14v4"></path></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #10b981; font-weight: 600;">Governing Boards</span>
                    <span>&bull; Accredited</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Timing Engine</div>
                        <div class="kpi-value" style="font-size: 1.45rem;">Configurable</div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(139, 92, 246, 0.12); color: #8b5cf6;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #8b5cf6; font-weight: 600;">Timed Assessments</span>
                    <span>&bull; Strict auto-submit</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Platform Status</div>
                        <div class="kpi-value" style="font-size: 1.45rem;">100% Operational</div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(245, 158, 11, 0.12); color: #f59e0b;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #f59e0b; font-weight: 600;">CBT Simulation</span>
                    <span>&bull; High availability</span>
                </div>
            </div>
        </div>

        <% if (locals.error) { %>
            <div class="alert alert-error" style="border-radius: 10px; margin-bottom: 24px; display: flex; align-items: center; gap: 12px; padding: 14px 18px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                <span><%= error %></span>
            </div>
        <% } %>

        <!-- Two-Column Workspace -->
        <div class="exams-layout-grid">
            <!-- Left Column: Add Exam Form -->
            <div class="admin-panel">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px;">
                    <div>
                        <h2 style="font-size: 1.15rem; font-weight: 700; margin: 0; color: var(--text-color);">Add New Examination</h2>
                        <p style="font-size: 0.85rem; color: var(--ntxt-color); margin: 4px 0 0 0;">Register an examination series under an accredited authority.</p>
                    </div>
                    <span class="badge-pill info">Exam Series</span>
                </div>

                <form method="POST" action="/admin/cbt/exams">
                    <div class="form-group" style="margin-bottom: 14px;">
                        <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 6px;">Governing Exam Body</label>
                        <select name="exam_body_id" class="admin-select" style="width: 100%; box-sizing: border-box;" required>
                            <option value="">Select Exam Body</option>
                            <% bodies.forEach(b => { %>
                                <option value="<%= b.id %>" <%= selected_body == b.id ? 'selected' : '' %>><%= b.code %> &ndash; <%= b.name %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 12px; margin-bottom: 14px;">
                        <div class="form-group">
                            <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 6px;">Official Exam Name</label>
                            <input type="text" name="name" placeholder="e.g. Senior School Certificate Exam" class="admin-select" style="width: 100%; box-sizing: border-box;" required>
                        </div>
                        <div class="form-group">
                            <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 6px;">Code</label>
                            <input type="text" name="code" placeholder="e.g. SSCE" class="admin-select" style="width: 100%; box-sizing: border-box; text-transform: uppercase;" required>
                        </div>
                    </div>

                    <div class="form-group" style="margin-bottom: 14px;">
                        <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 6px;">Default Duration (Minutes)</label>
                        <input type="number" name="duration" placeholder="e.g. 120" class="admin-select" style="width: 100%; box-sizing: border-box;">
                    </div>

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 6px;">Description (Optional)</label>
                        <textarea name="description" rows="2" placeholder="Syllabus scope, eligibility, and format..." class="admin-select" style="width: 100%; box-sizing: border-box; resize: vertical;"></textarea>
                    </div>

                    <button type="submit" class="btn btn-ai" style="width: 100%; padding: 12px; font-weight: 600; display: inline-flex; justify-content: center; align-items: center; gap: 8px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        <span>Create Examination</span>
                    </button>
                </form>
            </div>

            <!-- Right Column: Exams Table -->
            <div class="admin-panel">
                <div class="admin-filter-bar">
                    <div class="admin-search-box">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        <input type="text" id="examSearchInput" placeholder="Search exam name, code, or body..." onkeyup="filterExamsTable()">
                    </div>

                    <div class="admin-filter-group">
                        <select id="examBodyFilter" class="admin-select" onchange="filterExamsTable()">
                            <option value="all">All Bodies</option>
                            <% bodies.forEach(b => { %>
                                <option value="<%= b.code.toLowerCase() %>" <%= selected_body == b.id ? 'selected' : '' %>><%= b.code %></option>
                            <% }) %>
                        </select>

                        <span style="font-size: 0.85rem; color: var(--ntxt-color); padding-left: 6px;">
                            Showing <strong id="examVisibleCount" style="color: var(--text-color);"><%= examCount %></strong> of <%= examCount %>
                        </span>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="data-table" id="examsTable">
                        <thead>
                            <tr>
                                <th>Exam & Code</th>
                                <th>Governing Body</th>
                                <th>Duration</th>
                                <th style="text-align: right; min-width: 140px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (exams && exams.length > 0) { %>
                                <% exams.forEach(exam => { %>
                                    <tr class="exam-row" data-name="<%= (exam.name || '').toLowerCase() %>" data-code="<%= (exam.code || '').toLowerCase() %>" data-body="<%= (exam.body_name || exam.body_code || '').toLowerCase() %>">
                                        <td>
                                            <div style="font-weight: 700; color: var(--text-color); font-size: 0.92rem;"><%= exam.name %></div>
                                            <span class="badge-pill info" style="font-family: monospace; font-size: 0.74rem; font-weight: 700; margin-top: 3px;"><%= exam.code %></span>
                                        </td>
                                        <td>
                                            <span class="badge-pill gray"><%= exam.body_name %></span>
                                        </td>
                                        <td>
                                            <div style="font-size: 0.85rem; color: var(--ntxt-color); display: flex; align-items: center; gap: 4px;">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
                                                <span><%= exam.duration ? exam.duration + 'm' : 'Untimed' %></span>
                                            </div>
                                        </td>
                                        <td style="text-align: right;">
                                            <div style="display: inline-flex; align-items: center; gap: 6px;">
                                                <button type="button" class="btn btn-outline" onclick='openEditModal(<%- JSON.stringify(exam) %>)' style="padding: 5px 9px; font-size: 0.78rem; border-radius: 6px;">
                                                    Edit
                                                </button>
                                                <a href="/admin/cbt/subjects?exam_id=<%= exam.id %>" class="btn btn-outline" style="padding: 5px 9px; font-size: 0.78rem; border-radius: 6px; text-decoration: none;">
                                                    Subjects &rarr;
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4" style="text-align: center; padding: 3.5rem 1rem; color: var(--ntxt-color);">
                                        No examinations registered yet.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <!-- Modal for Editing Examination -->
    <div id="editExamModal" class="modal-backdrop" style="display: none;">
        <div class="modal-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid var(--border-color);">
                <div>
                    <h3 id="modalExamTitle" style="margin: 0; color: var(--text-color); font-size: 1.2rem; font-weight: 700;">Edit Examination</h3>
                    <div style="font-size: 0.8rem; color: var(--ntxt-color); margin-top: 3px;">Update examination settings and parameters</div>
                </div>
                <button type="button" onclick="closeEditModal()" class="modal-close-btn" aria-label="Close dialog">&times;</button>
            </div>
            
            <form id="editExamForm" method="POST" action="">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;">
                    <div class="form-group">
                        <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 6px;">Exam Body</label>
                        <select name="exam_body_id" id="edit_exam_body_id" class="admin-select" style="width: 100%; box-sizing: border-box;" required>
                            <% bodies.forEach(b => { %>
                                <option value="<%= b.id %>"><%= b.code %> &ndash; <%= b.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 6px;">Status</label>
                        <select name="status" id="edit_status" class="admin-select" style="width: 100%; box-sizing: border-box;">
                            <option value="ACTIVE">ACTIVE</option>
                            <option value="INACTIVE">INACTIVE</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 6px;">Exam Name</label>
                        <input type="text" name="name" id="edit_name" class="admin-select" style="width: 100%; box-sizing: border-box;" required>
                    </div>
                    <div class="form-group">
                        <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 6px;">Exam Code</label>
                        <input type="text" name="code" id="edit_code" class="admin-select" style="width: 100%; box-sizing: border-box;" required>
                    </div>
                    <div class="form-group" style="grid-column: 1 / -1;">
                        <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 6px;">Default Duration (Minutes)</label>
                        <input type="number" name="duration" id="edit_duration" class="admin-select" style="width: 100%; box-sizing: border-box;">
                    </div>
                    <div class="form-group" style="grid-column: 1 / -1;">
                        <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 6px;">Description</label>
                        <textarea name="description" id="edit_description" class="admin-select" rows="3" style="width: 100%; box-sizing: border-box; resize: vertical;"></textarea>
                    </div>
                </div>

                <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 20px; padding-top: 14px; border-top: 1px solid var(--border-color);">
                    <button type="button" class="btn btn-outline" onclick="closeEditModal()" style="padding: 8px 18px; border-radius: 6px;">Cancel</button>
                    <button type="submit" class="btn btn-ai" style="padding: 8px 22px; border-radius: 6px;">Save Changes</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function filterExamsTable() {
            const query = document.getElementById('examSearchInput').value.toLowerCase().trim();
            const bodyFilter = document.getElementById('examBodyFilter').value;
            const rows = document.querySelectorAll('.exam-row');
            let visible = 0;

            rows.forEach(r => {
                const name = r.getAttribute('data-name');
                const code = r.getAttribute('data-code');
                const body = r.getAttribute('data-body');

                const matchesQuery = !query || name.includes(query) || code.includes(query) || body.includes(query);
                const matchesBody = (bodyFilter === 'all') || body.includes(bodyFilter);

                if (matchesQuery && matchesBody) {
                    r.style.display = '';
                    visible++;
                } else {
                    r.style.display = 'none';
                }
            });

            document.getElementById('examVisibleCount').innerText = visible;
        }

        function openEditModal(exam) {
            document.getElementById('editExamForm').action = '/admin/cbt/exams/' + exam.id + '/edit';
            document.getElementById('modalExamTitle').innerText = 'Edit Examination: ' + exam.code;
            document.getElementById('edit_exam_body_id').value = exam.exam_body_id;
            document.getElementById('edit_status').value = exam.status || 'ACTIVE';
            document.getElementById('edit_name').value = exam.name || '';
            document.getElementById('edit_code').value = exam.code || '';
            document.getElementById('edit_duration').value = exam.duration || '';
            document.getElementById('edit_description').value = exam.description || '';
            document.getElementById('editExamModal').style.display = 'flex';
        }

        function closeEditModal() {
            document.getElementById('editExamModal').style.display = 'none';
        }

        window.onclick = function(e) {
            const modal = document.getElementById('editExamModal');
            if (e.target === modal) {
                closeEditModal();
            }
        };
    </script>
</body>
</html>
