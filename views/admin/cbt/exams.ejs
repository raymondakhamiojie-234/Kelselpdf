<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CBT Admin - exams</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
</head>
<body class="dashboard-body">
    <%- include('./partials/sidebar', { active_page: 'cbt_exams' }) %>
    <main class="main-content">
            <h2 style="margin-bottom: 1rem;">Examinations</h2>
            <p style="color: var(--ntxt-color); margin-bottom: 2rem;">Manage specific examinations (e.g. UTME, WASSCE) under their respective bodies.</p>
            
            <div class="glass-panel">
                <h3>Add New Exam</h3>
                <form method="POST" action="/admin/cbt/exams" style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 1rem;">
                    <div class="form-group">
                        <label>Exam Body</label>
                        <select name="exam_body_id" class="form-control" required>
                            <option value="">Select Exam Body</option>
                            <% bodies.forEach(b => { %>
                                <option value="<%= b.id %>" <%= selected_body == b.id ? 'selected' : '' %>><%= b.code %> - <%= b.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Name (e.g., Unified Tertiary Matriculation Examination)</label>
                        <input type="text" name="name" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Code (e.g., UTME)</label>
                        <input type="text" name="code" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Default Duration (Minutes)</label>
                        <input type="number" name="duration" class="form-control">
                    </div>
                    <div class="form-group" style="grid-column: 1 / -1;">
                        <label>Description</label>
                        <textarea name="description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="form-group" style="grid-column: 1 / -1;">
                        <button type="submit" class="btn btn-primary">Create Exam</button>
                    </div>
                </form>
            </div>

            <div style="margin-bottom: 15px;">
                <form method="GET" action="/admin/cbt/exams" style="display: flex; gap: 10px;">
                    <select name="body_id" class="form-control" style="width: auto;">
                        <option value="">All Exam Bodies</option>
                        <% bodies.forEach(b => { %>
                            <option value="<%= b.id %>" <%= selected_body == b.id ? 'selected' : '' %>><%= b.code %></option>
                        <% }) %>
                    </select>
                    <button type="submit" class="btn btn-secondary">Filter</button>
                </form>
            </div>

            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Body</th>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Duration</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (exams && exams.length > 0) { %>
                        <% exams.forEach(exam => { %>
                            <tr>
                                <td><%= exam.id %></td>
                                <td><%= exam.body_name %></td>
                                <td><strong><%= exam.code %></strong></td>
                                <td><%= exam.name %></td>
                                <td><%= exam.duration ? exam.duration + ' mins' : 'N/A' %></td>
                                <td>
                                    <a href="/admin/cbt/subjects?exam_id=<%= exam.id %>" class="btn btn-sm btn-outline">View Subjects</a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" style="text-align: center;">No exams found.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
            </main>
</body>
</html>
