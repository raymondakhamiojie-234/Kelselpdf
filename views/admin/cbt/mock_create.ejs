<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Mock Examination - Admin</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <style>
        .form-container { background: var(--card-bg); padding: 20px; border-radius: 8px; border: 1px solid var(--border-color); }
        .form-group { margin-bottom: 15px; }
        .form-group label { display: block; margin-bottom: 5px; color: var(--text-color); font-weight: 500; }
        .form-control { width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 5px; background: var(--bg-color); color: var(--text-color); }
        .subject-row { display: flex; gap: 10px; align-items: center; margin-bottom: 10px; padding: 10px; background: var(--bg-color); border-radius: 5px; border: 1px solid var(--border-color); }
        .subject-row select, .subject-row input[type="number"] { padding: 8px; border-radius: 4px; border: 1px solid var(--border-color); background: var(--card-bg); color: var(--text-color); }
        .jamb-config { background: rgba(59, 130, 246, 0.05); border: 1px solid rgba(59, 130, 246, 0.2); padding: 15px; border-radius: 8px; margin-top: 20px; margin-bottom: 20px; }
    </style>
</head>
<body class="dashboard-body">
    <%- include('./partials/sidebar', { active_page: 'cbt_mocks' }) %>

    <main class="main-content">
        <%- include('../../acct/partials/app_header', { page_title: 'Create Mock Examination', page_desc: 'Design a new blueprint.' }) %>

        <div class="form-container">
            <form action="/admin/cbt/mocks/create" method="POST">
                
                <div class="form-group">
                    <label>Target Parent Exam</label>
                    <select name="exam_id" class="form-control" required>
                        <option value="">Select Exam (e.g. UTME)</option>
                        <% exams.forEach(e => { %>
                            <option value="<%= e.id %>"><%= e.name %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="form-group">
                    <label>Mock Title</label>
                    <input type="text" name="title" class="form-control" placeholder="e.g. Official 2024 JAMB Mock" required>
                </div>

                <div class="form-group">
                    <label>Description</label>
                    <textarea name="description" class="form-control" rows="3"></textarea>
                </div>

                <div class="form-group" style="display: flex; gap: 20px;">
                    <div style="flex: 1;">
                        <label>Time Limit (Minutes)</label>
                        <input type="number" name="time_limit_minutes" class="form-control" value="120" required>
                    </div>
                    <div style="flex: 1;">
                        <label>Status</label>
                        <select name="status" class="form-control">
                            <option value="DRAFT">DRAFT</option>
                            <option value="PUBLISHED">PUBLISHED</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label style="display: flex; align-items: center; gap: 10px;">
                        <input type="checkbox" name="is_premium"> 
                        <strong>Premium Only (Requires active subscription)</strong>
                    </label>
                </div>

                <div class="jamb-config">
                    <h3 style="color: var(--primary-color); margin-bottom: 10px;">Candidate Subject Selection (e.g. JAMB UTME)</h3>
                    <p style="color: var(--ntxt-color); font-size: 0.9rem; margin-bottom: 15px;">Enable this if candidates must choose their own elective subjects from the list below before starting.</p>
                    
                    <div class="form-group">
                        <label style="display: flex; align-items: center; gap: 10px;">
                            <input type="checkbox" name="candidate_subject_selection" id="candidateSelectionToggle"> 
                            <strong>Enable Candidate Selection</strong>
                        </label>
                    </div>
                    
                    <div class="form-group" id="electiveCountGroup" style="display: none;">
                        <label>Required Elective Count (How many subjects must they choose?)</label>
                        <input type="number" name="required_elective_count" class="form-control" value="3" min="1" max="10" style="width: 200px;">
                    </div>
                </div>

                <hr style="border-color: var(--border-color); margin: 20px 0;">

                <h3 style="margin-bottom: 10px; color: var(--text-color);">Subject Blueprint</h3>
                <p style="color: var(--ntxt-color); font-size: 0.9rem; margin-bottom: 15px;">Add subjects and the exact number of questions to pull. If Candidate Selection is enabled, check "Compulsory" for subjects they MUST take (like English).</p>

                <div id="subjectsContainer">
                    <div class="subject-row">
                        <select name="subjects[]" required style="flex: 2;">
                            <option value="">Select Subject</option>
                            <% subjects.forEach(s => { %>
                                <option value="<%= s.id %>"><%= s.name %></option>
                            <% }) %>
                        </select>
                        <input type="number" name="question_counts[]" placeholder="Questions (e.g. 40)" required style="flex: 1;" min="1">
                        <label style="display: flex; align-items: center; gap: 5px; flex: 1; color: var(--text-color);">
                            <input type="checkbox" name="is_compulsory[]" class="compulsory-cb" checked> Compulsory
                        </label>
                    </div>
                </div>
                
                <button type="button" class="btn btn-secondary" id="addSubjBtn" style="margin-bottom: 20px;">+ Add Another Subject</button>
                <br>
                <button type="submit" class="btn btn-primary" style="width: 100%; padding: 12px; font-size: 1.1rem;">Save Blueprint</button>
            </form>
        </div>
    </main>

    <script>
        document.getElementById('candidateSelectionToggle').addEventListener('change', function() {
            document.getElementById('electiveCountGroup').style.display = this.checked ? 'block' : 'none';
        });

        document.getElementById('addSubjBtn').addEventListener('click', () => {
            const container = document.getElementById('subjectsContainer');
            const row = document.createElement('div');
            row.className = 'subject-row';
            row.innerHTML = `
                <select name="subjects[]" required style="flex: 2;">
                    <option value="">Select Subject</option>
                    <% subjects.forEach(s => { %>
                        <option value="<%= s.id %>"><%= s.name %></option>
                    <% }) %>
                </select>
                <input type="number" name="question_counts[]" placeholder="Questions (e.g. 40)" required style="flex: 1;" min="1">
                <label style="display: flex; align-items: center; gap: 5px; flex: 1; color: var(--text-color);">
                    <input type="checkbox" name="is_compulsory[]" class="compulsory-cb"> Compulsory
                </label>
                <button type="button" class="btn btn-secondary" onclick="this.parentElement.remove()" style="padding: 5px 10px; background: #ef4444; border:none; color:white;">X</button>
            `;
            container.appendChild(row);
        });
        
        // Before submit, we must handle the array logic for checkboxes.
        // Unchecked checkboxes don't submit anything, which ruins parallel arrays.
        document.querySelector('form').addEventListener('submit', function(e) {
            const rows = document.querySelectorAll('.subject-row');
            rows.forEach(row => {
                const select = row.querySelector('select');
                const cb = row.querySelector('.compulsory-cb');
                if(cb.checked) {
                    cb.value = select.value; // Set value to subject ID so we know WHICH ones are compulsory on backend
                }
            });
        });
    </script>
</body>
</html>
