<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta charset="UTF-8">
    <title>Course Exam Questions - Executive Admin</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <link rel="manifest" href="/manifest.json">
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').catch(err => console.log('SW setup failed: ', err));
            });
        }
    </script>
    <link rel="icon" media="(prefers-color-scheme: light)" href="/acct/img/favicon-dark.png">
    <link rel="icon" media="(prefers-color-scheme: dark)" href="/acct/img/favicon-light.png">
    <style>
        .admin-workspace-grid {
            display: grid;
            grid-template-columns: 1.15fr 0.85fr;
            gap: 24px;
            align-items: start;
        }
        @media (max-width: 1024px) {
            .admin-workspace-grid {
                grid-template-columns: 1fr;
            }
        }
        .csv-spec-box {
            background: rgba(59, 130, 246, 0.05);
            border: 1px dashed rgba(59, 130, 246, 0.3);
            border-radius: 10px;
            padding: 16px;
            margin-bottom: 20px;
        }
        .csv-code-snippet {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            background: var(--bg-color);
            border: 1px solid var(--border-color);
            padding: 8px 12px;
            border-radius: 8px;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 0.8rem;
            color: var(--cta-color);
            overflow-x: auto;
            margin: 8px 0;
        }
        .drag-drop-container {
            border: 2px dashed var(--border-color);
            border-radius: 12px;
            padding: 32px 20px;
            text-align: center;
            background: var(--bg-color);
            transition: all 0.25s ease;
            cursor: pointer;
            position: relative;
            margin-bottom: 20px;
        }
        .drag-drop-container:hover, .drag-drop-container.dragover {
            border-color: var(--primary-color);
            background: rgba(59, 130, 246, 0.06);
            transform: translateY(-1px);
        }
        .drag-drop-container input[type="file"] {
            position: absolute;
            inset: 0;
            opacity: 0;
            width: 100%;
            height: 100%;
            cursor: pointer;
        }
        .file-selected-badge {
            display: none;
            margin-top: 12px;
            padding: 8px 14px;
            background: rgba(16, 185, 129, 0.12);
            border: 1px solid rgba(16, 185, 129, 0.3);
            border-radius: 8px;
            font-size: 0.85rem;
            color: #10b981;
            font-weight: 600;
        }
        .dept-helper-pills {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-bottom: 8px;
        }
        .dept-chip {
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 0.76rem;
            background: var(--bg-color);
            border: 1px solid var(--border-color);
            color: var(--ntxt-color);
            cursor: pointer;
            transition: all 0.2s ease;
            font-weight: 500;
        }
        .dept-chip:hover {
            border-color: var(--primary-color);
            color: var(--primary-color);
        }
        .courses-cloud-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(105px, 1fr));
            gap: 10px;
            max-height: 480px;
            overflow-y: auto;
            padding-right: 4px;
        }
        .course-tag-card {
            background: var(--bg-color);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 10px 12px;
            text-align: center;
            font-weight: 600;
            font-size: 0.88rem;
            color: var(--text-color);
            transition: all 0.2s ease;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }
        .course-tag-card:hover {
            border-color: var(--primary-color);
            color: var(--primary-color);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.15);
        }
        .course-tag-card small {
            font-size: 0.7rem;
            color: var(--ntxt-color);
            font-weight: 400;
        }
    </style>
</head>
<body class="dashboard-body admin-body">
    <%- include('./partials/admin_sidebar', { active_page: 'admin_questions' }) %>

    <main class="admin-main-content">
        <!-- Executive Topbar -->
        <header class="admin-topbar">
            <div style="display: flex; align-items: center; gap: 14px;">
                <button class="admin-mobile-toggle" onclick="toggleAdminNav()" aria-label="Toggle Navigation">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                </button>
                <div>
                    <h1 class="admin-title">Course Exam Questions</h1>
                    <p class="admin-subtitle">Bulk upload semester test items, course CSV questions, and manage university mock banks.</p>
                </div>
            </div>
            <div class="admin-topbar-actions">
                <a href="/admin" class="btn btn-outline" style="border-radius: 8px; font-weight: 600; font-size: 0.85rem; padding: 8px 14px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                    &larr; Overview
                </a>
            </div>
        </header>

        <% const totalCoursesCount = (locals.courses && courses.length) ? courses.length : 0; %>

        <!-- KPI Metrics Grid -->
        <div class="kpi-grid">
            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Active Question Banks</div>
                        <div class="kpi-value"><%= totalCoursesCount %></div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(59, 130, 246, 0.12); color: #3b82f6;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #3b82f6; font-weight: 600;"><%= totalCoursesCount %> Courses Ready</span>
                    <span>&bull; CBT Simulated</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Ingestion Engine</div>
                        <div class="kpi-value" style="font-size: 1.45rem;">CSV Bulk Parser</div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(16, 185, 129, 0.12); color: #10b981;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #10b981; font-weight: 600;">Automated Ingestion</span>
                    <span>&bull; High-throughput</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Curriculum Levels</div>
                        <div class="kpi-value" style="font-size: 1.45rem;">100L &ndash; 500L</div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(139, 92, 246, 0.12); color: #8b5cf6;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #8b5cf6; font-weight: 600;">Undergraduate Scope</span>
                    <span>&bull; Multi-tier support</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">CSV Standard</div>
                        <div class="kpi-value" style="font-size: 1.45rem;">7 Columns</div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(245, 158, 11, 0.12); color: #f59e0b;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #f59e0b; font-weight: 600;">Strict Schema</span>
                    <span>&bull; Header Skipped</span>
                </div>
            </div>
        </div>

        <!-- Global Action Alerts -->
        <% if (locals.success && success.length > 0) { %>
            <div class="alert alert-success" style="border-radius: 10px; margin-bottom: 24px; display: flex; align-items: center; gap: 12px; padding: 14px 18px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                <span><%= success %></span>
            </div>
        <% } %>
        <% if (locals.error && error.length > 0) { %>
            <div class="alert alert-error" style="border-radius: 10px; margin-bottom: 24px; display: flex; align-items: center; gap: 12px; padding: 14px 18px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                <span><%= error %></span>
            </div>
        <% } %>

        <!-- Two-Column Workspace -->
        <div class="admin-workspace-grid">
            <!-- Left Column: Upload Form -->
            <div class="admin-panel">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px;">
                    <div>
                        <h2 style="font-size: 1.15rem; font-weight: 700; margin: 0; color: var(--text-color);">Import Questions (CSV)</h2>
                        <p style="font-size: 0.85rem; color: var(--ntxt-color); margin: 4px 0 0 0;">Upload structured questions mapped directly to academic departments and levels.</p>
                    </div>
                    <span class="badge-pill info">Batch Processor</span>
                </div>

                <!-- CSV Specifications Card -->
                <div class="csv-spec-box">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-weight: 700; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--cta-color);">Required CSV Schema (7 Columns)</span>
                        <button type="button" onclick="copyCsvHeader()" class="copy-pill" title="Copy Column Names">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                            <span id="copyHeaderText">Copy Header</span>
                        </button>
                    </div>
                    <div class="csv-code-snippet" id="csvHeaderSnippet">course_code, question_text, option_a, option_b, option_c, option_d, correct_option</div>
                    <div style="font-size: 0.78rem; color: var(--ntxt-color); line-height: 1.4;">
                        Row 1 is automatically treated as the column header and skipped. The <code style="color: var(--cta-color); font-weight: 600;">correct_option</code> value must be strictly one of <code style="color: var(--cta-color);">A</code>, <code style="color: var(--cta-color);">B</code>, <code style="color: var(--cta-color);">C</code>, or <code style="color: var(--cta-color);">D</code>.
                    </div>
                </div>

                <form method="POST" action="/admin/questions" enctype="multipart/form-data" id="questionUploadForm">
                    <div style="display: grid; grid-template-columns: 1fr; gap: 16px; margin-bottom: 18px;">
                        <!-- Level Select -->
                        <div class="form-group">
                            <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 6px;">Academic Level</label>
                            <select name="level" class="admin-select" style="width: 100%;" required>
                                <option value="100">100 Level (Freshman)</option>
                                <option value="200">200 Level (Sophomore)</option>
                                <option value="300">300 Level (Junior)</option>
                                <option value="400">400 Level (Senior)</option>
                                <option value="500">500 Level (Final / Professional)</option>
                            </select>
                        </div>

                        <!-- Department Selection -->
                        <div class="form-group">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                                <label style="font-weight: 600; font-size: 0.85rem; margin: 0;">Target Departments</label>
                                <span id="deptCountBadge" style="font-size: 0.76rem; color: var(--cta-color); font-weight: 600;">Hold Ctrl / Cmd for multi-select</span>
                            </div>
                            
                            <!-- Quick Action Chips -->
                            <div class="dept-helper-pills">
                                <button type="button" class="dept-chip" onclick="selectGST()">⚡ General Studies (GST)</button>
                                <button type="button" class="dept-chip" onclick="selectAllDepts()">Select All</button>
                                <button type="button" class="dept-chip" onclick="clearDepts()">Deselect All</button>
                            </div>

                            <select name="department_id" id="deptSelect" multiple style="width: 100%; height: 160px; padding: 10px; border-radius: 9px; background: var(--bg-color); border: 1px solid var(--border-color); color: var(--text-color); font-size: 0.88rem;" required onchange="updateDeptCount()">
                                <%- include('./partials/department_options') %>
                            </select>
                        </div>
                    </div>

                    <!-- Drag & Drop CSV Box -->
                    <div class="form-group">
                        <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 6px;">Select Question Bank CSV</label>
                        <div class="drag-drop-container" id="csvDropZone">
                            <input type="file" name="csv_file" id="csvFileInput" accept=".csv" required>
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="color: var(--primary-color); margin-bottom: 10px;">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="17 8 12 3 7 8"></polyline>
                                <line x1="12" y1="3" x2="12" y2="15"></line>
                            </svg>
                            <div style="font-weight: 600; font-size: 0.95rem; color: var(--text-color);">Drag & Drop your CSV file here</div>
                            <p style="color: var(--ntxt-color); font-size: 0.82rem; margin: 4px 0 0 0;">or click to browse from device (.csv format only)</p>
                            
                            <div class="file-selected-badge" id="fileSelectedBadge">
                                <span id="fileNameDisplay">file.csv</span>
                                <span id="fileSizeDisplay" style="font-size: 0.75rem; opacity: 0.8; margin-left: 6px;">(0 KB)</span>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-ai" style="width: 100%; padding: 12px; font-size: 0.95rem; font-weight: 600; display: inline-flex; justify-content: center; align-items: center; gap: 8px;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                        <span>Upload & Import Questions</span>
                    </button>
                </form>
            </div>

            <!-- Right Column: Directory & Danger Zone -->
            <div>
                <!-- Directory Panel -->
                <div class="admin-panel">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                        <div>
                            <h2 style="font-size: 1.15rem; font-weight: 700; margin: 0; color: var(--text-color);">Active Course Banks</h2>
                            <p style="font-size: 0.85rem; color: var(--ntxt-color); margin: 4px 0 0 0;">Courses currently holding CBT mock questions.</p>
                        </div>
                        <span class="badge-pill info" id="activeCoursesCount"><%= totalCoursesCount %> Courses</span>
                    </div>

                    <!-- Search Filter -->
                    <div class="admin-search-box" style="margin-bottom: 16px;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        <input type="text" id="courseFilterInput" placeholder="Filter courses (e.g. GST101, MTH)..." onkeyup="filterCourseCards()">
                    </div>

                    <!-- Course Pills Grid -->
                    <% if (locals.courses && courses.length > 0) { %>
                        <div class="courses-cloud-grid" id="coursesGrid">
                            <% courses.forEach(c => { %>
                                <div class="course-tag-card" data-code="<%= c.course_code.toLowerCase() %>">
                                    <span><%= c.course_code %></span>
                                    <small>Mock Ready</small>
                                </div>
                            <% }); %>
                        </div>
                        <div id="noMatchMessage" style="display: none; text-align: center; padding: 2.5rem 1rem; color: var(--ntxt-color);">
                            <p style="margin: 0; font-size: 0.9rem;">No courses match your filter.</p>
                        </div>
                    <% } else { %>
                        <div style="text-align: center; padding: 3rem 1.5rem; color: var(--ntxt-color);">
                            <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 12px; opacity: 0.4;">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="8" y1="12" x2="16" y2="12"></line>
                            </svg>
                            <p style="font-weight: 600; margin-bottom: 4px; color: var(--text-color);">No courses uploaded yet</p>
                            <p style="font-size: 0.85rem; margin: 0;">Use the CSV importer on the left to upload your initial course exam questions.</p>
                        </div>
                    <% } %>
                </div>

                <!-- Danger Zone Panel -->
                <div class="admin-panel" style="border: 1px solid rgba(239, 68, 68, 0.3); background: rgba(239, 68, 68, 0.02);">
                    <div style="display: flex; align-items: flex-start; gap: 14px; margin-bottom: 16px;">
                        <div style="background: rgba(239, 68, 68, 0.12); color: #ef4444; padding: 10px; border-radius: 10px;">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                        </div>
                        <div>
                            <h3 style="font-size: 1rem; font-weight: 700; margin: 0; color: #ef4444;">Purge Mock Question Bank</h3>
                            <p style="font-size: 0.82rem; color: var(--ntxt-color); margin: 4px 0 0 0; line-height: 1.4;">
                                Permanently wipe all uploaded mock examination questions across every department. This action cannot be reversed.
                            </p>
                        </div>
                    </div>

                    <form method="POST" action="/admin/questions/clear" onsubmit="return confirm('⚠️ CRITICAL WARNING: Are you completely certain you want to purge ALL mock exam questions? All student practice data mapped to these items will be permanently reset.');">
                        <button type="submit" class="btn" style="width: 100%; background: #ef4444; color: white; padding: 10px; font-weight: 600; border-radius: 8px; border: none; cursor: pointer; display: inline-flex; justify-content: center; align-items: center; gap: 8px; font-size: 0.88rem;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            <span>Clear All Uploaded Questions</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <script>
        // Department multi-select helpers
        const deptSelect = document.getElementById('deptSelect');
        const deptCountBadge = document.getElementById('deptCountBadge');

        function updateDeptCount() {
            const count = Array.from(deptSelect.selectedOptions).length;
            if (count > 0) {
                deptCountBadge.innerText = `${count} department${count > 1 ? 's' : ''} selected`;
                deptCountBadge.style.color = 'var(--primary-color)';
            } else {
                deptCountBadge.innerText = 'Hold Ctrl / Cmd for multi-select';
                deptCountBadge.style.color = 'var(--ntxt-color)';
            }
        }

        function selectGST() {
            Array.from(deptSelect.options).forEach(opt => {
                opt.selected = (opt.value === 'gst');
            });
            updateDeptCount();
        }

        function selectAllDepts() {
            Array.from(deptSelect.options).forEach(opt => {
                opt.selected = true;
            });
            updateDeptCount();
        }

        function clearDepts() {
            Array.from(deptSelect.options).forEach(opt => {
                opt.selected = false;
            });
            updateDeptCount();
        }

        // Drag & Drop CSV handling
        const dropZone = document.getElementById('csvDropZone');
        const fileInput = document.getElementById('csvFileInput');
        const fileBadge = document.getElementById('fileSelectedBadge');
        const fileNameDisplay = document.getElementById('fileNameDisplay');
        const fileSizeDisplay = document.getElementById('fileSizeDisplay');

        ['dragenter', 'dragover'].forEach(eventName => {
            dropZone.addEventListener(eventName, (e) => {
                e.preventDefault();
                dropZone.classList.add('dragover');
            });
        });

        ['dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, (e) => {
                e.preventDefault();
                dropZone.classList.remove('dragover');
            });
        });

        dropZone.addEventListener('drop', (e) => {
            const files = e.dataTransfer.files;
            if (files.length > 0) {
                fileInput.files = files;
                showSelectedFile(files[0]);
            }
        });

        fileInput.addEventListener('change', () => {
            if (fileInput.files.length > 0) {
                showSelectedFile(fileInput.files[0]);
            } else {
                fileBadge.style.display = 'none';
            }
        });

        function showSelectedFile(file) {
            fileNameDisplay.innerText = file.name;
            const sizeKB = (file.size / 1024).toFixed(1);
            fileSizeDisplay.innerText = `(${sizeKB} KB)`;
            fileBadge.style.display = 'inline-flex';
        }

        // Copy CSV Header format
        function copyCsvHeader() {
            const text = document.getElementById('csvHeaderSnippet').innerText;
            navigator.clipboard.writeText(text).then(() => {
                const copyBtnText = document.getElementById('copyHeaderText');
                copyBtnText.innerText = 'Copied!';
                setTimeout(() => {
                    copyBtnText.innerText = 'Copy Header';
                }, 2000);
            });
        }

        // Filter uploaded course cards
        function filterCourseCards() {
            const query = document.getElementById('courseFilterInput').value.toLowerCase().trim();
            const cards = document.querySelectorAll('.course-tag-card');
            let visibleCount = 0;

            cards.forEach(card => {
                const code = card.getAttribute('data-code');
                if (code.includes(query)) {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            const noMatch = document.getElementById('noMatchMessage');
            if (noMatch) {
                noMatch.style.display = (visibleCount === 0 && cards.length > 0) ? 'block' : 'none';
            }
        }
    </script>
</body>
</html>
