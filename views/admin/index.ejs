<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Executive Admin Console - KelselPDF</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <link rel="icon" media="(prefers-color-scheme: light)" href="/acct/img/favicon-dark.png">
    <link rel="icon" media="(prefers-color-scheme: dark)" href="/acct/img/favicon-light.png">
</head>
<body class="dashboard-body admin-body">
    <%- include('./partials/admin_sidebar', { active_page: 'admin' }) %>

    <main class="admin-main-content">
        <!-- Top Executive Bar -->
        <header class="admin-topbar">
            <div style="display: flex; align-items: center; gap: 14px;">
                <button class="admin-mobile-toggle" onclick="toggleAdminNav()" aria-label="Toggle Navigation">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                </button>
                <div>
                    <h1 class="admin-title">Platform Executive Console</h1>
                    <p class="admin-subtitle">Real-time candidate metrics, CBT exam banks, subscriptions & revenue.</p>
                </div>
            </div>

            <div class="admin-topbar-actions">
                <div class="status-pill-live">
                    <span class="status-dot"></span>
                    <span>Live Production</span>
                </div>
                <a href="/admin/cbt" class="btn btn-outline" style="border-radius: 8px; font-weight: 600; font-size: 0.85rem; padding: 8px 14px; text-decoration: none;">
                    CBT Engine Hub
                </a>
                <a href="/admin/cbt/import" class="btn btn-primary" style="border-radius: 8px; font-weight: 600; font-size: 0.85rem; padding: 8px 16px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                    <span>+ Upload PDF</span>
                </a>
            </div>
        </header>

        <!-- KPI Metrics Grid -->
        <div class="kpi-grid">
            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Gross Revenue</div>
                        <div class="kpi-value">₦<%= Number(revenue).toLocaleString() %></div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(16, 185, 129, 0.12); color: #10b981;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #10b981; font-weight: 600;">₦ Verified</span>
                    <span>&bull; <%= total_tx_count %> Transactions</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Active Subscribers</div>
                        <div class="kpi-value"><%= active_subs %></div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(59, 130, 246, 0.12); color: #3b82f6;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #3b82f6; font-weight: 600;">VIP Access</span>
                    <span>&bull; Valid Subscriptions</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Total Candidates</div>
                        <div class="kpi-value"><%= users_count %></div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(139, 92, 246, 0.12); color: #8b5cf6;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span>Student Accounts</span>
                    <span>&bull; <%= dept_stats ? dept_stats.length : 0 %> Depts</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Questions In Bank</div>
                        <div class="kpi-value"><%= (q_count + pq_count + cbt_q_count).toLocaleString() %></div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(245, 158, 11, 0.12); color: #f59e0b;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <% if (cbt_pending_count > 0) { %>
                        <span class="badge badge-warning"><%= cbt_pending_count %> Review Pending</span>
                    <% } else { %>
                        <span style="color: #10b981; font-weight: 600;">All Published</span>
                    <% } %>
                    <span>&bull; CBT + Academic</span>
                </div>
            </div>
        </div>

        <!-- Quick Modules Hub -->
        <div style="margin-bottom: 2rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <h2 style="font-size: 1.15rem; font-weight: 700; color: var(--text-color); margin: 0;">Operational Modules</h2>
                <span style="font-size: 0.85rem; color: var(--ntxt-color);">Core Administrative Areas</span>
            </div>

            <div class="admin-modules-grid">
                <a href="/admin/cbt" class="module-card">
                    <div class="module-icon-box" style="background: rgba(59, 130, 246, 0.12); color: #3b82f6;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
                    </div>
                    <div>
                        <div class="module-title">CBT Engine</div>
                        <div class="module-desc">JAMB, WAEC, NECO mocks, timer blueprints & auto-grading</div>
                    </div>
                    <span class="module-arrow">&rarr;</span>
                </a>

                <a href="/admin/payments" class="module-card">
                    <div class="module-icon-box" style="background: rgba(16, 185, 129, 0.12); color: #10b981;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                    </div>
                    <div>
                        <div class="module-title">Payments Ledger</div>
                        <div class="module-desc">Live Paystack transactions, verification & revenue logs</div>
                    </div>
                    <span class="module-arrow">&rarr;</span>
                </a>

                <a href="/admin/subscriptions" class="module-card">
                    <div class="module-icon-box" style="background: rgba(236, 72, 153, 0.12); color: #ec4899;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                    </div>
                    <div>
                        <div class="module-title">Subscriptions</div>
                        <div class="module-desc">Manage candidate access, account locking & validity dates</div>
                    </div>
                    <span class="module-arrow">&rarr;</span>
                </a>

                <a href="/admin/cbt/import" class="module-card">
                    <div class="module-icon-box" style="background: rgba(245, 158, 11, 0.12); color: #f59e0b;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                    </div>
                    <div>
                        <div class="module-title">AI PDF Ingestion</div>
                        <div class="module-desc">Automated past question text extraction & parsing</div>
                    </div>
                    <span class="module-arrow">&rarr;</span>
                </a>

                <a href="/admin/users" class="module-card">
                    <div class="module-icon-box" style="background: rgba(139, 92, 246, 0.12); color: #8b5cf6;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    </div>
                    <div>
                        <div class="module-title">User Accounts</div>
                        <div class="module-desc">Candidate profiles, department groupings & permissions</div>
                    </div>
                    <span class="module-arrow">&rarr;</span>
                </a>

                <a href="/admin/skills" class="module-card">
                    <div class="module-icon-box" style="background: rgba(14, 165, 233, 0.12); color: #0ea5e9;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>
                    </div>
                    <div>
                        <div class="module-title">Skills Academy</div>
                        <div class="module-desc">Vocational course modules, video lessons & certificates</div>
                    </div>
                    <span class="module-arrow">&rarr;</span>
                </a>
            </div>
        </div>

        <!-- Two-Column Operations Layout -->
        <div class="dashboard-layout">
            <!-- Left Column: Transactions & Dept Stats -->
            <div style="display: flex; flex-direction: column; gap: 24px;">
                <!-- Recent Transactions -->
                <div class="panel">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px;">
                        <div>
                            <h3 style="margin: 0; font-size: 1.15rem; font-weight: 700; color: var(--text-color);">Recent Transactions</h3>
                            <div style="font-size: 0.8rem; color: var(--ntxt-color); margin-top: 3px;">Verified payments received via Paystack</div>
                        </div>
                        <a href="/admin/payments" style="color: var(--primary-color); text-decoration: none; font-size: 0.85rem; font-weight: 600;">View Ledger &rarr;</a>
                    </div>

                    <% if (recent_transactions && recent_transactions.length > 0) { %>
                        <div style="overflow-x: auto;">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Candidate</th>
                                        <th>Reference</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% recent_transactions.forEach(tx => { %>
                                        <tr>
                                            <td style="color: var(--ntxt-color); font-size: 0.85rem; white-space: nowrap;">
                                                <%= new Date(tx.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                            </td>
                                            <td>
                                                <div style="font-weight: 600; color: var(--text-color);"><%= tx.full_name || 'Candidate' %></div>
                                                <div style="font-size: 0.8rem; color: var(--ntxt-color);"><%= tx.email %></div>
                                            </td>
                                            <td style="font-family: monospace; font-size: 0.8rem; color: var(--ntxt-color);">
                                                <%= tx.reference %>
                                            </td>
                                            <td style="font-weight: 700; color: #10b981; white-space: nowrap;">
                                                ₦<%= Number(tx.amount).toLocaleString() %>
                                            </td>
                                            <td>
                                                <span class="badge <%= tx.status === 'success' ? 'badge-success' : 'badge-warning' %>">
                                                    <%= (tx.status || 'SUCCESS').toUpperCase() %>
                                                </span>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="empty-state" style="padding: 2.5rem 1rem;">
                            <div style="font-size: 2rem; margin-bottom: 8px;">💳</div>
                            <strong>No Transactions Yet</strong>
                            <p style="margin-top: 4px;">Verified candidate payment records will appear here.</p>
                        </div>
                    <% } %>
                </div>

                <!-- Paid Candidates by Department -->
                <div class="panel">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px;">
                        <div>
                            <h3 style="margin: 0; font-size: 1.15rem; font-weight: 700; color: var(--text-color);">Paid Candidates by Department</h3>
                            <div style="font-size: 0.8rem; color: var(--ntxt-color); margin-top: 3px;">Distribution of paying subscribers across academic programs</div>
                        </div>
                        <a href="/admin/subscriptions" style="color: var(--primary-color); text-decoration: none; font-size: 0.85rem; font-weight: 600;">Subscriptions &rarr;</a>
                    </div>

                    <% if (dept_stats && dept_stats.length > 0) { 
                        const maxPaid = Math.max(...dept_stats.map(d => d.paid_count || 1), 1);
                    %>
                        <div style="display: flex; flex-direction: column; gap: 14px;">
                            <% dept_stats.slice(0, 7).forEach((dept, index) => { 
                                const pct = Math.round((dept.paid_count / maxPaid) * 100);
                            %>
                                <div>
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                                        <div style="display: flex; align-items: center; gap: 8px;">
                                            <span style="font-size: 0.75rem; font-weight: 700; color: var(--ntxt-color); width: 18px;">#<%= index + 1 %></span>
                                            <strong style="color: var(--text-color); font-size: 0.9rem; text-transform: capitalize;"><%= dept.department_id || 'General' %></strong>
                                        </div>
                                        <div style="font-size: 0.85rem; font-weight: 700; color: #10b981;">
                                            <%= dept.paid_count %> paid
                                        </div>
                                    </div>
                                    <div class="dept-meter-bg">
                                        <div class="dept-meter-fill" style="width: <%= Math.max(pct, 5) %>%;"></div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="empty-state" style="padding: 2.5rem 1rem;">
                            <div style="font-size: 2rem; margin-bottom: 8px;">🎓</div>
                            <strong>No Paid Candidates Recorded</strong>
                            <p style="margin-top: 4px;">Department breakdown will display as students subscribe.</p>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Right Column: Recent Users & Health -->
            <div style="display: flex; flex-direction: column; gap: 24px;">
                <!-- Review Queue Alert -->
                <% if (cbt_pending_count > 0) { %>
                    <div class="panel" style="border-color: rgba(245, 158, 11, 0.4); background: linear-gradient(180deg, rgba(245, 158, 11, 0.08) 0%, var(--card-bg) 100%);">
                        <div style="display: flex; align-items: flex-start; gap: 12px;">
                            <div style="font-size: 1.5rem;">⚠️</div>
                            <div>
                                <h4 style="margin: 0; color: #f59e0b; font-size: 1rem; font-weight: 700;">Action Required: Review Queue</h4>
                                <p style="margin: 6px 0 12px 0; font-size: 0.85rem; color: var(--text-color); line-height: 1.4;">
                                    There are <strong><%= cbt_pending_count %> questions</strong> extracted from PDFs waiting for approval before students can practice them.
                                </p>
                                <a href="/admin/cbt/review" class="btn btn-primary" style="padding: 6px 14px; font-size: 0.8rem; border-radius: 6px; text-decoration: none; display: inline-block;">
                                    Review Queue Now &rarr;
                                </a>
                            </div>
                        </div>
                    </div>
                <% } %>

                <!-- Recent Registered Candidates -->
                <div class="panel">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px;">
                        <div>
                            <h3 style="margin: 0; font-size: 1.15rem; font-weight: 700; color: var(--text-color);">Recent Signups</h3>
                            <div style="font-size: 0.8rem; color: var(--ntxt-color); margin-top: 3px;">Newly registered candidates</div>
                        </div>
                        <a href="/admin/users" style="color: var(--primary-color); text-decoration: none; font-size: 0.85rem; font-weight: 600;">All Users &rarr;</a>
                    </div>

                    <% if (recent_users && recent_users.length > 0) { %>
                        <div style="display: flex; flex-direction: column; gap: 12px;">
                            <% recent_users.forEach(u => { 
                                const initial = (u.full_name || 'U').trim().charAt(0).toUpperCase();
                            %>
                                <div class="recent-user-item">
                                    <div class="user-avatar-initial"><%= initial %></div>
                                    <div style="flex: 1; min-width: 0;">
                                        <div style="display: flex; justify-content: space-between; align-items: center;">
                                            <div style="font-size: 0.9rem; font-weight: 600; color: var(--text-color); text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                                                <%= u.full_name || 'Unnamed Candidate' %>
                                            </div>
                                            <% if (u.has_paid) { %>
                                                <span class="badge badge-success" style="font-size: 0.65rem; padding: 2px 6px;">PAID</span>
                                            <% } else { %>
                                                <span class="badge badge-gray" style="font-size: 0.65rem; padding: 2px 6px;">FREE</span>
                                            <% } %>
                                        </div>
                                        <div style="font-size: 0.78rem; color: var(--ntxt-color); margin-top: 2px;">
                                            <%= u.department_id ? u.department_id : 'No dept' %> &bull; <%= u.level ? u.level + 'L' : 'Std' %>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="empty-state" style="padding: 2rem 1rem;">
                            <strong>No registered users found.</strong>
                        </div>
                    <% } %>
                </div>

                <!-- Academic Question Repositories -->
                <div class="panel">
                    <h3 style="margin: 0 0 14px 0; font-size: 1.15rem; font-weight: 700; color: var(--text-color);">Academic Question Banks</h3>
                    <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px;">
                        <li style="display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--border-color);">
                            <div>
                                <strong style="color: var(--text-color); font-size: 0.9rem;">CBT National Bank</strong>
                                <div style="font-size: 0.75rem; color: var(--ntxt-color);">JAMB, WAEC, NECO questions</div>
                            </div>
                            <span class="badge badge-success"><%= cbt_q_count %> Qs</span>
                        </li>
                        <li style="display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--border-color);">
                            <div>
                                <strong style="color: var(--text-color); font-size: 0.9rem;">Course Mock Bank</strong>
                                <div style="font-size: 0.75rem; color: var(--ntxt-color);">AAU university practice tests</div>
                            </div>
                            <span class="badge badge-info"><%= q_count %> Qs</span>
                        </li>
                        <li style="display: flex; justify-content: space-between; align-items: center; padding: 10px 0;">
                            <div>
                                <strong style="color: var(--text-color); font-size: 0.9rem;">Past Questions Archive</strong>
                                <div style="font-size: 0.75rem; color: var(--ntxt-color);">Historical semester examinations</div>
                            </div>
                            <span class="badge badge-warning"><%= pq_count %> Qs</span>
                        </li>
                    </ul>

                    <div style="margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--border-color); display: flex; gap: 10px;">
                        <a href="/admin/questions" class="btn btn-outline" style="flex: 1; text-align: center; text-decoration: none; font-size: 0.8rem; padding: 8px;">Upload Qs</a>
                        <a href="/admin/activity" class="btn btn-outline" style="flex: 1; text-align: center; text-decoration: none; font-size: 0.8rem; padding: 8px;">Audit Logs</a>
                    </div>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
