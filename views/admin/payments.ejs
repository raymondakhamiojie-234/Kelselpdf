<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta charset="UTF-8">
    <title>All Payments - Admin Panel</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <link rel="manifest" href="/manifest.json">
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').catch(err => console.log('SW setup failed: ', err));
            });
        }
    </script>
<link rel="icon" media="(prefers-color-scheme: light)" href="/acct/img/favicon-dark.png">
    <link rel="icon" media="(prefers-color-scheme: dark)" href="/acct/img/favicon-light.png">
</head>
<body class="dashboard-body admin-body">
    <%- include('./partials/admin_sidebar', { active_page: 'admin_payments' }) %>

    <main class="admin-main-content">
        <header class="admin-topbar">
            <div style="display: flex; align-items: center; gap: 14px;">
                <button class="admin-mobile-toggle" onclick="toggleAdminNav()" aria-label="Toggle Navigation">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                </button>
                <div>
                    <h1 class="admin-title">Payments & Revenue Ledger</h1>
                    <p class="admin-subtitle">Live record of all candidate transactions verified via Paystack.</p>
                </div>
            </div>
            <div class="admin-topbar-actions">
                <a href="/admin" class="btn btn-outline" style="border-radius: 8px; font-weight: 600; font-size: 0.85rem; padding: 8px 14px; text-decoration: none;">
                    &larr; Overview
                </a>
            </div>
        </header>

        <h2>Payment History Ledger</h2>
        <div class="glass-panel">
            <div class="table-responsive">
                <table class="styled-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>User</th>
                            <th>Email</th>
                            <th>Reference</th>
                            <th>Plan</th>
                            <th>Amount (₦)</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (payments.length === 0) { %>
                            <tr><td colspan="7" class="text-center">No transactions found.</td></tr>
                        <% } else { %>
                            <% payments.forEach(p => { %>
                            <tr>
                                <td><%= new Date(p.created_at).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) %></td>
                                <td><%= p.full_name %></td>
                                <td><%= p.email %></td>
                                <td><%= p.reference %></td>
                                <td><%= p.plan %></td>
                                <td><%= Number(p.amount).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                <td style="color: var(--success); text-transform: capitalize;"><%= p.status %></td>
                            </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</body>
</html>





