<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta charset="UTF-8">
    <title>Past Questions Archive - Executive Admin</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <link rel="manifest" href="/manifest.json">
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').catch(err => console.log('SW setup failed: ', err));
            });
        }
    </script>
    <link rel="icon" media="(prefers-color-scheme: light)" href="/acct/img/favicon-dark.png">
    <link rel="icon" media="(prefers-color-scheme: dark)" href="/acct/img/favicon-light.png">
    <style>
        .admin-workspace-grid {
            display: grid;
            grid-template-columns: 1.15fr 0.85fr;
            gap: 24px;
            align-items: start;
        }
        @media (max-width: 1024px) {
            .admin-workspace-grid {
                grid-template-columns: 1fr;
            }
        }
        .drag-drop-zone {
            border: 2px dashed var(--border-color);
            border-radius: 12px;
            padding: 30px 20px;
            text-align: center;
            background: var(--bg-color);
            transition: all 0.25s ease;
            cursor: pointer;
            position: relative;
            margin-bottom: 16px;
        }
        .drag-drop-zone:hover, .drag-drop-zone.dragover {
            border-color: var(--primary-color);
            background: rgba(59, 130, 246, 0.06);
            transform: translateY(-1px);
        }
        .drag-drop-zone input[type="file"] {
            position: absolute;
            inset: 0;
            opacity: 0;
            width: 100%;
            height: 100%;
            cursor: pointer;
        }
        .file-info-badge {
            display: none;
            margin-top: 12px;
            padding: 8px 14px;
            background: rgba(16, 185, 129, 0.12);
            border: 1px solid rgba(16, 185, 129, 0.3);
            border-radius: 8px;
            font-size: 0.85rem;
            color: #10b981;
            font-weight: 600;
        }
        .or-divider {
            display: flex;
            align-items: center;
            text-align: center;
            margin: 18px 0;
            color: var(--ntxt-color);
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
        }
        .or-divider::before, .or-divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid var(--border-color);
        }
        .or-divider:not(:empty)::before {
            margin-right: 14px;
        }
        .or-divider:not(:empty)::after {
            margin-left: 14px;
        }
        .dept-helper-pills {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-bottom: 8px;
        }
        .dept-chip {
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 0.76rem;
            background: var(--bg-color);
            border: 1px solid var(--border-color);
            color: var(--ntxt-color);
            cursor: pointer;
            transition: all 0.2s ease;
            font-weight: 500;
        }
        .dept-chip:hover {
            border-color: var(--primary-color);
            color: var(--primary-color);
        }
        .courses-cloud-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
            gap: 10px;
            max-height: 480px;
            overflow-y: auto;
            padding-right: 4px;
        }
        .course-tag-card {
            background: var(--bg-color);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 10px 12px;
            text-align: center;
            font-weight: 600;
            font-size: 0.88rem;
            color: var(--text-color);
            transition: all 0.2s ease;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }
        .course-tag-card:hover {
            border-color: var(--primary-color);
            color: var(--primary-color);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.15);
        }
        .course-tag-card small {
            font-size: 0.7rem;
            color: var(--ntxt-color);
            font-weight: 400;
        }
    </style>
</head>
<body class="dashboard-body admin-body">
    <%- include('./partials/admin_sidebar', { active_page: 'admin_pq' }) %>

    <main class="admin-main-content">
        <!-- Executive Topbar -->
        <header class="admin-topbar">
            <div style="display: flex; align-items: center; gap: 14px;">
                <button class="admin-mobile-toggle" onclick="toggleAdminNav()" aria-label="Toggle Navigation">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                </button>
                <div>
                    <h1 class="admin-title">Past Questions Archive</h1>
                    <p class="admin-subtitle">Upload past examination papers, solutions, and official course question archives.</p>
                </div>
            </div>
            <div class="admin-topbar-actions">
                <a href="/admin" class="btn btn-outline" style="border-radius: 8px; font-weight: 600; font-size: 0.85rem; padding: 8px 14px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                    &larr; Overview
                </a>
            </div>
        </header>

        <% const totalPqCourses = (locals.courses && courses.length) ? courses.length : 0; %>

        <!-- KPI Metrics Grid -->
        <div class="kpi-grid">
            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Archived Courses</div>
                        <div class="kpi-value"><%= totalPqCourses %></div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(59, 130, 246, 0.12); color: #3b82f6;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #3b82f6; font-weight: 600;"><%= totalPqCourses %> Course Catalogs</span>
                    <span>&bull; Digital Papers</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Exam Categories</div>
                        <div class="kpi-value" style="font-size: 1.45rem;">Midterm &bull; Final</div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(16, 185, 129, 0.12); color: #10b981;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #10b981; font-weight: 600;">Standard Assessments</span>
                    <span>&bull; Semester tests</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Supported Formats</div>
                        <div class="kpi-value" style="font-size: 1.45rem;">PDF &bull; Cloud URLs</div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(139, 92, 246, 0.12); color: #8b5cf6;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #8b5cf6; font-weight: 600;">Hybrid Storage</span>
                    <span>&bull; Cloud + Direct</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Student Availability</div>
                        <div class="kpi-value" style="font-size: 1.45rem;">Instant Sync</div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(245, 158, 11, 0.12); color: #f59e0b;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #f59e0b; font-weight: 600;">Live in Mobile App</span>
                    <span>&bull; Searchable</span>
                </div>
            </div>
        </div>

        <!-- Global Action Alerts -->
        <% if (locals.success && success.length > 0) { %>
            <div class="alert alert-success" style="border-radius: 10px; margin-bottom: 24px; display: flex; align-items: center; gap: 12px; padding: 14px 18px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                <span><%= success %></span>
            </div>
        <% } %>
        <% if (locals.error && error.length > 0) { %>
            <div class="alert alert-error" style="border-radius: 10px; margin-bottom: 24px; display: flex; align-items: center; gap: 12px; padding: 14px 18px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                <span><%= error %></span>
            </div>
        <% } %>

        <!-- Two-Column Workspace -->
        <div class="admin-workspace-grid">
            <!-- Left Column: Upload Form -->
            <div class="admin-panel">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px;">
                    <div>
                        <h2 style="font-size: 1.15rem; font-weight: 700; margin: 0; color: var(--text-color);">Add Past Question Material</h2>
                        <p style="font-size: 0.85rem; color: var(--ntxt-color); margin: 4px 0 0 0;">Upload an official question document or register an external cloud link.</p>
                    </div>
                    <span class="badge-pill success">Curated Vault</span>
                </div>

                <form method="POST" action="/admin/past_questions" enctype="multipart/form-data" id="pqUploadForm">
                    <!-- Course, Year, Exam Type -->
                    <div style="display: grid; grid-template-columns: 2fr 1.2fr 1.4fr; gap: 12px; margin-bottom: 16px;">
                        <div class="form-group">
                            <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 6px;">Course Code</label>
                            <input type="text" name="course_code" list="allCoursesList" placeholder="e.g. MTH101" required class="admin-select" style="width: 100%; box-sizing: border-box; text-transform: uppercase;">
                            <% if (locals.all_courses && all_courses.length > 0) { %>
                                <datalist id="allCoursesList">
                                    <% all_courses.forEach(c => { %>
                                        <option value="<%= c.course_code %>"></option>
                                    <% }); %>
                                </datalist>
                            <% } %>
                        </div>
                        <div class="form-group">
                            <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 6px;">Year</label>
                            <input type="text" name="year" placeholder="e.g. 2024" required class="admin-select" style="width: 100%; box-sizing: border-box;">
                        </div>
                        <div class="form-group">
                            <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 6px;">Exam Type</label>
                            <select name="type" required class="admin-select" style="width: 100%;">
                                <option value="Midterm">Midterm (CA)</option>
                                <option value="Final">Final Exam</option>
                                <option value="Mock">Mock Exam</option>
                            </select>
                        </div>
                    </div>

                    <!-- Level and Departments -->
                    <div style="display: grid; grid-template-columns: 1fr; gap: 16px; margin-bottom: 18px;">
                        <div class="form-group">
                            <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 6px;">Academic Level</label>
                            <select name="level" required class="admin-select" style="width: 100%;">
                                <option value="100">100 Level (Freshman)</option>
                                <option value="200">200 Level (Sophomore)</option>
                                <option value="300">300 Level (Junior)</option>
                                <option value="400">400 Level (Senior)</option>
                                <option value="500">500 Level (Final / Professional)</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                                <label style="font-weight: 600; font-size: 0.85rem; margin: 0;">Target Departments</label>
                                <span id="deptCountBadge" style="font-size: 0.76rem; color: var(--cta-color); font-weight: 600;">Hold Ctrl / Cmd for multi-select</span>
                            </div>

                            <!-- Quick Action Chips -->
                            <div class="dept-helper-pills">
                                <button type="button" class="dept-chip" onclick="selectGST()">⚡ General Studies (GST)</button>
                                <button type="button" class="dept-chip" onclick="selectAllDepts()">Select All</button>
                                <button type="button" class="dept-chip" onclick="clearDepts()">Deselect All</button>
                            </div>

                            <select name="department_id" id="deptSelect" multiple style="width: 100%; height: 160px; padding: 10px; border-radius: 9px; background: var(--bg-color); border: 1px solid var(--border-color); color: var(--text-color); font-size: 0.88rem;" required onchange="updateDeptCount()">
                                <%- include('./partials/department_options') %>
                            </select>
                        </div>
                    </div>

                    <!-- Drag & Drop Zone -->
                    <div class="form-group">
                        <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 6px;">Upload Document (PDF / DOCX)</label>
                        <div class="drag-drop-zone" id="dropZone">
                            <input type="file" name="pq_file" id="fileInput" accept=".pdf,.docx,.txt">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="color: var(--primary-color); margin-bottom: 10px;">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                                <line x1="12" y1="18" x2="12" y2="12"></line>
                                <line x1="9" y1="15" x2="15" y2="15"></line>
                            </svg>
                            <div style="font-weight: 600; font-size: 0.95rem; color: var(--text-color);">Drag & Drop question paper here</div>
                            <p style="color: var(--ntxt-color); font-size: 0.82rem; margin: 4px 0 0 0;">or click to browse from device (PDF recommended, max 25MB)</p>
                            
                            <div class="file-info-badge" id="fileInfoBadge">
                                <span id="fileNameDisplay">document.pdf</span>
                                <span id="fileSizeDisplay" style="font-size: 0.75rem; opacity: 0.8; margin-left: 6px;">(0 MB)</span>
                            </div>
                        </div>
                    </div>

                    <!-- Sleek OR Divider -->
                    <div class="or-divider">OR USE HOSTED FILE LINK</div>

                    <!-- External URL Input -->
                    <div class="form-group" style="margin-bottom: 22px;">
                        <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 6px;">External Cloud Document URL</label>
                        <input type="url" name="file_link" id="urlInput" placeholder="https://drive.google.com/... or https://..." class="admin-select" style="width: 100%; box-sizing: border-box;">
                    </div>

                    <button type="submit" class="btn btn-ai" style="width: 100%; padding: 12px; font-size: 0.95rem; font-weight: 600; display: inline-flex; justify-content: center; align-items: center; gap: 8px;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                        <span>Save & Publish Past Question</span>
                    </button>
                </form>
            </div>

            <!-- Right Column: Directory & Guidelines -->
            <div>
                <!-- Directory Panel -->
                <div class="admin-panel">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                        <div>
                            <h2 style="font-size: 1.15rem; font-weight: 700; margin: 0; color: var(--text-color);">Archived Courses</h2>
                            <p style="font-size: 0.85rem; color: var(--ntxt-color); margin: 4px 0 0 0;">Courses with uploaded past examination papers.</p>
                        </div>
                        <span class="badge-pill info" id="activeCoursesCount"><%= totalPqCourses %> Courses</span>
                    </div>

                    <!-- Search Filter -->
                    <div class="admin-search-box" style="margin-bottom: 16px;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        <input type="text" id="courseFilterInput" placeholder="Filter archived courses (e.g. MTH101, CHM)..." onkeyup="filterCourseCards()">
                    </div>

                    <!-- Course Pills Grid -->
                    <% if (locals.courses && courses.length > 0) { %>
                        <div class="courses-cloud-grid" id="coursesGrid">
                            <% courses.forEach(c => { %>
                                <div class="course-tag-card" data-code="<%= c.course_code.toLowerCase() %>">
                                    <span><%= c.course_code %></span>
                                    <small>Papers Active</small>
                                </div>
                            <% }); %>
                        </div>
                        <div id="noMatchMessage" style="display: none; text-align: center; padding: 2.5rem 1rem; color: var(--ntxt-color);">
                            <p style="margin: 0; font-size: 0.9rem;">No courses match your filter.</p>
                        </div>
                    <% } else { %>
                        <div style="text-align: center; padding: 3rem 1.5rem; color: var(--ntxt-color);">
                            <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 12px; opacity: 0.4;">
                                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                            </svg>
                            <p style="font-weight: 600; margin-bottom: 4px; color: var(--text-color);">No past questions uploaded yet</p>
                            <p style="font-size: 0.85rem; margin: 0;">Upload your first course paper using the past question form on the left.</p>
                        </div>
                    <% } %>
                </div>

                <!-- Guidelines Panel -->
                <div class="admin-panel" style="border: 1px solid var(--border-color);">
                    <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--primary-color);"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                        <h3 style="font-size: 0.95rem; font-weight: 700; margin: 0; color: var(--text-color);">Archive Best Practices</h3>
                    </div>
                    <ul style="font-size: 0.82rem; color: var(--ntxt-color); margin: 0; padding-left: 18px; line-height: 1.6;">
                        <li><strong>Clear Scans:</strong> Ensure uploaded examination papers are legible and properly oriented for mobile screens.</li>
                        <li><strong>Standard Course Codes:</strong> Use standardized uppercase codes (e.g., <code style="color: var(--cta-color);">GST111</code>, <code style="color: var(--cta-color);">COS101</code>) so mobile search maps accurately.</li>
                        <li><strong>Cloud Links:</strong> For files larger than 25MB, host them on Google Drive / Dropbox and paste the direct sharing URL.</li>
                    </ul>
                </div>
            </div>
        </div>
    </main>

    <script>
        // Department multi-select helpers
        const deptSelect = document.getElementById('deptSelect');
        const deptCountBadge = document.getElementById('deptCountBadge');

        function updateDeptCount() {
            const count = Array.from(deptSelect.selectedOptions).length;
            if (count > 0) {
                deptCountBadge.innerText = `${count} department${count > 1 ? 's' : ''} selected`;
                deptCountBadge.style.color = 'var(--primary-color)';
            } else {
                deptCountBadge.innerText = 'Hold Ctrl / Cmd for multi-select';
                deptCountBadge.style.color = 'var(--ntxt-color)';
            }
        }

        function selectGST() {
            Array.from(deptSelect.options).forEach(opt => {
                opt.selected = (opt.value === 'gst');
            });
            updateDeptCount();
        }

        function selectAllDepts() {
            Array.from(deptSelect.options).forEach(opt => {
                opt.selected = true;
            });
            updateDeptCount();
        }

        function clearDepts() {
            Array.from(deptSelect.options).forEach(opt => {
                opt.selected = false;
            });
            updateDeptCount();
        }

        // Drag & Drop File Handling
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const fileInfoBadge = document.getElementById('fileInfoBadge');
        const fileNameDisplay = document.getElementById('fileNameDisplay');
        const fileSizeDisplay = document.getElementById('fileSizeDisplay');
        const urlInput = document.getElementById('urlInput');

        ['dragenter', 'dragover'].forEach(eventName => {
            dropZone.addEventListener(eventName, (e) => {
                e.preventDefault();
                dropZone.classList.add('dragover');
            });
        });

        ['dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, (e) => {
                e.preventDefault();
                dropZone.classList.remove('dragover');
            });
        });

        dropZone.addEventListener('drop', (e) => {
            const files = e.dataTransfer.files;
            if (files.length > 0) {
                fileInput.files = files;
                updateFileInfo();
            }
        });

        fileInput.addEventListener('change', updateFileInfo);

        function updateFileInfo() {
            if (fileInput.files.length > 0) {
                const file = fileInput.files[0];
                fileNameDisplay.innerText = file.name;
                const sizeMB = (file.size / 1024 / 1024).toFixed(2);
                fileSizeDisplay.innerText = `(${sizeMB} MB)`;
                fileInfoBadge.style.display = 'inline-flex';
                urlInput.value = '';
                urlInput.disabled = true;
                urlInput.style.opacity = '0.5';
            } else {
                fileInfoBadge.style.display = 'none';
                urlInput.disabled = false;
                urlInput.style.opacity = '1';
            }
        }

        urlInput.addEventListener('input', () => {
            if (urlInput.value.trim().length > 0) {
                fileInput.value = '';
                fileInfoBadge.style.display = 'none';
            }
        });

        // Filter uploaded course cards
        function filterCourseCards() {
            const query = document.getElementById('courseFilterInput').value.toLowerCase().trim();
            const cards = document.querySelectorAll('.course-tag-card');
            let visibleCount = 0;

            cards.forEach(card => {
                const code = card.getAttribute('data-code');
                if (code.includes(query)) {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            const noMatch = document.getElementById('noMatchMessage');
            if (noMatch) {
                noMatch.style.display = (visibleCount === 0 && cards.length > 0) ? 'block' : 'none';
            }
        }
    </script>
</body>
</html>
