<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta charset="UTF-8">
    <title>Subscriptions - Admin Panel</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <link rel="manifest" href="/manifest.json">
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').catch(err => console.log('SW setup failed: ', err));
            });
        }
    </script>
<link rel="icon" media="(prefers-color-scheme: light)" href="/acct/img/favicon-dark.png">
    <link rel="icon" media="(prefers-color-scheme: dark)" href="/acct/img/favicon-light.png">
</head>
<body class="dashboard-body admin-body">
    <%- include('./partials/admin_sidebar', { active_page: 'admin_subs' }) %>

    <main class="admin-main-content">
        <header class="admin-topbar">
            <div style="display: flex; align-items: center; gap: 14px;">
                <button class="admin-mobile-toggle" onclick="toggleAdminNav()" aria-label="Toggle Navigation">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                </button>
                <div>
                    <h1 class="admin-title">Subscriptions & Access Control</h1>
                    <p class="admin-subtitle">Manage candidate access privileges, account locking, and plan validity.</p>
                </div>
            </div>
            <div class="admin-topbar-actions">
                <a href="/admin" class="btn btn-outline" style="border-radius: 8px; font-weight: 600; font-size: 0.85rem; padding: 8px 14px; text-decoration: none;">
                    &larr; Overview
                </a>
            </div>
        </header>

        <h2>Subscription Tracker</h2>
        <div class="glass-panel">
            <div class="table-responsive">
                <table class="styled-table">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Email</th>
                            <th>Plan</th>
                            <th>Expiry Date</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (subs.length === 0) { %>
                            <tr><td colspan="5" class="text-center">No users found.</td></tr>
                        <% } else { %>
                            <% 
                            const currentDate = new Date();
                            currentDate.setHours(0, 0, 0, 0); // start of today
                            
                            subs.forEach(s => { 
                                let status_color = 'var(--text-muted)';
                                let status_text = 'Unpaid';
                                
                                if (s.has_paid) {
                                    if (!s.expiry_date || new Date(s.expiry_date) <= currentDate) {
                                        status_color = 'var(--error)';
                                        status_text = 'Expired';
                                    } else {
                                        const expiryDate = new Date(s.expiry_date);
                                        const diff = expiryDate.getTime() - currentDate.getTime();
                                        const days = Math.round(diff / (1000 * 60 * 60 * 24));
                                        
                                        if (days <= 30) {
                                            status_color = 'orange';
                                            status_text = `Expiring in ${days} days`;
                                        } else {
                                            status_color = 'var(--success)';
                                            status_text = 'Active';
                                        }
                                    }
                                }
                            %>
                            <tr>
                                <td><%= s.full_name %></td>
                                <td><%= s.email %></td>
                                <td style="text-transform: capitalize;"><%= s.subscription_plan %></td>
                                <td><%= s.expiry_date ? new Date(s.expiry_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'N/A' %></td>
                                <td style="color: <%= status_color %>; font-weight: bold;"><%= status_text %></td>
                                <td>
                                    <% if (s.account_locked) { %>
                                        <form action="/admin/lock_user" method="POST" style="display:inline;">
                                            <input type="hidden" name="user_id" value="<%= s.id %>">
                                            <input type="hidden" name="locked" value="">
                                            <button type="submit" class="btn" style="background: var(--success); padding: 5px 10px; font-size: 0.8rem;">Unlock</button>
                                        </form>
                                    <% } else if (status_text === 'Unpaid' || status_text === 'Expired') { %>
                                        <form action="/admin/lock_user" method="POST" style="display:inline;">
                                            <input type="hidden" name="user_id" value="<%= s.id %>">
                                            <input type="hidden" name="locked" value="1">
                                            <button type="submit" class="btn btn-ai" style="padding: 5px 10px; font-size: 0.8rem;">Lock Account</button>
                                        </form>
                                    <% } else { %>
                                        <span style="color: var(--text-muted); font-size: 0.8rem;">Active</span>
                                    <% } %>
                                </td>
                            </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</body>
</html>





