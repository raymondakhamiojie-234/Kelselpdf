<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta charset="UTF-8">
    <title>Subscriptions & Access Control - Executive Admin Console</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <link rel="manifest" href="/manifest.json">
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').catch(err => console.log('SW setup failed: ', err));
            });
        }
    </script>
    <link rel="icon" media="(prefers-color-scheme: light)" href="/acct/img/favicon-dark.png">
    <link rel="icon" media="(prefers-color-scheme: dark)" href="/acct/img/favicon-light.png">
</head>
<body class="dashboard-body admin-body">
    <%- include('./partials/admin_sidebar', { active_page: 'admin_subs' }) %>

    <main class="admin-main-content">
        <!-- Top Executive Bar -->
        <header class="admin-topbar">
            <div style="display: flex; align-items: center; gap: 14px;">
                <button class="admin-mobile-toggle" onclick="toggleAdminNav()" aria-label="Toggle Navigation">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                </button>
                <div>
                    <h1 class="admin-title">Subscriptions & Access Control</h1>
                    <p class="admin-subtitle">Live candidate membership tracking, validity countdowns, and security locks.</p>
                </div>
            </div>
            <div class="admin-topbar-actions">
                <button onclick="exportSubscriptionsCSV()" class="btn btn-outline" style="border-radius: 8px; font-weight: 600; font-size: 0.85rem; padding: 8px 14px; display: inline-flex; align-items: center; gap: 6px; cursor: pointer;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    <span>Export CSV</span>
                </button>
                <a href="/admin" class="btn btn-outline" style="border-radius: 8px; font-weight: 600; font-size: 0.85rem; padding: 8px 14px; text-decoration: none;">
                    &larr; Overview
                </a>
            </div>
        </header>

        <%
            const today = new Date();
            today.setHours(0, 0, 0, 0);

            let activeCount = 0;
            let expiringCount = 0;
            let expiredCount = 0;
            let lockedCount = 0;

            subs.forEach(s => {
                if (s.account_locked) lockedCount++;
                if (s.has_paid) {
                    if (!s.expiry_date || new Date(s.expiry_date) < today) {
                        expiredCount++;
                    } else {
                        const diffDays = Math.round((new Date(s.expiry_date) - today) / (1000 * 60 * 60 * 24));
                        if (diffDays <= 30) {
                            expiringCount++;
                        }
                        activeCount++;
                    }
                } else {
                    expiredCount++;
                }
            });
        %>

        <!-- KPI Metrics Grid -->
        <div class="kpi-grid">
            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Active VIP Members</div>
                        <div class="kpi-value"><%= activeCount %></div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(16, 185, 129, 0.12); color: #10b981;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #10b981; font-weight: 600;">● Active Access</span>
                    <span>&bull; Valid Passports</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Expiring Soon (≤30 Days)</div>
                        <div class="kpi-value" style="color: <%= expiringCount > 0 ? '#f59e0b' : 'var(--text-color)' %>;"><%= expiringCount %></div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(245, 158, 11, 0.12); color: #f59e0b;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #f59e0b; font-weight: 600;">Renewal Target</span>
                    <span>&bull; Action Recommended</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Expired or Free</div>
                        <div class="kpi-value"><%= expiredCount %></div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(148, 163, 184, 0.12); color: #94a3b8;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span>Unsubscribed / Lapsed</span>
                    <span>&bull; Candidates</span>
                </div>
            </div>

            <div class="kpi-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="kpi-title">Locked Accounts</div>
                        <div class="kpi-value" style="color: <%= lockedCount > 0 ? '#ef4444' : 'var(--text-color)' %>;"><%= lockedCount %></div>
                    </div>
                    <div class="kpi-icon-pill" style="background: rgba(239, 68, 68, 0.12); color: #ef4444;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 9.9-1"></path></svg>
                    </div>
                </div>
                <div class="kpi-trend">
                    <span style="color: #ef4444; font-weight: 600;"><%= lockedCount %> Restricted</span>
                    <span>&bull; Portal Access Blocked</span>
                </div>
            </div>
        </div>

        <!-- Subscriptions Container -->
        <div class="admin-panel">
            <!-- Filter Toolbar -->
            <div class="admin-filter-bar">
                <div class="admin-search-box">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="text" id="subSearch" placeholder="Search candidate name, email, department..." onkeyup="filterSubscriptions()">
                </div>
                <div class="admin-filter-group">
                    <select id="statusFilter" class="admin-select" onchange="filterSubscriptions()">
                        <option value="all">All Statuses</option>
                        <option value="active">Active VIP</option>
                        <option value="expiring">Expiring Soon</option>
                        <option value="expired">Expired</option>
                        <option value="unpaid">Unpaid / Free</option>
                        <option value="locked">Locked Accounts</option>
                    </select>

                    <select id="planFilter" class="admin-select" onchange="filterSubscriptions()">
                        <option value="all">All Plans</option>
                        <% 
                            const plans = Array.from(new Set(subs.map(s => s.subscription_plan).filter(Boolean)));
                            plans.forEach(plan => { 
                        %>
                            <option value="<%= plan.toLowerCase() %>"><%= plan %></option>
                        <% }); %>
                    </select>

                    <span style="font-size: 0.85rem; color: var(--ntxt-color); padding-left: 6px;">
                        Showing <strong id="visibleCount" style="color: var(--text-color);"><%= subs.length %></strong> of <%= subs.length %>
                    </span>
                </div>
            </div>

            <!-- Responsive Table -->
            <div class="table-responsive">
                <table class="data-table" id="subsTable">
                    <thead>
                        <tr>
                            <th>Candidate</th>
                            <th>Academic Profile</th>
                            <th>Current Plan</th>
                            <th>Validity & Expiry</th>
                            <th>Access Status</th>
                            <th style="text-align: right;">Security Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (subs.length === 0) { %>
                            <tr>
                                <td colspan="6" style="text-align: center; padding: 3rem 1rem; color: var(--ntxt-color);">
                                    <div style="font-size: 2.2rem; margin-bottom: 8px;">🎓</div>
                                    <div style="font-weight: 700; font-size: 1.05rem; color: var(--text-color);">No candidates registered in database</div>
                                    <p style="margin: 4px 0 0 0; font-size: 0.85rem;">Registered candidates will appear here with their subscription status.</p>
                                </td>
                            </tr>
                        <% } else { %>
                            <% subs.forEach((s, idx) => { 
                                const isLocked = !!s.account_locked;
                                let statusKey = 'unpaid';
                                let statusLabel = 'Unpaid';
                                let statusClass = 'gray';
                                let daysLeft = null;

                                if (isLocked) {
                                    statusKey = 'locked';
                                    statusLabel = 'Account Locked';
                                    statusClass = 'danger';
                                } else if (s.has_paid) {
                                    if (!s.expiry_date || new Date(s.expiry_date) < today) {
                                        statusKey = 'expired';
                                        statusLabel = 'Expired';
                                        statusClass = 'danger';
                                    } else {
                                        const diff = new Date(s.expiry_date) - today;
                                        daysLeft = Math.round(diff / (1000 * 60 * 60 * 24));
                                        if (daysLeft <= 30) {
                                            statusKey = 'expiring';
                                            statusLabel = `Expiring (${daysLeft}d)`;
                                            statusClass = 'warning';
                                        } else {
                                            statusKey = 'active';
                                            statusLabel = 'Active VIP';
                                            statusClass = 'success';
                                        }
                                    }
                                }

                                let deptName = s.department_id || 'General';
                                if (deptName === '1') deptName = 'Computer Science';
                                else if (deptName === '2') deptName = 'Electrical Engineering';
                                else if (deptName === '3') deptName = 'Business Administration';

                                const initials = s.full_name ? s.full_name.split(' ').map(n=>n[0]).slice(0,2).join('').toUpperCase() : 'U';
                            %>
                            <tr class="sub-row" 
                                data-name="<%= (s.full_name || '').toLowerCase() %>" 
                                data-email="<%= (s.email || '').toLowerCase() %>" 
                                data-dept="<%= (deptName || '').toLowerCase() %>"
                                data-status="<%= statusKey %>"
                                data-plan="<%= (s.subscription_plan || '').toLowerCase() %>">
                                <td>
                                    <div style="display: flex; align-items: center; gap: 12px;">
                                        <div class="user-avatar-initial" style="background: <%= idx % 3 === 0 ? 'linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%)' : (idx % 3 === 1 ? 'linear-gradient(135deg, #10b981 0%, #059669 100%)' : 'linear-gradient(135deg, #ec4899 0%, #be185d 100%)') %>;">
                                            <%= initials %>
                                        </div>
                                        <div>
                                            <strong style="color: var(--text-color); font-size: 0.92rem; display: block;"><%= s.full_name || 'Anonymous User' %></strong>
                                            <span style="color: var(--ntxt-color); font-size: 0.8rem;"><%= s.email || 'N/A' %></span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div style="font-size: 0.88rem; color: var(--text-color); font-weight: 600;">
                                        <%= s.level ? `${s.level} Level` : 'Undergraduate' %>
                                    </div>
                                    <span style="font-size: 0.78rem; color: var(--ntxt-color);">
                                        <%= deptName %>
                                    </span>
                                </td>
                                <td>
                                    <span class="badge-pill purple" style="text-transform: capitalize;">
                                        <%= s.subscription_plan || 'Free Tier' %>
                                    </span>
                                </td>
                                <td>
                                    <% if (s.expiry_date) { %>
                                        <div style="font-size: 0.88rem; color: var(--text-color);">
                                            <%= new Date(s.expiry_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                        </div>
                                        <% if (daysLeft !== null && daysLeft >= 0) { %>
                                            <small style="color: <%= daysLeft <= 14 ? '#ef4444' : '#10b981' %>; font-size: 0.75rem; font-weight: 600;">
                                                <%= daysLeft === 0 ? 'Expires today' : `${daysLeft} days remaining` %>
                                            </small>
                                        <% } else { %>
                                            <small style="color: #ef4444; font-size: 0.75rem; font-weight: 600;">
                                                Expired
                                            </small>
                                        <% } %>
                                    <% } else { %>
                                        <span style="color: var(--ntxt-color); font-size: 0.82rem;">Never activated</span>
                                    <% } %>
                                </td>
                                <td>
                                    <span class="badge-pill <%= statusClass %>">
                                        <% if (statusKey === 'active') { %><span class="status-dot"></span><% } %>
                                        <% if (statusKey === 'locked') { %>🔒 <% } %>
                                        <%= statusLabel %>
                                    </span>
                                </td>
                                <td style="text-align: right;">
                                    <% if (isLocked) { %>
                                        <form action="/admin/lock_user" method="POST" style="margin: 0; display: inline-block;">
                                            <input type="hidden" name="user_id" value="<%= s.id %>">
                                            <input type="hidden" name="locked" value="">
                                            <button type="submit" class="btn btn-outline" style="border-radius: 8px; font-weight: 600; font-size: 0.8rem; padding: 6px 12px; color: #10b981; border-color: rgba(16, 185, 129, 0.4); display: inline-flex; align-items: center; gap: 5px; cursor: pointer;">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                                <span>Unlock</span>
                                            </button>
                                        </form>
                                    <% } else { %>
                                        <form action="/admin/lock_user" method="POST" style="margin: 0; display: inline-block;" onsubmit="return confirm('Restrict <%= s.full_name %> from accessing tests and study files?');">
                                            <input type="hidden" name="user_id" value="<%= s.id %>">
                                            <input type="hidden" name="locked" value="1">
                                            <button type="submit" class="btn btn-outline" style="border-radius: 8px; font-weight: 600; font-size: 0.8rem; padding: 6px 12px; color: #ef4444; border-color: rgba(239, 68, 68, 0.4); display: inline-flex; align-items: center; gap: 5px; cursor: pointer;">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 9.9-1"></path></svg>
                                                <span>Lock Account</span>
                                            </button>
                                        </form>
                                    <% } %>
                                </td>
                            </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
                <div id="noMatchMessage" style="display: none; text-align: center; padding: 2.5rem 1rem; color: var(--ntxt-color);">
                    <div style="font-size: 2rem; margin-bottom: 6px;">🔍</div>
                    <div style="font-weight: 700; color: var(--text-color);">No matching candidate subscriptions</div>
                    <p style="margin: 4px 0 0 0; font-size: 0.85rem;">Try adjusting your search terms or status filter.</p>
                </div>
            </div>
        </div>
    </main>

    <script>
        function filterSubscriptions() {
            const query = document.getElementById('subSearch').value.toLowerCase().trim();
            const statusFilter = document.getElementById('statusFilter').value.toLowerCase();
            const planFilter = document.getElementById('planFilter').value.toLowerCase();
            const rows = document.querySelectorAll('.sub-row');
            let visible = 0;

            rows.forEach(row => {
                const name = row.getAttribute('data-name') || '';
                const email = row.getAttribute('data-email') || '';
                const dept = row.getAttribute('data-dept') || '';
                const status = row.getAttribute('data-status') || '';
                const plan = row.getAttribute('data-plan') || '';

                const matchesQuery = !query || name.includes(query) || email.includes(query) || dept.includes(query);
                const matchesStatus = statusFilter === 'all' || status === statusFilter;
                const matchesPlan = planFilter === 'all' || plan === planFilter;

                if (matchesQuery && matchesStatus && matchesPlan) {
                    row.style.display = '';
                    visible++;
                } else {
                    row.style.display = 'none';
                }
            });

            const countEl = document.getElementById('visibleCount');
            if (countEl) countEl.textContent = visible;

            const noMatch = document.getElementById('noMatchMessage');
            if (noMatch) {
                noMatch.style.display = (visible === 0 && rows.length > 0) ? 'block' : 'none';
            }
        }

        function exportSubscriptionsCSV() {
            const rows = Array.from(document.querySelectorAll('#subsTable tr'));
            if (!rows.length) return;
            let csv = [];
            rows.forEach(row => {
                if (row.style.display === 'none') return;
                const cols = Array.from(row.querySelectorAll('th, td'));
                // Exclude last column (actions)
                const dataCols = cols.slice(0, cols.length - 1);
                const rowData = dataCols.map(col => {
                    let text = col.innerText.replace(/[\n\r]+/g, ' ').replace(/"/g, '""').trim();
                    return `"${text}"`;
                });
                csv.push(rowData.join(','));
            });
            const blob = new Blob([csv.join('\n')], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = `kelsel-subscriptions-ledger-${new Date().toISOString().split('T')[0]}.csv`;
            link.click();
        }
    </script>
</body>
</html>
