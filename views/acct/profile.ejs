<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta charset="UTF-8">
    <title>Profile - KelselPDF</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <link rel="manifest" href="/manifest.json">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.0/vanilla-tilt.min.js"></script>
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').catch(err => console.log('SW setup failed: ', err));
            });
        }
    </script>
    <style>
        .dashboard-body {
            position: relative;
            background: transparent; 
        }
        
        .ambient-bg {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            z-index: -1;
            overflow: hidden;
            pointer-events: none;
            background: var(--cbg-color);
        }
        .orb {
            position: absolute; border-radius: 50%; filter: blur(100px); opacity: 0.3; will-change: transform;
        }
        .orb-1 { width: 40vw; height: 40vw; background: rgba(33, 150, 243, 0.4); top: -10%; left: -10%; }
        .orb-2 { width: 35vw; height: 35vw; background: rgba(156, 39, 176, 0.3); bottom: -10%; right: -10%; }

        .glass-panel-3d {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 2.5rem;
            color: var(--txt-color);
            position: relative;
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
            max-width: 700px; 
            margin: 0 auto 3rem;
            opacity: 0;
            transform: translateY(30px);
        }
        .dark-mode .glass-panel-3d {
            background: rgba(0, 0, 0, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .dashboard-header {
            padding: 2rem 1.5rem 1rem;
            max-width: 700px;
            margin: 0 auto;
            text-align: center;
            opacity: 0;
        }
        .dashboard-header h2 {
            font-size: 2.5rem;
            margin: 0;
            background: linear-gradient(135deg, var(--cta-color), var(--success));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .dashboard-header p {
            color: var(--ntxt-color);
            font-size: 1.1rem;
            margin-top: 0.5rem;
        }

        .btn-3d {
            background: linear-gradient(135deg, var(--cta-color), #2196f3);
            border: none;
            color: white;
            padding: 1rem 2rem;
            border-radius: 12px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(33, 150, 243, 0.3);
            transition: transform 0.2s, box-shadow 0.2s;
            display: inline-block;
            margin-top: 1rem;
        }
        .btn-3d:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(33, 150, 243, 0.4);
        }

        .form-group input, .form-group select {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: var(--txt-color);
            border-radius: 8px;
            transition: border-color 0.3s;
        }
        .dark-mode .form-group input, .dark-mode .form-group select {
            background: rgba(0, 0, 0, 0.2);
        }
        .form-group input:focus, .form-group select:focus {
            border-color: var(--cta-color);
            outline: none;
        }
    </style>
</head>
<body class="dashboard-body">
    <div class="ambient-bg">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
    </div>

    <%- include('partials/sidebar', { active_page: 'profile' }) %>

    <main class="main-content">
        <%- include('partials/app_header') %>

        <div class="dashboard-header" id="profile-header">
            <h2>User Profile</h2>
            <p>Manage your account details and preferences.</p>
        </div>

        <div class="glass-panel-3d" id="profile-panel" data-tilt data-tilt-max="2" data-tilt-speed="400" data-tilt-glare data-tilt-max-glare="0.1">
            <% if (typeof success !== 'undefined' && success) { %> <div class="alert alert-success" style="border-radius:12px;"><%= success %></div> <% } %>
            <% if (typeof error !== 'undefined' && error) { %> <div class="alert alert-error" style="border-radius:12px;"><%= error %></div> <% } %>

            <form method="POST" action="/profile">
                <div style="display: flex; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap;">
                    <div class="form-group" style="flex: 1; min-width: 200px;">
                        <label>First Name</label>
                        <input type="text" name="full_name" value="<%= user.full_name %>" required>
                    </div>
                    <div class="form-group" style="flex: 1; min-width: 200px;">
                        <label>Last Name</label>
                        <input type="text" name="lastname" value="<%= user.lastname %>" required>
                    </div>
                </div>

                <div class="form-group">
                    <label>Email Address</label>
                    <input type="email" value="<%= user.email %>" disabled style="opacity: 0.7; cursor: not-allowed;">
                </div>

                <div style="display: flex; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap;">
                    <div class="form-group" style="flex: 1; min-width: 200px;">
                        <label>Phone Number</label>
                        <input type="tel" name="phone" value="<%= user.phone %>">
                    </div>
                    <div class="form-group" style="flex: 1; min-width: 200px;">
                        <label>Institution</label>
                        <input type="text" name="institution" value="<%= user.institution %>" placeholder="e.g. Ambrose Alli University">
                    </div>
                </div>

                <div class="form-group">
                    <label>Department</label>
                    <input type="text" name="department" value="<%= user.department %>" placeholder="e.g. Computer Science">
                </div>

                <div class="form-group">
                    <label>Level</label>
                    <select name="level">
                        <option value="">Select Level</option>
                        <option value="100" <%= user.level == '100' ? 'selected' : '' %>>100 Level</option>
                        <option value="200" <%= user.level == '200' ? 'selected' : '' %>>200 Level</option>
                        <option value="300" <%= user.level == '300' ? 'selected' : '' %>>300 Level</option>
                        <option value="400" <%= user.level == '400' ? 'selected' : '' %>>400 Level</option>
                        <option value="500" <%= user.level == '500' ? 'selected' : '' %>>500 Level</option>
                    </select>
                </div>

                <div style="text-align: right; margin-top: 2rem;">
                    <button type="submit" class="btn-3d">Save Profile Updates</button>
                </div>
            </form>
        </div>
    </main>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            gsap.to("#profile-header", { opacity: 1, y: 0, duration: 1, ease: "power3.out" });
            gsap.to("#profile-panel", { opacity: 1, y: 0, duration: 1, ease: "back.out(1.5)", delay: 0.2 });

            gsap.to(".orb-1", {
                x: "10vw", y: "5vh", rotation: 45, duration: 20, repeat: -1, yoyo: true, ease: "sine.inOut"
            });
            gsap.to(".orb-2", {
                x: "-10vw", y: "-10vh", rotation: -45, duration: 25, repeat: -1, yoyo: true, ease: "sine.inOut"
            });
        });
    </script>
</body>
</html>
