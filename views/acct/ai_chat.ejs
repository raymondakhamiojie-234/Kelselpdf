<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>AI Tutor - KelselPDF</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css?v=3">
    <script src="/theme.js"></script>
    <link rel="manifest" href="/manifest.json">
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <style>
        .chat-container {
            display: flex;
            height: calc(100vh - 140px);
            background: var(--neu-color);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            margin-top: 1rem;
            border: 1px solid var(--cbg-color-2);
        }

        .chat-sidebar {
            width: 300px;
            border-right: 1px solid var(--cbg-color-2);
            display: flex;
            flex-direction: column;
            background: var(--cbg-color);
        }

        .chat-sidebar-header {
            padding: 1rem;
            border-bottom: 1px solid var(--cbg-color-2);
        }

        .new-chat-btn {
            width: 100%;
            padding: 0.75rem;
            background: var(--cta-color);
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 500;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            transition: all 0.2s;
        }

        .new-chat-btn:hover {
            background: var(--cta-color-hover);
        }

        .chat-sessions {
            flex: 1;
            overflow-y: auto;
            padding: 1rem 0;
        }

        .session-item {
            padding: 0.75rem 1rem;
            cursor: pointer;
            transition: background 0.2s;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            color: var(--text-color);
            text-decoration: none;
        }

        .session-item:hover, .session-item.active {
            background: var(--cbg-color-2);
        }

        .session-title {
            font-size: 0.9rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .chat-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: var(--neu-color);
            min-width: 0;
        }

        .chat-messages {
            flex: 1;
            padding: 2rem;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .message {
            display: flex;
            gap: 1rem;
            width: 100%;
        }

        .message.assistant {
            justify-content: flex-start;
        }

        .message.user {
            justify-content: flex-end;
            flex-direction: row-reverse;
        }

        .message-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--cta-color);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            flex-shrink: 0;
            margin-top: 0.25rem;
        }

        .message.assistant .message-avatar {
            background: #20b2aa;
        }

        .message-content {
            padding: 1rem 1.25rem;
            border-radius: 12px;
            background: var(--bg-color);
            line-height: 1.6;
            color: var(--ntxt-color);
            word-break: break-word;
            overflow-wrap: break-word;
            max-width: 75%;
            min-width: 0;
        }

        .message.user .message-content {
            background: var(--cta-color);
            color: white;
            border-top-right-radius: 4px;
        }

        .message.assistant .message-content {
            border-top-left-radius: 4px;
            border: 1px solid var(--cbg-color-2);
        }

        /* Markdown Styles for AI */
        .message-content p { margin-top: 0; margin-bottom: 0.75rem; }
        .message-content p:last-child { margin-bottom: 0; }
        .message-content pre { background: #1e1e1e; color: #fff; padding: 1rem; border-radius: 8px; overflow-x: auto; margin: 1rem 0; }
        .message-content code { font-family: monospace; background: rgba(0,0,0,0.05); padding: 0.2rem 0.4rem; border-radius: 4px; }
        .message-content pre code { background: none; padding: 0; }
        .message-content ul, .message-content ol { padding-left: 1.5rem; margin-bottom: 1rem; }
        .message.user .message-content code { background: rgba(255,255,255,0.2); }

        .chat-input-area {
            padding: 1.5rem;
            border-top: 1px solid var(--cbg-color-2);
            background: var(--neu-color);
        }

        .input-wrapper {
            display: flex;
            gap: 1rem;
            background: var(--bg-color);
            border: 1px solid var(--cbg-color-2);
            border-radius: 12px;
            padding: 0.5rem 1rem;
            align-items: flex-end;
        }

        .input-wrapper:focus-within {
            border-color: var(--cta-color);
            box-shadow: 0 0 0 2px rgba(9, 105, 218, 0.1);
        }

        #messageInput {
            flex: 1;
            border: none;
            background: transparent;
            resize: none;
            padding: 0.75rem 0;
            font-family: inherit;
            font-size: 1rem;
            max-height: 200px;
            outline: none;
        }

        #sendBtn {
            background: var(--cta-color);
            color: white;
            border: none;
            border-radius: 8px;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            margin-bottom: 0.5rem;
            transition: all 0.2s;
        }

        #sendBtn:hover:not(:disabled) {
            background: var(--cta-color-hover);
        }

        #sendBtn:disabled {
            background: #ccc;
            cursor: not-allowed;
        }

        .loading-dots {
            display: inline-block;
        }
        .loading-dots::after {
            content: '.';
            animation: dots 1.5s steps(5, end) infinite;
        }
        @keyframes dots {
            0%, 20% { content: '.'; }
            40% { content: '..'; }
            60% { content: '...'; }
            80%, 100% { content: ''; }
        }

        .empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
            text-align: center;
            color: var(--text-color);
            opacity: 0.6;
        }

        .empty-state svg {
            width: 64px;
            height: 64px;
            margin-bottom: 1rem;
            opacity: 0.5;
        }

        @media (max-width: 768px) {
            .chat-container {
                flex-direction: column;
                height: calc(100vh - 80px);
                margin-top: 0;
                border-radius: 0;
                border-left: none;
                border-right: none;
            }
            .chat-sidebar {
                width: 100%;
                height: 150px;
                border-right: none;
                border-bottom: 1px solid var(--cbg-color-2);
            }
            .chat-messages {
                padding: 1rem;
            }
            .message {
                max-width: 95%;
            }
        }
    </style>
</head>
<body class="dashboard-body">
    <%- include('partials/sidebar', { active_page: 'ai_chat' }) %>

    <main class="main-content">
        <%- include('partials/app_header') %>

        <div style="padding: 0 1.5rem;">
            <h2 style="margin: 0; font-size: 1.5rem; color: var(--ntxt-color);">AI Tutor</h2>
            <p style="color: var(--text-color); opacity: 0.7; margin-top: 0.5rem;">Your personalized AI assistant knows your exam progress and study materials.</p>
        </div>

        <div class="chat-container" style="margin: 1rem 1.5rem;">
            <!-- Sidebar -->
            <div class="chat-sidebar">
                <div class="chat-sidebar-header">
                    <button class="new-chat-btn" onclick="startNewSession()">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        New Chat
                    </button>
                </div>
                <div class="chat-sessions" id="sessionList">
                    <% sessions.forEach(session => { %>
                        <div class="session-item" onclick="loadSession('<%= session.id %>', this)">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                            <span class="session-title"><%= session.title %></span>
                        </div>
                    <% }) %>
                </div>
            </div>

            <!-- Main Chat Area -->
            <div class="chat-main">
                <div class="chat-messages" id="chatBox">
                    <div class="empty-state">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2a10 10 0 1 0 10 10H12V2z"></path><path d="M12 12L2.1 14.9"></path><path d="M12 12L14.9 21.9"></path></svg>
                        <h3>Welcome to AI Tutor!</h3>
                        <p>Select a chat or start a new one.</p>
                        <p style="font-size: 0.85rem; margin-top: 1rem;">I have access to your mock exam scores and uploaded materials to better assist you.</p>
                    </div>
                </div>
                
                <div class="chat-input-area" style="display: none;" id="inputArea">
                    <div class="input-wrapper">
                        <textarea id="messageInput" rows="1" placeholder="Type your message here..." oninput="autoResize(this)"></textarea>
                        <button id="sendBtn" onclick="sendMessage()">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                        </button>
                    </div>
                    <div style="font-size: 0.75rem; text-align: center; color: var(--text-color); opacity: 0.5; margin-top: 0.5rem;">
                        AI can make mistakes. Verify important academic information.
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script>
        let currentSessionId = null;
        const userInitials = "<%= user.full_name ? user.full_name.charAt(0) : 'U' %>";

        function autoResize(textarea) {
            textarea.style.height = 'auto';
            textarea.style.height = (textarea.scrollHeight < 200 ? textarea.scrollHeight : 200) + 'px';
        }

        async function startNewSession() {
            try {
                const res = await fetch('/api/ai-chat/session', { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    currentSessionId = data.session_id;
                    document.getElementById('chatBox').innerHTML = '';
                    document.getElementById('inputArea').style.display = 'block';
                    
                    // Add to sidebar
                    const sessionList = document.getElementById('sessionList');
                    const newItem = document.createElement('div');
                    newItem.className = 'session-item active';
                    newItem.onclick = function() { loadSession(currentSessionId, this); };
                    newItem.innerHTML = `
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                        <span class="session-title">New Conversation</span>
                    `;
                    
                    // Remove active from others
                    document.querySelectorAll('.session-item').forEach(el => el.classList.remove('active'));
                    sessionList.prepend(newItem);

                    // Add welcome message
                    appendMessage('assistant', "Hello! I'm your AI Tutor. How can I help you study today?");
                }
            } catch (err) {
                alert('Error creating session');
            }
        }

        async function loadSession(id, el) {
            currentSessionId = id;
            document.querySelectorAll('.session-item').forEach(e => e.classList.remove('active'));
            if(el) el.classList.add('active');

            document.getElementById('chatBox').innerHTML = '<div class="empty-state"><div class="loading-dots">Loading</div></div>';
            document.getElementById('inputArea').style.display = 'block';

            try {
                const res = await fetch(`/api/ai-chat/session/${id}`);
                const data = await res.json();
                if (data.success) {
                    document.getElementById('chatBox').innerHTML = '';
                    if (data.messages.length === 0) {
                        appendMessage('assistant', "Hello! I'm your AI Tutor. How can I help you study today?");
                    } else {
                        data.messages.forEach(msg => {
                            appendMessage(msg.role, msg.content, false);
                        });
                    }
                    scrollToBottom();
                }
            } catch (err) {
                document.getElementById('chatBox').innerHTML = '<div class="empty-state" style="color:red">Failed to load messages</div>';
            }
        }

        function appendMessage(role, content, renderMarkdown = true) {
            const chatBox = document.getElementById('chatBox');
            const msgDiv = document.createElement('div');
            msgDiv.className = `message ${role}`;
            
            let avatar = role === 'assistant' ? 'AI' : userInitials;
            let displayContent = role === 'assistant' && renderMarkdown ? marked.parse(content) : content;
            if (role === 'user') {
                // Escape HTML for user input
                displayContent = content.replace(/</g, '&lt;').replace(/>/g, '&gt;');
            }

            msgDiv.innerHTML = `
                <div class="message-avatar">${avatar}</div>
                <div class="message-content">${displayContent}</div>
            `;
            chatBox.appendChild(msgDiv);
            scrollToBottom();
            return msgDiv;
        }

        function scrollToBottom() {
            const chatBox = document.getElementById('chatBox');
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        async function sendMessage() {
            if (!currentSessionId) return;
            
            const input = document.getElementById('messageInput');
            const message = input.value.trim();
            if (!message) return;

            const sendBtn = document.getElementById('sendBtn');
            input.value = '';
            input.style.height = 'auto';
            input.disabled = true;
            sendBtn.disabled = true;

            appendMessage('user', message);
            
            // Add loading indicator
            const loadingMsg = appendMessage('assistant', '<span class="loading-dots">Thinking</span>', false);

            try {
                const res = await fetch('/api/ai-chat/message', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ session_id: currentSessionId, message })
                });
                const data = await res.json();
                
                loadingMsg.remove();
                
                if (data.success) {
                    appendMessage('assistant', data.reply);
                    if (data.newTitle) {
                        const activeSession = document.querySelector('.session-item.active .session-title');
                        if (activeSession) activeSession.textContent = data.newTitle;
                    }
                } else {
                    appendMessage('assistant', 'Sorry, I encountered an error: ' + (data.error || 'Unknown error'));
                }
            } catch (err) {
                loadingMsg.remove();
                appendMessage('assistant', 'Sorry, network error occurred.');
            } finally {
                input.disabled = false;
                sendBtn.disabled = false;
                input.focus();
            }
        }

        // Handle Enter key
        document.getElementById('messageInput').addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        });
    </script>
</body>
</html>
