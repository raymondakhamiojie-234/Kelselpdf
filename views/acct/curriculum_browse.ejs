<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>AAU Curriculum - KelselPDF</title>
    <link rel="stylesheet" href="/style.css?v=5">
    <script src="/theme.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.0/vanilla-tilt.min.js"></script>
    <style>
        .dashboard-body { position: relative; background: transparent; }
        
        .ambient-bg {
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
            z-index: -1; overflow: hidden; pointer-events: none; background: var(--cbg-color);
        }
        .orb {
            position: absolute; border-radius: 50%; filter: blur(100px); opacity: 0.3; will-change: transform;
        }
        .orb-1 { width: 40vw; height: 40vw; background: rgba(33, 150, 243, 0.4); top: -10%; left: -10%; }
        .orb-2 { width: 35vw; height: 35vw; background: rgba(156, 39, 176, 0.3); bottom: -10%; right: -10%; }

        .curriculum-container { padding: 1.5rem; max-width: 1200px; margin: 0 auto; opacity: 0; }
        .breadcrumb { margin-bottom: 2rem; font-size: 0.95rem; color: var(--ntxt-color); display: flex; gap: 8px; flex-wrap: wrap; background: rgba(255,255,255,0.02); padding: 10px 20px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05); }
        .breadcrumb span { cursor: pointer; color: var(--cta-color); font-weight: 500; }
        .breadcrumb span:hover { text-decoration: underline; color: #fff; }
        
        .grid-view { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; }
        
        .glass-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 1.5rem;
            cursor: pointer;
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
            transition: border-color 0.3s;
            display: flex; flex-direction: column;
        }
        .dark-mode .glass-card { background: rgba(0, 0, 0, 0.2); border: 1px solid rgba(255, 255, 255, 0.05); }
        .glass-card:hover { border-color: rgba(255, 255, 255, 0.3); }
        
        .badge { padding: 5px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 600; color: #fff; margin-top: 10px; display: inline-block; line-height: 1.4; }
        .badge-green { background: linear-gradient(135deg, #4caf50, #2e7d32); }
        .badge-yellow { background: linear-gradient(135deg, #ffc107, #f57f17); color: #333; }
        .badge-orange { background: linear-gradient(135deg, #ff9800, #e65100); }
        .badge-red { background: linear-gradient(135deg, #f44336, #c62828); }
        
        .course-detail, .curriculum-view { 
            display: none; 
            background: rgba(255, 255, 255, 0.03); 
            backdrop-filter: blur(16px);
            border-radius: 20px; 
            border: 1px solid rgba(255, 255, 255, 0.1); 
            padding: 2.5rem; 
            box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        }
        .dark-mode .course-detail, .dark-mode .curriculum-view { background: rgba(0, 0, 0, 0.2); }
        
        .course-stats {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; 
            margin-bottom: 2rem; background: rgba(255,255,255,0.02); padding: 1.5rem; border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.05);
        }
        
        .action-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem; margin-top: 2rem; }
        
        .btn-3d {
            background: linear-gradient(135deg, var(--cta-color), #2196f3);
            border: none; color: white; padding: 1rem; border-radius: 12px; font-size: 1rem; font-weight: 600;
            cursor: pointer; text-decoration: none; text-align: center;
            box-shadow: 0 4px 15px rgba(33, 150, 243, 0.2);
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .btn-3d:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(33, 150, 243, 0.4); color: white; }

        .curriculum-table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
        .curriculum-table th, .curriculum-table td { padding: 12px 15px; text-align: left; border-bottom: 1px solid rgba(255,255,255,0.05); }
        .curriculum-table th { color: var(--ntxt-color); font-weight: 600; font-size: 0.9rem; text-transform: uppercase; }
        .curriculum-table td { color: var(--txt-color); font-size: 0.95rem; }
        .curriculum-table tr:hover { background: rgba(255,255,255,0.02); cursor: pointer; }
        .level-header { background: rgba(33, 150, 243, 0.1); padding: 1rem; margin-top: 2rem; border-radius: 8px 8px 0 0; color: var(--sec-color); font-weight: bold; border-left: 4px solid var(--cta-color); }
        .semester-header { background: rgba(255, 255, 255, 0.02); padding: 0.8rem 1rem; color: var(--cta-color); font-weight: 600; border-bottom: 1px solid rgba(255,255,255,0.05); }
        
        .warning-box {
            background: rgba(255, 193, 7, 0.1);
            border: 1px solid rgba(255, 193, 7, 0.3);
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            color: var(--txt-color);
        }
    </style>
</head>
<body class="dashboard-body">
    <div class="ambient-bg">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
    </div>

    <%- include('partials/sidebar', { active_page: 'aau_curriculum' }) %>

    <main class="main-content">
        <%- include('partials/app_header') %>

        <div class="curriculum-container" id="main-container">
            <h2 style="color: var(--sec-color); margin-bottom: 1rem; font-size: 2.2rem; background: linear-gradient(135deg, var(--cta-color), var(--success)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">AAU Academic Catalogue</h2>
            
            <div class="breadcrumb" id="breadcrumb">
                <span onclick="renderState('faculty')">AAU Catalogue</span>
            </div>

            <div id="loading" style="display: none; text-align: center; padding: 3rem; color: var(--ntxt-color); font-size: 1.1rem;">
                Loading catalogue...
            </div>

            <div class="grid-view" id="grid-view"></div>

            <div class="curriculum-view" id="curriculum-view">
                <h1 id="cv-title" style="margin-bottom: 5px; color: var(--sec-color); font-size: 2.2rem;"></h1>
                <div id="cv-verification" style="margin-bottom: 2rem;"></div>
                <div id="cv-warning" class="warning-box" style="display: none;"></div>
                <div id="cv-content"></div>
            </div>

            <div class="course-detail" id="course-detail">
                <div style="margin-bottom: 1rem;">
                    <a href="#" onclick="renderState('programme')" style="color: var(--cta-color); text-decoration: none;">&larr; Back to Curriculum</a>
                </div>
                <h1 id="cd-title" style="margin-bottom: 5px; color: var(--sec-color); font-size: 2.2rem;"></h1>
                <p style="color: var(--cta-color); font-weight: 600; font-size: 1.2rem; margin-top: 0;" id="cd-code"></p>
                <div id="cd-verification" style="margin-bottom: 2rem;"></div>
                
                <div class="course-stats">
                    <div><strong style="color: var(--ntxt-color); display:block; margin-bottom:5px;">Credit Units</strong> <span id="cd-units" style="font-size:1.2rem; color:var(--txt-color); font-weight:600;"></span></div>
                    <div><strong style="color: var(--ntxt-color); display:block; margin-bottom:5px;">Status</strong> <span id="cd-status" style="font-size:1.2rem; color:var(--txt-color); font-weight:600;"></span></div>
                    <div><strong style="color: var(--ntxt-color); display:block; margin-bottom:5px;">Semester</strong> <span id="cd-semester" style="font-size:1.2rem; color:var(--txt-color); font-weight:600;"></span></div>
                    <div><strong style="color: var(--ntxt-color); display:block; margin-bottom:5px;">Prerequisites</strong> <span id="cd-prereq" style="font-size:1.1rem; color:var(--txt-color);">None</span></div>
                </div>

                <h3 style="color: var(--sec-color); margin-bottom: 1rem;">Description & Objectives</h3>
                <p id="cd-desc" style="color: var(--ntxt-color); line-height: 1.7; font-size: 1.05rem;"></p>

                <h3 style="color: var(--sec-color); margin-top: 2.5rem; margin-bottom: 1rem;">Course Actions</h3>
                <div class="action-grid">
                    <a href="/exam_materials" class="btn-3d">Study Materials</a>
                    <a href="/exam/setup" class="btn-3d">CBT Mock Exam</a>
                    <a href="/my_materials" class="btn-3d">Past Questions</a>
                    <a href="#" class="btn-3d" onclick="alert('Added to Bookmarks!')" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); box-shadow: none;">Bookmark Course</a>
                    <a href="/exam/analytics" class="btn-3d">My Progress</a>
                </div>
            </div>
        </div>
    </main>

    <script>
        let allProgrammes = [];
        let facultyGroups = {};
        let currentCurriculum = [];
        let currentProgrammeObj = null;
        
        let state = { step: 'faculty', faculty: null, department: null, programmeId: null, courseCode: null };

        document.addEventListener('DOMContentLoaded', () => {
            gsap.to("#main-container", { opacity: 1, y: 0, duration: 1, ease: "power3.out" });
            gsap.to(".orb-1", { x: "10vw", y: "5vh", rotation: 45, duration: 20, repeat: -1, yoyo: true, ease: "sine.inOut" });
            gsap.to(".orb-2", { x: "-10vw", y: "-10vh", rotation: -45, duration: 25, repeat: -1, yoyo: true, ease: "sine.inOut" });
            fetchCatalogue();
        });

        async function fetchCatalogue() {
            document.getElementById('loading').style.display = 'block';
            document.getElementById('grid-view').innerHTML = '';
            
            try {
                const res = await fetch('/api/curriculum/programmes');
                const contentType = res.headers.get("content-type");
                let result;
                if (contentType && contentType.indexOf("application/json") !== -1) {
                    result = await res.json();
                } else {
                    throw new Error("Server returned an invalid response.");
                }
                if(result.success) {
                    allProgrammes = result.data;
                    allProgrammes.forEach(p => {
                        const fac = p.faculty_name || 'General';
                        if(!facultyGroups[fac]) facultyGroups[fac] = [];
                        facultyGroups[fac].push(p);
                    });
                    document.getElementById('loading').style.display = 'none';
                    renderState('faculty');
                } else {
                    showErrorState('Database connection failed.');
                }
            } catch(e) {
                showErrorState('Network error. Failed to load catalogue.');
            }
        }

        function showErrorState(msg) {
            document.getElementById('loading').style.display = 'block';
            document.getElementById('loading').innerHTML = `
                <div style="color: var(--error); margin-bottom: 1rem;">${msg}</div>
                <button class="btn-3d" onclick="fetchCatalogue()">Retry Connection</button>
            `;
        }

        function getBadge(status) {
            if (status === 'current_official_verified') return '<span class="badge badge-green">AAU 2026/2027 curriculum - officially verified.</span>';
            if (status === 'official_historical') return '<span class="badge badge-yellow">Official AAU historical curriculum - current session not independently verified.</span>';
            if (status === 'conflicting_official_sources') return '<span class="badge badge-red">AAU sources conflict - confirmation required.</span>';
            return '<span class="badge badge-orange">Programme confirmed for 2026/2027 - curriculum pending verification.</span>';
        }

        function updateBreadcrumb() {
            let html = `<span onclick="renderState('faculty')">AAU Catalogue</span>`;
            if (state.faculty) html += ` &rsaquo; <span onclick="renderState('department', '${state.faculty}')">${state.faculty}</span>`;
            if (state.department) html += ` &rsaquo; <span onclick="renderState('programme_list', '${state.department}')">${state.department}</span>`;
            if (state.programmeId) {
                const pName = allProgrammes.find(p => p.id === state.programmeId)?.name;
                html += ` &rsaquo; <span onclick="renderState('programme', '${state.programmeId}')">${pName}</span>`;
            }
            if (state.courseCode) html += ` &rsaquo; <span>${state.courseCode}</span>`;
            document.getElementById('breadcrumb').innerHTML = html;
        }

        async function renderState(step, param = null) {
            state.step = step;
            const grid = document.getElementById('grid-view');
            const detail = document.getElementById('course-detail');
            const currView = document.getElementById('curriculum-view');
            
            grid.style.display = 'none'; detail.style.display = 'none'; currView.style.display = 'none';

            if (step === 'faculty') {
                state.faculty = null; state.department = null; state.programmeId = null; state.courseCode = null;
                grid.style.display = 'grid'; grid.innerHTML = '';
                Object.keys(facultyGroups).forEach(fac => {
                    grid.innerHTML += `
                        <div class="glass-card" onclick="renderState('department', '${fac}')">
                            <h3 style="color: var(--sec-color); margin:0;">${fac}</h3>
                            <p style="color: var(--ntxt-color); font-size: 0.95rem; margin-top: 10px;">${facultyGroups[fac].length} Departments</p>
                        </div>`;
                });
                reinitGrid();
            } 
            else if (step === 'department') {
                if (param) state.faculty = param;
                state.department = null; state.programmeId = null; state.courseCode = null;
                grid.style.display = 'grid'; grid.innerHTML = '';
                facultyGroups[state.faculty].forEach(p => {
                    const deptName = p.name.includes('Department') ? p.name : `Department of ${p.name}`;
                    grid.innerHTML += `
                        <div class="glass-card" onclick="renderState('programme_list', '${p.name}')">
                            <h3 style="color: var(--sec-color); margin:0 0 10px 0; font-size: 1.2rem;">${deptName}</h3>
                            <p style="color: var(--cta-color); font-size: 0.95rem; font-weight: 500; margin:0;">View Programmes &rsaquo;</p>
                        </div>`;
                });
                reinitGrid();
            }
            else if (step === 'programme_list') {
                if (param) state.department = param;
                state.programmeId = null; state.courseCode = null;
                grid.style.display = 'grid'; grid.innerHTML = '';
                const progs = facultyGroups[state.faculty].filter(p => p.name === state.department);
                progs.forEach(p => {
                    grid.innerHTML += `
                        <div class="glass-card" onclick="renderState('programme', '${p.id}')">
                            <h3 style="color: var(--sec-color); margin:0 0 10px 0;">B.Sc. ${p.name}</h3>
                            ${getBadge(p.curriculum_status)}
                        </div>`;
                });
                reinitGrid();
            }
            else if (step === 'programme') {
                if(param) {
                    state.programmeId = param;
                    currentProgrammeObj = allProgrammes.find(p => p.id === state.programmeId);
                }
                state.courseCode = null;
                
                document.getElementById('loading').style.display = 'block';
                
                try {
                    const res = await fetch(`/api/curriculum/programme/${state.programmeId}`);
                    const result = await res.json();
                    currentCurriculum = result.data || [];
                } catch(e) {}
                
                document.getElementById('loading').style.display = 'none'; 
                currView.style.display = 'block';

                document.getElementById('cv-title').innerText = `B.Sc. ${currentProgrammeObj.name}`;
                document.getElementById('cv-verification').innerHTML = getBadge(currentProgrammeObj.curriculum_status);
                
                const warningBox = document.getElementById('cv-warning');
                const cvContent = document.getElementById('cv-content');
                cvContent.innerHTML = '';

                if (currentProgrammeObj.curriculum_status === 'official_historical' || currentProgrammeObj.curriculum_status === 'conflicting_official_sources') {
                    warningBox.style.display = 'block';
                    warningBox.innerHTML = `<strong>Notice:</strong> Official historical curriculum available. The current 2026/2027 curriculum has not yet been independently verified.`;
                } else if (currentProgrammeObj.curriculum_status === 'current_official_verified') {
                    warningBox.style.display = 'block';
                    warningBox.style.background = 'rgba(76, 175, 80, 0.1)';
                    warningBox.style.borderColor = 'rgba(76, 175, 80, 0.3)';
                    warningBox.innerHTML = `<strong>Verified:</strong> This curriculum has been independently verified against official AAU sources for the 2026/2027 session.`;
                } else {
                    warningBox.style.display = 'none';
                }

                if (currentCurriculum.length === 0) {
                    cvContent.innerHTML = `<div style="color: var(--ntxt-color); text-align:center; padding:3rem; background:rgba(255,255,255,0.02); border-radius:16px;">No verified curriculum data available for this programme yet.</div>`;
                } else {
                    // Group by Level and Semester
                    const levels = [...new Set(currentCurriculum.map(c => c.level))].sort((a,b)=>a-b);
                    
                    let html = '';
                    levels.forEach(lvl => {
                        html += `<div class="level-header">${lvl} Level</div>`;
                        
                        const sems = [...new Set(currentCurriculum.filter(c => c.level == lvl).map(c => c.semester))].sort();
                        sems.forEach(sem => {
                            html += `<div class="semester-header">${sem}</div>`;
                            html += `<table class="curriculum-table">
                                <thead>
                                    <tr>
                                        <th style="width:15%;">Course Code</th>
                                        <th style="width:50%;">Course Title</th>
                                        <th style="width:15%;">Units</th>
                                        <th style="width:20%;">Status</th>
                                    </tr>
                                </thead>
                                <tbody>`;
                            
                            const courses = currentCurriculum.filter(c => c.level == lvl && c.semester === sem);
                            courses.forEach(c => {
                                html += `
                                    <tr onclick="renderCourse('${c.course_code}')">
                                        <td style="color: var(--cta-color); font-weight:600;">${c.course_code}</td>
                                        <td>${c.course_title || 'Untitled Course'}</td>
                                        <td>${c.credit_units || '-'}</td>
                                        <td>${c.course_status || 'Core'}</td>
                                    </tr>
                                `;
                            });
                            html += `</tbody></table>`;
                        });
                    });
                    cvContent.innerHTML = html;
                }
                gsap.fromTo("#curriculum-view", { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" });
            }

            updateBreadcrumb();
        }

        function reinitGrid() {
            VanillaTilt.init(document.querySelectorAll(".glass-card"), { max: 4, speed: 400, glare: true, "max-glare": 0.1 });
            gsap.fromTo(".glass-card", { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.5, stagger: 0.05, ease: "back.out(1.2)" });
        }

        function renderCourse(code) {
            state.step = 'course'; state.courseCode = code;
            document.getElementById('curriculum-view').style.display = 'none';
            const course = currentCurriculum.find(c => c.course_code === code);
            
            document.getElementById('cd-title').innerText = course.course_title || 'Untitled Course';
            document.getElementById('cd-code').innerText = course.course_code;
            document.getElementById('cd-verification').innerHTML = getBadge(course.verification_status);
            document.getElementById('cd-units').innerText = course.credit_units || 'N/A';
            document.getElementById('cd-status').innerText = course.course_status || 'Unknown';
            document.getElementById('cd-semester').innerText = course.semester;
            document.getElementById('cd-prereq').innerText = course.prerequisites || 'None specified';
            document.getElementById('cd-desc').innerText = course.course_description || 'No official description available in the selected curriculum source.';
            
            document.getElementById('course-detail').style.display = 'block';
            gsap.fromTo("#course-detail", { opacity: 0, scale: 0.95 }, { opacity: 1, scale: 1, duration: 0.5, ease: "power2.out" });
            updateBreadcrumb();
        }
    </script>
</body>
</html>
