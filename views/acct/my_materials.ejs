<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta charset="UTF-8">
    <title>My Materials - KelselPDF</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.0/vanilla-tilt.min.js"></script>
    <style>
        .dashboard-body { position: relative; background: transparent; }
        
        .ambient-bg {
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
            z-index: -1; overflow: hidden; pointer-events: none; background: var(--cbg-color);
        }
        .orb {
            position: absolute; border-radius: 50%; filter: blur(100px); opacity: 0.3; will-change: transform;
        }
        .orb-1 { width: 40vw; height: 40vw; background: rgba(33, 150, 243, 0.4); top: -10%; left: -10%; }
        .orb-2 { width: 35vw; height: 35vw; background: rgba(156, 39, 176, 0.3); bottom: -10%; right: -10%; }

        .glass-panel {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 2.5rem;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
            margin-bottom: 2rem;
            opacity: 0; transform: translateY(20px);
        }
        .dark-mode .glass-panel { background: rgba(0, 0, 0, 0.2); }
        
        .material-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 1.5rem;
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
            transition: border-color 0.3s;
            opacity: 0;
            transform: translateY(20px);
        }
        .dark-mode .material-card { background: rgba(0, 0, 0, 0.2); }
        .material-card:hover { border-color: rgba(255,255,255,0.3); }

        .btn-3d {
            background: linear-gradient(135deg, var(--cta-color), #2196f3);
            border: none; color: white; padding: 0.8rem 1.2rem; border-radius: 12px; font-weight: 600;
            cursor: pointer; text-decoration: none; text-align: center;
            box-shadow: 0 4px 15px rgba(33, 150, 243, 0.2);
            transition: transform 0.2s, box-shadow 0.2s;
            display: inline-block;
        }
        .btn-3d:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(33, 150, 243, 0.4); }
        
        .btn-ai-3d {
            background: linear-gradient(135deg, #9c27b0, #e91e63);
            border: none; color: white; padding: 0.8rem 1.2rem; border-radius: 12px; font-weight: 600;
            cursor: pointer; text-decoration: none; text-align: center;
            box-shadow: 0 4px 15px rgba(156, 39, 176, 0.2);
            transition: transform 0.2s, box-shadow 0.2s;
            display: inline-block; margin-left: 0.5rem;
        }
        .btn-ai-3d:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(156, 39, 176, 0.4); }

        .modal-glass {
            background: rgba(10, 10, 15, 0.7);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: var(--txt-color);
        }
        
        /* Modals */
        #ai-modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.5);
            backdrop-filter: blur(5px);
            align-items: center;
            justify-content: center;
        }
        .modal-content {
            border-radius: 20px;
            padding: 30px;
            width: 90%;
            max-width: 600px;
            position: relative;
            max-height: 80vh;
            overflow-y: auto;
            box-shadow: 0 15px 50px rgba(0,0,0,0.5);
        }
        .close-modal {
            position: absolute;
            top: 15px;
            right: 20px;
            cursor: pointer;
            font-size: 1.5rem;
            color: var(--ntxt-color);
        }
    </style>
</head>
<body class="dashboard-body">
    <div class="ambient-bg">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
    </div>

    <%- include('partials/sidebar', { active_page: 'my_materials' }) %>

    <main class="main-content">
        <%- include('partials/app_header', { page_title: 'My Materials', page_desc: 'Upload and analyze your personal study files' }) %>

        <div style="padding: 20px; max-width: 1000px; margin: 0 auto;">
            <% if (locals.limit_message) { %>
                <div class="glass-panel" style="background: rgba(255, 193, 7, 0.1); border-color: rgba(255, 193, 7, 0.3); padding: 1.5rem; opacity: 1; transform: none; margin-bottom: 2rem;">
                    <strong style="color: #ffc107;">Notice:</strong> <%= limit_message %>
                    <% if (locals.materials_remaining === 0) { %>
                        <br><a href="/payment" class="btn-3d" style="margin-top: 15px;">Upgrade Plan</a>
                    <% } %>
                </div>
            <% } %>

            <div class="glass-panel" id="upload-panel">
                <h3 style="color: var(--sec-color); margin-bottom: 15px; font-size: 1.5rem;">Upload a PDF Material</h3>
                <form action="/my_materials/upload" method="POST" enctype="multipart/form-data">
                    <div style="background: rgba(255,255,255,0.02); border: 1px dashed rgba(255,255,255,0.2); padding: 2rem; border-radius: 12px; text-align: center; margin-bottom: 1rem;">
                        <input type="file" name="material_file" accept=".pdf" required style="color: var(--txt-color);" <%= locals.materials_remaining === 0 ? 'disabled' : '' %>>
                    </div>
                    <button type="submit" class="btn-3d" style="width: auto;" <%= locals.materials_remaining === 0 ? 'disabled style="background:#666;cursor:not-allowed;"' : '' %>>Upload File</button>
                </form>
            </div>

            <h3 style="color: var(--sec-color); margin-bottom: 15px; font-size: 1.5rem; padding-left: 10px;">Your Files</h3>
            <div id="materials-list">
                <% if (materials && materials.length > 0) { %>
                    <% materials.forEach(m => { %>
                        <div class="material-card">
                            <div>
                                <h4 style="color: var(--sec-color); margin: 0 0 8px 0; font-size: 1.2rem;"><%= m.original_name %></h4>
                                <small style="color: var(--ntxt-color); font-weight: 500;">Uploaded: <%= new Date(m.uploaded_at).toLocaleDateString() %></small>
                            </div>
                            <div class="material-actions" style="display: flex; gap: 10px;">
                                <button onclick="explainMaterial(<%= m.id %>)" class="btn-3d" style="background: linear-gradient(135deg, #00bcd4, #1976d2);"> AI Explain</button>
                                <button onclick="promptExamType(<%= m.id %>)" class="btn-ai-3d"> Generate Mock Exam</button>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="glass-panel" style="text-align: center; opacity: 1; transform: none;">
                        <p style="color: var(--ntxt-color); padding: 20px 0;">No materials uploaded yet.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <!-- AI Response Modal -->
    <div id="ai-modal">
        <div class="modal-content modal-glass">
            <span class="close-modal" onclick="document.getElementById('ai-modal').style.display='none'">&times;</span>
            <h3 id="modal-title" style="margin-top: 0; color: var(--sec-color); font-size: 1.8rem; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px;">AI Analysis</h3>
            <div id="modal-body" style="line-height: 1.6; margin-top: 20px; white-space: normal; color: var(--txt-color);">
                Loading...
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            gsap.to("#upload-panel", { opacity: 1, y: 0, duration: 0.6, ease: "power2.out" });
            gsap.to(".material-card", { opacity: 1, y: 0, duration: 0.5, stagger: 0.1, ease: "back.out(1.2)", delay: 0.2 });
            gsap.to(".orb-1", { x: "10vw", y: "5vh", rotation: 45, duration: 20, repeat: -1, yoyo: true, ease: "sine.inOut" });
            gsap.to(".orb-2", { x: "-10vw", y: "-10vh", rotation: -45, duration: 25, repeat: -1, yoyo: true, ease: "sine.inOut" });
            VanillaTilt.init(document.querySelectorAll(".material-card"), { max: 2, speed: 400, glare: true, "max-glare": 0.05 });
        });

        function explainMaterial(id) {
            const modal = document.getElementById('ai-modal');
            const title = document.getElementById('modal-title');
            const body = document.getElementById('modal-body');
            
            modal.style.display = 'flex';
            gsap.fromTo(".modal-content", { opacity: 0, y: -50 }, { opacity: 1, y: 0, duration: 0.4, ease: "power2.out" });
            title.textContent = 'AI Explanation';
            body.innerHTML = '<div style="text-align: center; color: var(--ntxt-color);">Extracting text and analyzing... Please wait.</div>';

            fetch('/api/ai/material_explain', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ material_id: id })
            })
            .then(res => res.json())
            .then(data => {
                if(data.success === false || data.error) {
                    body.innerHTML = `<span style="color:var(--error);">Error: ${data.error || 'Failed to explain material'}</span>
                                      <br><br><button onclick="explainMaterial(${id})" class="btn-3d">Try Again</button>`;
                }
                else {
                    body.innerHTML = marked.parse(data.explanation);
                }
            })
            .catch(err => {
                body.innerHTML = `<span style="color:var(--error);">Network timeout: AI service busy. Please try again.</span>
                                  <br><br><button onclick="explainMaterial(${id})" class="btn-3d">Try Again</button>`;
            });
        }

        function promptExamType(id) {
            const modal = document.getElementById('ai-modal');
            const title = document.getElementById('modal-title');
            const body = document.getElementById('modal-body');
            
            modal.style.display = 'flex';
            gsap.fromTo(".modal-content", { opacity: 0, y: -50 }, { opacity: 1, y: 0, duration: 0.4, ease: "power2.out" });
            title.textContent = 'Select Exam Type';
            body.innerHTML = `
                <div style="text-align: center;">
                    <p style="color: var(--ntxt-color); margin-bottom: 20px; font-size: 1.1rem;">What type of exam would you like to generate from this material?</p>
                    <div style="display: flex; flex-direction: column; gap: 15px; align-items: center;">
                        <button onclick="generateExam(${id}, 'cbe')" class="btn-3d" style="width: 100%; max-width: 300px; padding: 1.2rem;">CBE (Multiple Choice)</button>
                        <button onclick="generateExam(${id}, 'theory')" class="btn-ai-3d" style="width: 100%; max-width: 300px; padding: 1.2rem;">Theory (Open Ended)</button>
                    </div>
                </div>
            `;
        }

        function generateExam(id, type) {
            const body = document.getElementById('modal-body');
            body.innerHTML = '<div style="text-align: center; color: var(--ntxt-color);">Reading document and generating questions... Please wait.</div>';

            fetch('/api/ai/material_exam', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ material_id: id, exam_type: type })
            })
            .then(res => res.json())
            .then(data => {
                if(data.success === false || data.error) {
                    body.innerHTML = `<span style="color:var(--error);">Error: ${data.error || 'Failed to generate exam'}</span>
                                      <br><br><button onclick="promptExamType(${id})" class="btn-3d">Try Again</button>`;
                } else {
                    localStorage.setItem('generated_mock_exam', JSON.stringify(data.exam_data || data));
                    body.innerHTML = '<div style="text-align: center; color: #4caf50; font-weight: bold; font-size: 1.2rem;">Exam ready! Redirecting...</div>';
                    setTimeout(() => {
                        window.location.href = '/exam/ai/take/MyMaterial';
                    }, 1000);
                }
            })
            .catch(err => {
                body.innerHTML = `<span style="color:var(--error);">Network timeout: AI service busy. Please try again.</span>
                                  <br><br><button onclick="promptExamType(${id})" class="btn-3d">Try Again</button>`;
            });
        }
    </script>
</body>
</html>
