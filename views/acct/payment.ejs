<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Premium Subscriptions - KelselPDF</title>
    <link rel="stylesheet" href="/style.css?v=4">
    <script src="/theme.js"></script>
    <link rel="manifest" href="/manifest.json">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.0/vanilla-tilt.min.js"></script>
    <script src="https://js.paystack.co/v1/inline.js"></script>
    <style>
        .dashboard-body {
            position: relative;
            background: transparent;
            min-height: 100vh;
        }

        /* Ambient Animated Orbs */
        .ambient-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -1;
            overflow: hidden;
            pointer-events: none;
            background: var(--cbg-color);
        }

        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(100px);
            opacity: 0.32;
            will-change: transform;
        }

        .orb-1 {
            width: 42vw;
            height: 42vw;
            background: rgba(33, 150, 243, 0.4);
            top: -12%;
            left: -10%;
        }

        .orb-2 {
            width: 38vw;
            height: 38vw;
            background: rgba(16, 185, 129, 0.32);
            bottom: -10%;
            right: -8%;
        }

        .orb-3 {
            width: 32vw;
            height: 32vw;
            background: rgba(156, 39, 176, 0.28);
            top: 40%;
            left: 35%;
        }

        /* Main Container */
        .pricing-wrapper {
            max-width: 1060px;
            margin: 1.5rem auto 5rem;
            padding: 0 1.5rem;
            box-sizing: border-box;
        }

        /* Hero Intro */
        .pricing-hero {
            text-align: center;
            margin-bottom: 2.75rem;
            opacity: 0;
            transform: translateY(20px);
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(99, 102, 241, 0.12);
            border: 1px solid rgba(99, 102, 241, 0.3);
            color: #818cf8;
            padding: 6px 18px;
            border-radius: 30px;
            font-size: 0.8rem;
            font-weight: 800;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 1rem;
        }

        .pricing-hero h2 {
            font-size: 2.5rem;
            font-weight: 800;
            margin: 0 0 0.75rem 0;
            background: linear-gradient(135deg, var(--sec-color, #fff), var(--cta-color, #2196f3));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            line-height: 1.2;
        }

        .pricing-hero p {
            color: var(--ntxt-color);
            font-size: 1.05rem;
            max-width: 620px;
            margin: 0 auto;
            line-height: 1.55;
        }

        /* Lock Alert Banner */
        .locked-banner {
            background: rgba(245, 158, 11, 0.08);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(245, 158, 11, 0.35);
            border-radius: 16px;
            padding: 1.25rem 1.75rem;
            margin-bottom: 2.5rem;
            display: flex;
            align-items: center;
            gap: 16px;
            color: #fbbf24;
            opacity: 0;
            transform: translateY(20px);
            box-shadow: 0 8px 25px rgba(245, 158, 11, 0.1);
        }

        .locked-icon-box {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: rgba(245, 158, 11, 0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 1.3rem;
        }

        /* Pricing Grid */
        .pricing-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 2.25rem;
            align-items: stretch;
            max-width: 920px;
            margin: 0 auto;
        }

        /* Glass Cards */
        .pricing-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 24px;
            padding: 2.75rem 2.25rem 2.25rem;
            position: relative;
            display: flex;
            flex-direction: column;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.12);
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
            overflow: hidden;
            opacity: 0;
            transform: translateY(30px);
            box-sizing: border-box;
            width: 100%;
        }

        .dark-mode .pricing-card {
            background: rgba(15, 23, 42, 0.45);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .pricing-card:hover {
            border-color: rgba(33, 150, 243, 0.4);
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.2);
        }

        /* Shimmer sweep effect */
        .pricing-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 50%;
            height: 100%;
            background: linear-gradient(to right, transparent, rgba(255, 255, 255, 0.07), transparent);
            transform: skewX(-20deg);
            transition: left 0.6s ease;
            pointer-events: none;
        }

        .pricing-card:hover::before {
            left: 150%;
        }

        /* Highlighted Best Value Card */
        .pricing-card.featured {
            border: 2px solid #10b981;
            background: linear-gradient(180deg, rgba(16, 185, 129, 0.08) 0%, rgba(255, 255, 255, 0.03) 100%);
            box-shadow: 0 12px 50px rgba(16, 185, 129, 0.15);
        }

        .dark-mode .pricing-card.featured {
            background: linear-gradient(180deg, rgba(16, 185, 129, 0.12) 0%, rgba(15, 23, 42, 0.5) 100%);
            border: 2px solid #10b981;
            box-shadow: 0 12px 50px rgba(16, 185, 129, 0.18);
        }

        .featured-pill {
            position: absolute;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            background: linear-gradient(135deg, #10b981, #059669);
            color: #ffffff;
            padding: 6px 20px;
            border-radius: 0 0 16px 16px;
            font-size: 0.78rem;
            font-weight: 800;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);
            white-space: nowrap;
        }

        /* Card Header & Icon */
        .card-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.5rem;
        }

        .plan-icon-glass {
            width: 54px;
            height: 54px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        }

        .ic-monthly {
            background: linear-gradient(135deg, #2196f3, #00bcd4);
            color: white;
        }

        .ic-semester {
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
        }

        .plan-name {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--sec-color, #ffffff);
            margin: 0 0 0.35rem 0;
        }

        .plan-desc {
            color: var(--ntxt-color);
            font-size: 0.92rem;
            margin: 0 0 1.5rem 0;
            line-height: 1.45;
        }

        /* Pricing Display */
        .price-box {
            padding: 1.25rem 0;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            margin-bottom: 1.75rem;
        }

        .price-figure {
            display: flex;
            align-items: baseline;
            gap: 4px;
            margin: 0;
            line-height: 1;
        }

        .price-symbol {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--cta-color, #2196f3);
        }

        .price-num {
            font-size: 3.2rem;
            font-weight: 900;
            letter-spacing: -1px;
            color: var(--txt-color, #ffffff);
        }

        .price-cycle {
            font-size: 0.95rem;
            color: var(--ntxt-color);
            font-weight: 500;
            margin-left: 4px;
        }

        .savings-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(16, 185, 129, 0.15);
            border: 1px solid rgba(16, 185, 129, 0.35);
            color: #34d399;
            font-size: 0.78rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 8px;
            margin-top: 8px;
        }

        /* Features */
        .features-container {
            flex: 1;
            margin-bottom: 2rem;
        }

        .features-label {
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--ntxt-color);
            font-weight: 700;
            margin-bottom: 1rem;
            display: block;
        }

        .features-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .features-list li {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 0.95rem;
            color: var(--txt-color);
            font-size: 0.94rem;
            line-height: 1.45;
        }

        .check-pill {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: rgba(16, 185, 129, 0.15);
            color: #10b981;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 900;
            flex-shrink: 0;
            margin-top: 1px;
        }

        /* Buttons */
        .btn-3d {
            width: 100%;
            padding: 1.1rem 1.5rem;
            border-radius: 14px;
            font-weight: 700;
            font-size: 1.08rem;
            cursor: pointer;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.25s ease;
            box-sizing: border-box;
            text-decoration: none;
        }

        .btn-3d-blue {
            background: linear-gradient(135deg, #2196f3, #1e40af);
            color: #ffffff;
            box-shadow: 0 4px 18px rgba(33, 150, 243, 0.3);
        }

        .btn-3d-blue:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(33, 150, 243, 0.5);
            color: #ffffff;
        }

        .btn-3d-emerald {
            background: linear-gradient(135deg, #10b981, #059669);
            color: #ffffff;
            box-shadow: 0 4px 20px rgba(16, 185, 129, 0.35);
        }

        .btn-3d-emerald:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(16, 185, 129, 0.55);
            color: #ffffff;
        }

        /* Trust & Security Footnote */
        .trust-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-top: 3.5rem;
            opacity: 0;
            transform: translateY(20px);
        }

        .trust-item {
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 14px;
            padding: 1rem 0.8rem;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            color: var(--ntxt-color);
            font-size: 0.82rem;
            line-height: 1.35;
        }

        .trust-item svg {
            color: #10b981;
        }

        /* Responsive Breakpoints */
        @media (max-width: 860px) {
            .pricing-wrapper {
                margin: 1rem auto 6rem;
                padding: 0 1rem;
            }

            .pricing-hero h2 {
                font-size: 2rem;
            }

            .pricing-hero p {
                font-size: 0.95rem;
            }

            .pricing-grid {
                grid-template-columns: 1fr;
                gap: 2rem;
                max-width: 440px;
            }

            .pricing-card {
                padding: 2.25rem 1.5rem 1.75rem;
                border-radius: 20px;
                transform: none !important;
            }

            .price-num {
                font-size: 2.6rem;
            }

            .price-symbol {
                font-size: 1.5rem;
            }

            .trust-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 12px;
                margin-top: 2.5rem;
            }
        }

        @media (max-width: 480px) {
            .pricing-card {
                padding: 1.85rem 1.25rem 1.5rem;
            }

            .btn-3d {
                padding: 0.95rem 1.2rem;
                font-size: 1rem;
            }

            .trust-grid {
                grid-template-columns: 1fr;
                gap: 10px;
            }
        }
    </style>
</head>
<body class="dashboard-body">
    <!-- Ambient Animated Glow Background -->
    <div class="ambient-bg">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>
    </div>

    <%- include('./partials/sidebar', { active_page: 'billing' }) %>

    <main class="main-content">
        <%- include('./partials/app_header', { 
            page_title: `Subscriptions & Billing`, 
            page_desc: `Upgrade your student account to unlock unlimited CBT mocks, AAU course tests, and AI assistance.`,
            header_style: 'background: linear-gradient(135deg, #10b981 0%, #059669 100%);'
        }) %>

        <div class="pricing-wrapper">
            <% if (locals.locked) { %>
                <div class="locked-banner" id="lock-banner">
                    <div class="locked-icon-box">🔒</div>
                    <div>
                        <strong style="color: #fbbf24; font-size: 1.05rem; display: block; margin-bottom: 2px;">Premium Access Required</strong>
                        <span style="font-size: 0.9rem; opacity: 0.9;">Your selected mock exam or study material requires an active student plan. Choose a plan below to activate your account instantly.</span>
                    </div>
                </div>
            <% } %>

            <!-- Hero Header -->
            <div class="pricing-hero" id="pricing-hero">
                <div class="hero-badge">💎 Premium Student Membership</div>
                <h2>Invest in Academic Excellence</h2>
                <p>Gain unlimited access to Ambrose Alli University semester course CBTs, national JAMB/WAEC mocks, and personalized AI tutor support.</p>
            </div>

            <!-- Pricing Matrix -->
            <div class="pricing-grid">
                
                <!-- Plan 1: Basic Premium (₦2,000 / 1 Month) -->
                <div class="pricing-card" data-tilt data-tilt-max="8" data-tilt-speed="400" data-tilt-glare data-tilt-max-glare="0.15">
                    <div class="card-top">
                        <div class="plan-icon-glass ic-monthly">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        </div>
                        <span style="font-size: 0.75rem; background: rgba(33, 150, 243, 0.15); color: #60a5fa; font-weight: 800; padding: 4px 10px; border-radius: 20px; text-transform: uppercase;">1 Month Access</span>
                    </div>

                    <h3 class="plan-name">Basic Premium</h3>
                    <p class="plan-desc">Ideal for short-term test revision and immediate semester preparation.</p>

                    <div class="price-box">
                        <div class="price-figure">
                            <span class="price-symbol">₦</span>
                            <span class="price-num">2,000</span>
                            <span class="price-cycle">/ month</span>
                        </div>
                        <div style="font-size: 0.82rem; color: var(--ntxt-color); margin-top: 6px;">30 days unlimited access &bull; Cancel anytime</div>
                    </div>

                    <div class="features-container">
                        <span class="features-label">What's included:</span>
                        <ul class="features-list">
                            <li>
                                <div class="check-pill">✓</div>
                                <span><strong>AAU Course CBT:</strong> GST 111, BIO 111, MTH 112 & semester tests</span>
                            </li>
                            <li>
                                <div class="check-pill">✓</div>
                                <span><strong>National CBT Hub:</strong> Full JAMB UTME, WAEC & NECO simulations</span>
                            </li>
                            <li>
                                <div class="check-pill">✓</div>
                                <span><strong>Past Questions Bank:</strong> Unlimited practice with step-by-step solutions</span>
                            </li>
                            <li>
                                <div class="check-pill">✓</div>
                                <span><strong>Performance Analytics:</strong> Detailed strength & weakness breakdowns</span>
                            </li>
                            <li>
                                <div class="check-pill">✓</div>
                                <span><strong>Study Materials:</strong> Download curated handouts and past question PDFs</span>
                            </li>
                            <li>
                                <div class="check-pill">✓</div>
                                <span><strong>AI Tutor Assistant:</strong> In-depth explanations for difficult questions</span>
                            </li>
                        </ul>
                    </div>

                    <button type="button" class="btn-3d btn-3d-blue" onclick="payWithPaystack('premium', 200000)">
                        <span>Activate 1 Month &bull; ₦2,000</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </button>
                </div>

                <!-- Plan 2: Full Premium (₦5,000 / 6 Months) -->
                <div class="pricing-card featured" data-tilt data-tilt-max="8" data-tilt-speed="400" data-tilt-glare data-tilt-max-glare="0.15">
                    <div class="featured-pill">🔥 BEST VALUE &bull; SEMESTER PASS</div>
                    
                    <div class="card-top" style="margin-top: 0.5rem;">
                        <div class="plan-icon-glass ic-semester">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                        </div>
                        <span style="font-size: 0.75rem; background: rgba(16, 185, 129, 0.2); color: #34d399; font-weight: 800; padding: 4px 10px; border-radius: 20px; text-transform: uppercase;">6 Months Pass</span>
                    </div>

                    <h3 class="plan-name">Full Premium</h3>
                    <p class="plan-desc">Comprehensive semester-long coverage for maximum academic success.</p>

                    <div class="price-box">
                        <div class="price-figure">
                            <span class="price-symbol" style="color: #10b981;">₦</span>
                            <span class="price-num">5,000</span>
                            <span class="price-cycle">/ 6 months</span>
                        </div>
                        <div>
                            <span class="savings-tag">
                                <span>🎉 Save ₦7,000</span>
                                <span style="opacity: 0.75; font-weight: normal;">(58% off monthly rate)</span>
                            </span>
                        </div>
                    </div>

                    <div class="features-container">
                        <span class="features-label">Everything in Basic, plus:</span>
                        <ul class="features-list">
                            <li>
                                <div class="check-pill" style="background: rgba(16, 185, 129, 0.25); color: #10b981;">✓</div>
                                <span><strong>6 Full Months:</strong> Uninterrupted semester-wide exam & material access</span>
                            </li>
                            <li>
                                <div class="check-pill" style="background: rgba(16, 185, 129, 0.25); color: #10b981;">✓</div>
                                <span><strong>Unlimited AI Mock Generation:</strong> Create personalized custom mock exams</span>
                            </li>
                            <li>
                                <div class="check-pill" style="background: rgba(16, 185, 129, 0.25); color: #10b981;">✓</div>
                                <span><strong>Grade Tracking & GPA Predictor:</strong> Real-time academic standing forecast</span>
                            </li>
                            <li>
                                <div class="check-pill" style="background: rgba(16, 185, 129, 0.25); color: #10b981;">✓</div>
                                <span><strong>Department Transfer Freedom:</strong> Switch course tracks anytime for free</span>
                            </li>
                            <li>
                                <div class="check-pill" style="background: rgba(16, 185, 129, 0.25); color: #10b981;">✓</div>
                                <span><strong>VIP WhatsApp & Chat Support:</strong> Direct academic assistance desk</span>
                            </li>
                        </ul>
                    </div>

                    <button type="button" class="btn-3d btn-3d-emerald" onclick="payWithPaystack('full_premium', 500000)">
                        <span>Activate 6 Months &bull; ₦5,000</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </button>
                </div>
            </div>

            <!-- Trust / Security Footnotes -->
            <div class="trust-grid" id="trust-grid">
                <div class="trust-item">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    <strong>256-bit SSL Encrypted</strong>
                    <span>Secured by Paystack PCI-DSS certified gateway</span>
                </div>
                <div class="trust-item">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                    <strong>Instant Activation</strong>
                    <span>Your account updates automatically in under 3 seconds</span>
                </div>
                <div class="trust-item">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                    <strong>Academic Guarantee</strong>
                    <span>Calibrated directly against official AAU curricula & formats</span>
                </div>
                <div class="trust-item">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
                    <strong>Dedicated Student Desk</strong>
                    <span>Responsive WhatsApp and support team on standby</span>
                </div>
            </div>
        </div>
    </main>

    <!-- GSAP & Paystack Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Animate Hero and Banner
            gsap.to("#lock-banner", { opacity: 1, y: 0, duration: 0.6, ease: "power2.out" });
            gsap.to("#pricing-hero", { opacity: 1, y: 0, duration: 0.8, ease: "power3.out" });

            // Animate Cards with Stagger
            gsap.to(".pricing-card", {
                opacity: 1,
                y: 0,
                duration: 0.9,
                stagger: 0.15,
                ease: "back.out(1.4)",
                delay: 0.15
            });

            // Animate Trust Grid
            gsap.to("#trust-grid", {
                opacity: 1,
                y: 0,
                duration: 0.8,
                ease: "power2.out",
                delay: 0.4
            });

            // Floating Background Orbs
            gsap.to(".orb-1", {
                x: "8vw", y: "6vh", rotation: 40, duration: 22, repeat: -1, yoyo: true, ease: "sine.inOut"
            });
            gsap.to(".orb-2", {
                x: "-8vw", y: "-8vh", rotation: -40, duration: 26, repeat: -1, yoyo: true, ease: "sine.inOut"
            });
            gsap.to(".orb-3", {
                x: "6vw", y: "-4vh", scale: 1.15, duration: 19, repeat: -1, yoyo: true, ease: "sine.inOut"
            });
        });

        function payWithPaystack(plan, amountKobo) {
            let userEmail = '<%= (locals.user && user.email) ? user.email : "" %>';
            if (!userEmail || userEmail.trim().length === 0) {
                userEmail = prompt("Please enter your email address for your payment receipt:");
                if (!userEmail || !userEmail.includes('@')) {
                    alert("A valid email address is required to proceed with payment.");
                    return;
                }
            }

            const publicKey = '<%= paystack_public_key %>';
            if (!publicKey) {
                alert("Payment gateway configuration error. Please contact support.");
                return;
            }

            let handler = PaystackPop.setup({
                key: publicKey, 
                email: userEmail.trim(),
                amount: amountKobo,
                currency: "NGN",
                ref: 'kelsel_' + Date.now() + '_' + Math.floor((Math.random() * 1000000) + 1),
                callback: function (response) {
                    // Show glass overlay while verifying
                    const overlay = document.createElement('div');
                    overlay.style.position = 'fixed';
                    overlay.style.top = '0';
                    overlay.style.left = '0';
                    overlay.style.width = '100vw';
                    overlay.style.height = '100vh';
                    overlay.style.background = 'rgba(10, 15, 30, 0.85)';
                    overlay.style.backdropFilter = 'blur(16px)';
                    overlay.style.webkitBackdropFilter = 'blur(16px)';
                    overlay.style.display = 'flex';
                    overlay.style.flexDirection = 'column';
                    overlay.style.justifyContent = 'center';
                    overlay.style.alignItems = 'center';
                    overlay.style.zIndex = '99999';
                    overlay.style.color = '#fff';
                    overlay.innerHTML = `
                        <div style="width: 50px; height: 50px; border: 3px solid rgba(255,255,255,0.1); border-top-color: #10b981; border-radius: 50%; animation: spin 0.8s linear infinite; margin-bottom: 20px;"></div>
                        <div style="font-size: 1.4rem; font-weight: 800; margin-bottom: 8px;">Verifying Payment...</div>
                        <div style="font-size: 0.95rem; color: #94a3b8;">Activating your premium student benefits. Please do not close this tab.</div>
                    `;
                    document.body.appendChild(overlay);

                    fetch('/api/verify_payment', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ reference: response.reference, plan: plan })
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
                        if (data.status === 'success') {
                            alert('Payment successful! Your account has been upgraded to Premium.');
                            window.location.href = '/dashboard';
                        } else {
                            alert('Payment verification failed: ' + (data.message || 'Please contact support with reference ' + response.reference));
                        }
                    })
                    .catch(err => {
                        if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
                        alert('Network communication error during verification. Your reference is ' + response.reference);
                    });
                },
                onClose: function () {
                    // Modal dismissed
                }
            });
            handler.openIframe();
        }
    </script>
</body>
</html>
