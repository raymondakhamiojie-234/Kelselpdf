<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Premium Subscriptions - KelselPDF</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <script src="https://js.paystack.co/v1/inline.js"></script>
    <style>
        .pricing-container { max-width: 1000px; margin: 3rem auto; text-align: center; }
        .pricing-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; margin-top: 3rem; }
        
        .price-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 3rem 2rem;
            position: relative;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        }
        
        .price-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            border-color: var(--primary-color);
        }
        
        .price-card.popular {
            border: 2px solid var(--primary-color);
            transform: scale(1.05);
        }
        .price-card.popular:hover { transform: scale(1.05) translateY(-10px); }
        
        .popular-badge {
            position: absolute; top: -15px; left: 50%; transform: translateX(-50%);
            background: linear-gradient(135deg, var(--primary-color) 0%, #10b981 100%);
            color: white; padding: 5px 15px; border-radius: 20px; font-weight: bold; font-size: 0.85rem;
        }

        .price-amount { font-size: 3rem; font-weight: bold; color: var(--text-color); margin: 1.5rem 0; }
        .price-currency { font-size: 1.5rem; vertical-align: top; margin-right: 5px; }
        
        .features-list { list-style: none; padding: 0; margin: 2rem 0; text-align: left; }
        .features-list li { margin-bottom: 1rem; color: var(--ntxt-color); display: flex; align-items: center; gap: 10px; }
        .features-list li::before { content: '✓'; color: #10b981; font-weight: bold; }
        
        .locked-alert {
            background: rgba(245, 158, 11, 0.1);
            border: 1px solid #f59e0b;
            color: #d97706;
            padding: 1.5rem;
            border-radius: 8px;
            margin-bottom: 2rem;
            display: inline-block;
        }
    </style>
</head>
<body class="dashboard-body">
    <%- include('./partials/sidebar', { active_page: 'subscription' }) %>

    <main class="main-content">
        <%- include('./partials/app_header', { 
            page_title: `Premium Subscriptions`, 
            page_desc: `Upgrade your plan to access premium CBT mocks and advanced materials.`,
            header_style: 'background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);'
        }) %>

        <div class="pricing-container">
            <% if (locals.locked) { %>
                <div class="locked-alert">
                    🔒 The Mock Examination you selected requires an active Premium Subscription. Please upgrade to continue.
                </div>
            <% } %>

            <div class="pricing-grid">
                <!-- Monthly Plan -->
                <div class="price-card">
                    <h3 style="color: var(--text-color); font-size: 1.5rem;">Basic Premium</h3>
                    <p style="color: var(--ntxt-color); margin-top: 10px;">Perfect for short-term preparation.</p>
                    <div class="price-amount"><span class="price-currency">₦</span>2,000</div>
                    <span style="color: var(--ntxt-color);">per month</span>
                    
                    <ul class="features-list">
                        <li>Access all Premium Mock Exams</li>
                        <li>Advanced Subject Analytics</li>
                        <li>Download all Study PDFs</li>
                        <li>Unlimited Practice Sessions</li>
                    </ul>
                    
                    <button class="btn btn-primary" style="width: 100%; padding: 15px; font-size: 1.1rem; background: var(--card-bg); color: var(--primary-color); border: 2px solid var(--primary-color);" onclick="payWithPaystack('premium', 200000)">Subscribe Monthly</button>
                </div>

                <!-- 6 Months Plan -->
                <div class="price-card popular">
                    <div class="popular-badge">MOST POPULAR</div>
                    <h3 style="color: var(--text-color); font-size: 1.5rem;">Full Premium</h3>
                    <p style="color: var(--ntxt-color); margin-top: 10px;">Complete access for an entire semester.</p>
                    <div class="price-amount"><span class="price-currency">₦</span>10,000</div>
                    <span style="color: var(--ntxt-color);">for 6 months (Save ₦2,000)</span>
                    
                    <ul class="features-list">
                        <li>Access all Premium Mock Exams</li>
                        <li>Advanced Subject Analytics</li>
                        <li>Download all Study PDFs</li>
                        <li>Unlimited Practice Sessions</li>
                        <li>Priority Chat Support</li>
                    </ul>
                    
                    <button class="btn btn-primary" style="width: 100%; padding: 15px; font-size: 1.1rem;" onclick="payWithPaystack('full_premium', 1000000)">Subscribe for 6 Months</button>
                </div>
            </div>
        </div>
    </main>

    <script>
        function payWithPaystack(plan, amount) {
            let handler = PaystackPop.setup({
                key: '<%= paystack_public_key %>', 
                email: '<%= user.email %>',
                amount: amount,
                currency: "NGN",
                ref: '' + Math.floor((Math.random() * 1000000000) + 1),
                callback: function (response) {
                    fetch('/api/verify_payment', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ reference: response.reference, plan: plan })
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.status === 'success') {
                            alert('Payment successful! Your account has been upgraded.');
                            window.location.href = '/payment_history';
                        } else {
                            alert('Payment verification failed: ' + data.message);
                        }
                    });
                },
                onClose: function () {
                    alert('Transaction was not completed, window closed.');
                }
            });
            handler.openIframe();
        }
    </script>
</body>
</html>
