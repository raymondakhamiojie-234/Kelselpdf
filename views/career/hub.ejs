<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Career Hub - KelselPDF Ecosystem</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.0/vanilla-tilt.min.js"></script>
    <style>
        .dashboard-body { position: relative; background: transparent; }
        
        .ambient-bg {
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
            z-index: -1; overflow: hidden; pointer-events: none; background: var(--cbg-color);
        }
        .orb {
            position: absolute; border-radius: 50%; filter: blur(100px); opacity: 0.3; will-change: transform;
        }
        .orb-1 { width: 40vw; height: 40vw; background: rgba(33, 150, 243, 0.4); top: -10%; left: -10%; }
        .orb-2 { width: 35vw; height: 35vw; background: rgba(156, 39, 176, 0.3); bottom: -10%; right: -10%; }

        .glass-panel {
            background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 20px; padding: 2rem;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1); opacity: 0; transform: translateY(20px);
        }
        .dark-mode .glass-panel { background: rgba(0, 0, 0, 0.2); }
        
        .career-grid {
            display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem; margin-top: 2rem;
        }
        
        .job-card {
            background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; padding: 1.8rem;
            display: flex; flex-direction: column; justify-content: space-between;
            opacity: 0; transform: translateY(20px); transition: border-color 0.3s;
        }
        .job-card:hover { border-color: rgba(255,255,255,0.3); }

        .job-title { font-size: 1.3rem; font-weight: 700; color: var(--sec-color); margin-bottom: 0.5rem; }
        .job-company { color: var(--cta-color); font-weight: 600; margin-bottom: 1rem; }
        
        .job-meta { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 1rem; }
        .job-tag {
            background: rgba(255,255,255,0.05); padding: 5px 10px; border-radius: 8px;
            font-size: 0.85rem; font-weight: 600; color: var(--ntxt-color); border: 1px solid rgba(255,255,255,0.1);
        }
        
        .job-desc {
            font-size: 0.95rem; color: var(--txt-color); margin-bottom: 1.5rem; line-height: 1.5;
            display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
        }

        .btn-3d {
            background: linear-gradient(135deg, var(--cta-color), #2196f3);
            border: none; color: white; padding: 0.8rem 1.5rem; border-radius: 12px; font-weight: 600;
            cursor: pointer; text-decoration: none; text-align: center; display: block;
            box-shadow: 0 4px 15px rgba(33, 150, 243, 0.2); transition: transform 0.2s, box-shadow 0.2s;
        }
        .btn-3d:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(33, 150, 243, 0.4); color: white; }
        
        .btn-ghost {
            background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
            color: var(--txt-color); padding: 0.8rem 1.5rem; border-radius: 12px; font-weight: 600;
            cursor: pointer; text-decoration: none; text-align: center; display: inline-block;
            transition: background 0.3s;
        }
        .btn-ghost:hover { background: rgba(255,255,255,0.1); }

        .search-input, .filter-select {
            background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
            color: var(--txt-color); padding: 12px 15px; border-radius: 12px; font-size: 1rem;
        }
        .filter-select option { background: var(--nav-bg); }
    </style>
</head>
<body class="dashboard-body">
    <div class="ambient-bg">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
    </div>

    <%- include('../acct/partials/sidebar', { active_page: 'career' }) %>

    <div class="main-content">
        <%- include('../acct/partials/app_header', { page_title: 'Career Hub', page_desc: 'Jobs & Mentorship' }) %>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 15px;">
            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                <select class="filter-select">
                    <option value="">All Job Types</option>
                    <option value="Remote">Remote</option>
                    <option value="On-site">On-site</option>
                    <option value="Internship">Internship</option>
                </select>
                <input type="text" class="search-input" placeholder="Search roles or companies..." style="min-width: 250px;">
                <button class="btn-3d" style="width: auto;">Search</button>
            </div>
            
            <a href="/career/portfolio" class="btn-ghost">My Digital Portfolio</a>
        </div>

        <div class="career-grid">
            <% if (jobs && jobs.length > 0) { %>
                <% jobs.forEach(job => { %>
                    <div class="job-card">
                        <div>
                            <h3 class="job-title"><%= job.title %></h3>
                            <div class="job-company"><%= job.company %></div>
                            <div class="job-meta">
                                <span class="job-tag">📍 <%= job.location || 'Remote' %></span>
                                <span class="job-tag">💼 <%= job.type %></span>
                            </div>
                            <div class="job-desc"><%= job.description %></div>
                        </div>
                        <a href="<%= job.apply_link %>" target="_blank" class="btn-3d">Apply Now</a>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="glass-panel" style="grid-column: 1 / -1; text-align: center; padding: 4rem;">
                    <div style="font-size: 4rem; margin-bottom: 1rem; opacity: 0.5;">🏢</div>
                    <h3 style="color: var(--sec-color); font-size: 1.8rem; margin-bottom: 10px;">No openings at the moment</h3>
                    <p style="color: var(--ntxt-color); font-size: 1.1rem;">Check back later for new internships and job opportunities!</p>
                </div>
            <% } %>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            gsap.to(".glass-panel", { opacity: 1, y: 0, duration: 0.6, ease: "power2.out" });
            gsap.to(".job-card", { opacity: 1, y: 0, duration: 0.5, stagger: 0.1, ease: "back.out(1.2)" });
            gsap.to(".orb-1", { x: "10vw", y: "5vh", rotation: 45, duration: 20, repeat: -1, yoyo: true, ease: "sine.inOut" });
            gsap.to(".orb-2", { x: "-10vw", y: "-10vh", rotation: -45, duration: 25, repeat: -1, yoyo: true, ease: "sine.inOut" });
            VanillaTilt.init(document.querySelectorAll(".job-card"), { max: 2, speed: 400, glare: true, "max-glare": 0.05 });
        });
    </script>
</body>
</html>
