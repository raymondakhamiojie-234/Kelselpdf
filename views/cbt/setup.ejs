<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Mock Examination Setup - KelselPDF</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <style>
        .setup-container { 
            max-width: 680px; 
            margin: 2rem auto; 
            background: var(--card-bg); 
            padding: 2.2rem; 
            border-radius: 14px; 
            border: 1px solid var(--border-color); 
            box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        }
        .rules { 
            background: rgba(239, 68, 68, 0.06); 
            border: 1px solid rgba(239, 68, 68, 0.3); 
            padding: 1.2rem; 
            border-radius: 10px; 
            margin-bottom: 1.8rem; 
        }
        .rules-title {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #ef4444;
            font-weight: 700;
            font-size: 1rem;
            margin-bottom: 0.5rem;
        }
        .rules ul { 
            margin-left: 1.2rem; 
            margin-top: 0.5rem; 
            color: var(--ntxt-color); 
            font-size: 0.92rem;
            line-height: 1.6;
        }
        .rules li { 
            margin-bottom: 0.35rem; 
        }
        
        .mock-card { 
            border: 2px solid var(--border-color); 
            padding: 16px 20px; 
            border-radius: 10px; 
            cursor: pointer; 
            margin-bottom: 12px; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            position: relative; 
            overflow: hidden; 
            transition: all 0.2s ease;
            background: rgba(255, 255, 255, 0.015);
        }
        .mock-card:hover { 
            border-color: var(--primary-color, #3b82f6); 
            transform: translateY(-1px);
        }
        .mock-input { 
            display: none; 
        }
        .mock-input:checked + .mock-card { 
            border-color: var(--primary-color, #3b82f6); 
            background: rgba(59, 130, 246, 0.08); 
            box-shadow: 0 0 0 1px var(--primary-color, #3b82f6);
        }
        
        .mock-card.locked { 
            opacity: 0.75; 
            cursor: not-allowed; 
            border-color: var(--border-color) !important; 
            background: var(--bg-color) !important; 
        }
        .lock-overlay { 
            position: absolute; 
            inset: 0; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            background: rgba(15, 23, 42, 0.7); 
            backdrop-filter: blur(2px); 
        }
        .lock-icon { 
            background: #f59e0b; 
            color: white; 
            padding: 6px 14px; 
            border-radius: 20px; 
            font-weight: bold; 
            font-size: 0.85rem; 
            display: flex; 
            align-items: center; 
            gap: 6px; 
            box-shadow: 0 2px 8px rgba(0,0,0,0.25);
        }
        .lock-icon a { 
            color: white; 
            text-decoration: none; 
        }
        .lock-icon a:hover {
            text-decoration: underline;
        }

        .exam-tag {
            background: rgba(59, 130, 246, 0.15);
            color: #60a5fa;
            border: 1px solid rgba(59, 130, 246, 0.3);
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 0.75rem;
            font-weight: 700;
            display: inline-block;
            margin-right: 6px;
        }

        /* Duration Configuration Card */
        .duration-card {
            background: rgba(59, 130, 246, 0.03);
            border: 1.5px solid var(--border-color);
            border-radius: 12px;
            padding: 1.35rem 1.4rem;
            margin-top: 1.6rem;
            margin-bottom: 1.2rem;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }
        .duration-card:focus-within {
            border-color: rgba(59, 130, 246, 0.5);
            box-shadow: 0 4px 18px rgba(59, 130, 246, 0.08);
        }
        .duration-card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.1rem;
            gap: 12px;
        }
        .duration-title-group {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .duration-header-icon {
            font-size: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 44px;
            height: 44px;
            border-radius: 10px;
            background: rgba(59, 130, 246, 0.12);
            border: 1px solid rgba(59, 130, 246, 0.25);
            flex-shrink: 0;
        }
        .duration-heading {
            font-size: 1.08rem;
            font-weight: 700;
            color: var(--text-color);
            margin: 0;
        }
        .duration-subheading {
            font-size: 0.83rem;
            color: var(--ntxt-color);
            margin: 3px 0 0;
        }
        .current-duration-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(59, 130, 246, 0.15);
            border: 1px solid rgba(59, 130, 246, 0.4);
            padding: 6px 14px;
            border-radius: 20px;
            color: #3b82f6;
            font-weight: 700;
            font-size: 0.95rem;
            white-space: nowrap;
        }
        .duration-section-label {
            display: block;
            font-size: 0.78rem;
            font-weight: 700;
            color: var(--ntxt-color);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }
        .duration-presets-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(105px, 1fr));
            gap: 8px;
            margin-bottom: 1.1rem;
        }
        .preset-pill-btn {
            background: var(--bg-color);
            border: 1.5px solid var(--border-color);
            border-radius: 8px;
            padding: 8px 10px;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            text-align: center;
            color: var(--text-color);
            font-family: inherit;
        }
        .preset-pill-btn:hover {
            border-color: #3b82f6;
            background: rgba(59, 130, 246, 0.06);
            transform: translateY(-1px);
        }
        .preset-pill-btn.active {
            border-color: #3b82f6;
            background: rgba(59, 130, 246, 0.16);
            box-shadow: 0 0 0 1px #3b82f6;
        }
        .preset-name {
            font-size: 0.74rem;
            color: var(--ntxt-color);
            margin-bottom: 2px;
            font-weight: 500;
        }
        .preset-pill-btn.active .preset-name {
            color: #3b82f6;
            font-weight: 700;
        }
        .preset-time {
            font-size: 0.92rem;
            font-weight: 800;
            color: var(--text-color);
        }
        .preset-pill-btn.active .preset-time {
            color: #3b82f6;
        }
        .custom-time-wrapper {
            background: var(--bg-color);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 12px 14px;
        }
        .custom-time-input-group {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .stepper-btn {
            background: rgba(59, 130, 246, 0.1);
            color: #3b82f6;
            border: 1px solid rgba(59, 130, 246, 0.3);
            padding: 9px 14px;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.15s ease;
            flex-shrink: 0;
            font-family: inherit;
        }
        .stepper-btn:hover {
            background: #3b82f6;
            color: white;
            border-color: #3b82f6;
        }
        .stepper-btn:active {
            transform: scale(0.95);
        }
        .input-inner {
            flex: 1;
            position: relative;
            display: flex;
            align-items: center;
        }
        .custom-time-input {
            width: 100%;
            padding: 10px 54px 10px 14px;
            background: var(--card-bg);
            border: 1.5px solid var(--border-color);
            border-radius: 8px;
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-color);
            outline: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
            box-sizing: border-box;
            font-family: inherit;
        }
        .custom-time-input:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
        }
        .input-suffix {
            position: absolute;
            right: 14px;
            color: var(--ntxt-color);
            font-size: 0.85rem;
            font-weight: 700;
            pointer-events: none;
        }
        .duration-hint {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.78rem;
            color: var(--ntxt-color);
            margin-top: 8px;
            flex-wrap: wrap;
        }

        @media (max-width: 768px) {
            .setup-container {
                margin: 1rem auto 2.5rem !important;
                padding: 1.25rem 1rem !important;
                border-radius: 12px !important;
            }
            .rules {
                padding: 1rem !important;
                margin-bottom: 1.25rem !important;
            }
            .rules-title {
                font-size: 0.92rem !important;
            }
            .rules ul {
                margin-left: 1rem !important;
                font-size: 0.85rem !important;
            }
            .mock-card {
                flex-direction: column !important;
                align-items: flex-start !important;
                padding: 14px 14px !important;
                gap: 10px !important;
            }
            .mock-card-info {
                padding-right: 0 !important;
                width: 100% !important;
            }
            .mock-card-header {
                flex-wrap: wrap !important;
                gap: 6px !important;
            }
            .mock-card-badges {
                text-align: left !important;
                white-space: normal !important;
                display: flex !important;
                flex-wrap: wrap !important;
                gap: 6px !important;
                width: 100% !important;
            }
            .mock-card-badges span {
                margin-left: 0 !important;
            }
            .duration-card {
                padding: 1.1rem 0.95rem !important;
                margin-top: 1.25rem !important;
            }
            .duration-card-header {
                flex-direction: column !important;
                align-items: flex-start !important;
                gap: 8px !important;
            }
            .duration-presets-grid {
                grid-template-columns: repeat(3, 1fr) !important;
                gap: 6px !important;
            }
            .custom-time-input-group {
                gap: 6px !important;
            }
            .stepper-btn {
                padding: 8px 10px !important;
                font-size: 0.82rem !important;
            }
            .custom-time-input {
                font-size: 1rem !important;
                padding: 9px 44px 9px 10px !important;
            }
        }
    </style>
</head>
<body class="dashboard-body">
    <%- include('../acct/partials/sidebar', { active_page: locals.active_page }) %>

    <main class="main-content">
        <%- include('../acct/partials/app_header', { 
            page_title: 'Mock Examination Setup', 
            page_desc: 'Start a realistic, timed CBT examination session.',
            header_style: 'background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);',
            search_placeholder: 'Search exams...'
        }) %>

        <div class="setup-container">
            <!-- AAU Course Mock Exam Redirect Hint -->
            <div style="background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 10px; padding: 12px 16px; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
                <div style="font-size: 0.85rem; color: var(--ntxt-color);">
                    <strong style="color: #10b981;">AAU Degree Student?</strong> Looking for university semester courses (GST 111, BIO 111, MTH 112)?
                </div>
                <a href="/exam/setup" style="font-size: 0.82rem; color: #10b981; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">Go to AAU Course CBT &rarr;</a>
            </div>

            <div class="rules">
                <div class="rules-title">
                    <span>⚠️</span>
                    <span>Examination Instructions & Anti-Cheat Rules:</span>
                </div>
                <ul>
                    <li>You will be placed into a strictly timed, realistic exam simulation.</li>
                    <li>Questions and options are randomized for each candidate.</li>
                    <li>Full-screen mode is required throughout the test.</li>
                    <li>Switching browser tabs or minimizing the window will be logged as an integrity violation.</li>
                    <li>Your selected answers are automatically saved to the server as you answer.</li>
                </ul>
            </div>
            
            <form action="/cbt/start" method="POST">
                <h3 style="margin-bottom: 1.2rem; color: var(--text-color); font-size: 1.2rem; font-weight: 700;">Select a Mock Examination</h3>
                
                <% if (!mocks || mocks.length === 0) { %>
                    <div style="padding: 2.5rem 1.5rem; text-align: center; color: var(--ntxt-color); border: 2px dashed var(--border-color); border-radius: 10px; background: rgba(255,255,255,0.01);">
                        <div style="font-size: 2.5rem; margin-bottom: 10px;">📋</div>
                        <h4 style="color: var(--text-color); margin-bottom: 6px;">No Mock Examinations Available</h4>
                        <p style="font-size: 0.9rem; margin-bottom: 15px;">There are no published mock examinations available under this category right now.</p>
                        <a href="/cbt" class="btn btn-secondary" style="padding: 8px 18px; font-size: 0.9rem;">View All Exam Hubs</a>
                    </div>
                <% } else { %>
                    <% 
                    const isUserSubscribed = (typeof isSubscribed !== 'undefined') ? isSubscribed : (locals.user && locals.user.has_paid);
                    %>
                    <% mocks.forEach((m, idx) => { %>
                        <% const isLocked = m.is_premium && !isUserSubscribed; %>
                        
                        <label style="display: block;">
                            <input type="radio" 
                                   name="mock_id" 
                                   value="<%= m.id %>" 
                                   class="mock-input" 
                                   data-duration="<%= m.time_limit_minutes || 60 %>" 
                                   data-title="<%= m.title %>"
                                   <%= idx === 0 && !isLocked ? 'checked' : '' %> 
                                   <%= isLocked ? 'disabled' : '' %> 
                                   required>
                            
                            <div class="mock-card <%= isLocked ? 'locked' : '' %>">
                                <div class="mock-card-info" style="flex: 1; padding-right: 15px;">
                                    <div class="mock-card-header" style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                                        <span class="exam-tag"><%= m.exam_code || m.exam_name %></span>
                                        <strong style="font-size: 1.05rem; color: var(--text-color);"><%= m.title %></strong>
                                    </div>
                                    <small style="color: var(--ntxt-color); font-size: 0.82rem; display: block;">
                                        <%= m.body_name || m.body_code %> &bull; <%= m.subject_count || 1 %> Subject<%= (m.subject_count == 1) ? '' : 's' %> &bull; <%= m.total_questions || 'Standard' %> Questions
                                    </small>
                                </div>
                                <div class="mock-card-badges" style="text-align: right; white-space: nowrap;">
                                    <span style="display: inline-block; padding: 4px 10px; border-radius: 6px; background: var(--bg-color); color: var(--text-color); font-size: 0.85rem; font-weight: 600;">⏱ <%= m.time_limit_minutes %> mins</span>
                                    <% if (m.is_premium) { %>
                                        <span style="display: inline-block; padding: 4px 8px; border-radius: 6px; background: rgba(168, 85, 247, 0.15); color: #c084fc; font-size: 0.8rem; font-weight: 700; margin-left: 6px;">★ Premium</span>
                                    <% } else { %>
                                        <span style="display: inline-block; padding: 4px 8px; border-radius: 6px; background: rgba(16, 185, 129, 0.15); color: #10b981; font-size: 0.8rem; font-weight: 700; margin-left: 6px;">Free</span>
                                    <% } %>
                                </div>

                                <% if (isLocked) { %>
                                    <div class="lock-overlay">
                                        <div class="lock-icon">
                                            🔒 <a href="/payment?locked=true">Unlock Premium Access</a>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        </label>
                    <% }) %>

                    <!-- Exam Duration / Time Limit Configuration -->
                    <div class="duration-card">
                        <div class="duration-card-header">
                            <div class="duration-title-group">
                                <span class="duration-header-icon">⏱️</span>
                                <div>
                                    <h4 class="duration-heading">Exam Duration / Time Limit</h4>
                                    <p class="duration-subheading">Choose official time or customize your examination duration.</p>
                                </div>
                            </div>
                            <div class="current-duration-pill">
                                <span>⏰</span>
                                <span id="activeDurationDisplay">120</span>
                                <span>Mins</span>
                            </div>
                        </div>

                        <label class="duration-section-label">Quick Presets:</label>
                        <div class="duration-presets-grid">
                            <button type="button" class="preset-pill-btn active" data-type="official" id="presetOfficial">
                                <span class="preset-name">Official Default</span>
                                <span class="preset-time" id="officialTimeBadge">120m</span>
                            </button>
                            <button type="button" class="preset-pill-btn" data-type="val" data-mins="30">
                                <span class="preset-name">Sprint Drill</span>
                                <span class="preset-time">30m</span>
                            </button>
                            <button type="button" class="preset-pill-btn" data-type="val" data-mins="60">
                                <span class="preset-name">Standard 1hr</span>
                                <span class="preset-time">60m</span>
                            </button>
                            <button type="button" class="preset-pill-btn" data-type="val" data-mins="90">
                                <span class="preset-name">Extended</span>
                                <span class="preset-time">90m</span>
                            </button>
                            <button type="button" class="preset-pill-btn" data-type="val" data-mins="120">
                                <span class="preset-name">JAMB Full</span>
                                <span class="preset-time">120m</span>
                            </button>
                            <button type="button" class="preset-pill-btn" data-type="custom" id="presetCustomToggle">
                                <span class="preset-name">Custom Time</span>
                                <span class="preset-time">Set Min ✏️</span>
                            </button>
                        </div>

                        <div class="custom-time-wrapper">
                            <label for="customDurationInput" class="duration-section-label" style="margin-bottom: 6px;">Custom Examination Minutes:</label>
                            <div class="custom-time-input-group">
                                <button type="button" class="stepper-btn" onclick="stepDuration(-5)" title="Decrease 5 minutes">− 5m</button>
                                <div class="input-inner">
                                    <input type="number" 
                                           id="customDurationInput" 
                                           name="custom_duration" 
                                           min="5" 
                                           max="360" 
                                           step="1"
                                           value="120" 
                                           class="custom-time-input" 
                                           required>
                                    <span class="input-suffix">mins</span>
                                </div>
                                <button type="button" class="stepper-btn" onclick="stepDuration(5)" title="Increase 5 minutes">+ 5m</button>
                            </div>
                            <div class="duration-hint">
                                <span>⚡ Minimum: <strong>5 minutes</strong></span>
                                <span>&bull;</span>
                                <span>Maximum: <strong>360 minutes (6 hrs)</strong></span>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary" style="width: 100%; padding: 14px; font-size: 1.05rem; font-weight: 700; margin-top: 1.2rem; border-radius: 8px;">Begin Examination Session</button>
                <% } %>
            </form>
        </div>
    </main>

    <script>
        (function() {
            const input = document.getElementById('customDurationInput');
            const display = document.getElementById('activeDurationDisplay');
            const officialBadge = document.getElementById('officialTimeBadge');
            const presetBtns = document.querySelectorAll('.preset-pill-btn');
            const customToggleBtn = document.getElementById('presetCustomToggle');
            let isCustomMode = false;

            function getSelectedMockDefault() {
                const checked = document.querySelector('input[name="mock_id"]:checked');
                if (checked && checked.dataset.duration) {
                    return parseInt(checked.dataset.duration) || 60;
                }
                return 60;
            }

            function setDuration(val, isCustom) {
                let num = parseInt(val);
                if (isNaN(num)) num = 60;
                if (num < 5) num = 5;
                if (num > 360) num = 360;

                if (input) input.value = num;
                if (display) display.textContent = num;
                isCustomMode = !!isCustom;

                presetBtns.forEach(btn => {
                    btn.classList.remove('active');
                    const type = btn.dataset.type;
                    if (!isCustomMode && type === 'official' && num === getSelectedMockDefault()) {
                        btn.classList.add('active');
                    } else if (type === 'val' && parseInt(btn.dataset.mins) === num) {
                        btn.classList.add('active');
                    } else if (isCustomMode && type === 'custom') {
                        btn.classList.add('active');
                    }
                });
            }

            function updateOfficialTime() {
                const official = getSelectedMockDefault();
                if (officialBadge) officialBadge.textContent = official + 'm';
                if (!isCustomMode) {
                    setDuration(official, false);
                }
            }

            window.stepDuration = function(delta) {
                const current = parseInt(input ? input.value : 60) || 60;
                setDuration(current + delta, true);
            };

            // Mock selection change
            document.querySelectorAll('input[name="mock_id"]').forEach(radio => {
                radio.addEventListener('change', () => {
                    updateOfficialTime();
                });
            });

            // Preset buttons click
            presetBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    const type = btn.dataset.type;
                    if (type === 'official') {
                        setDuration(getSelectedMockDefault(), false);
                    } else if (type === 'val') {
                        setDuration(parseInt(btn.dataset.mins), false);
                    } else if (type === 'custom') {
                        isCustomMode = true;
                        presetBtns.forEach(b => b.classList.remove('active'));
                        btn.classList.add('active');
                        if (input) {
                            input.focus();
                            input.select();
                        }
                    }
                });
            });

            if (input) {
                input.addEventListener('input', () => {
                    let val = parseInt(input.value);
                    if (!isNaN(val)) {
                        if (val > 360) val = 360;
                        if (display) display.textContent = val;
                    }
                    isCustomMode = true;
                    presetBtns.forEach(b => b.classList.remove('active'));
                    if (customToggleBtn) customToggleBtn.classList.add('active');
                });

                input.addEventListener('blur', () => {
                    let val = parseInt(input.value);
                    if (isNaN(val) || val < 5) val = 5;
                    if (val > 360) val = 360;
                    input.value = val;
                    if (display) display.textContent = val;
                });
            }

            // Init on load
            updateOfficialTime();
            setDuration(getSelectedMockDefault(), false);
        })();
    </script>
</body>
</html>
