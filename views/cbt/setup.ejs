<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mock Examination Setup - KelselPDF</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <style>
        .setup-container { max-width: 600px; margin: 3rem auto; background: var(--card-bg); padding: 2rem; border-radius: 12px; border: 1px solid var(--border-color); }
        .rules { background: rgba(239, 68, 68, 0.05); border: 1px solid #ef4444; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; }
        .rules ul { margin-left: 1.5rem; margin-top: 0.5rem; color: var(--ntxt-color); }
        .rules li { margin-bottom: 0.5rem; }
        
        .mock-card { border: 2px solid var(--border-color); padding: 15px; border-radius: 8px; cursor: pointer; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; position: relative; overflow: hidden; }
        .mock-card:hover { border-color: var(--primary-color); }
        .mock-input { display: none; }
        .mock-input:checked + .mock-card { border-color: #ef4444; background: rgba(239, 68, 68, 0.05); }
        
        .mock-card.locked { opacity: 0.6; cursor: not-allowed; border-color: var(--border-color) !important; background: var(--bg-color) !important; }
        .lock-overlay { position: absolute; inset: 0; display: flex; justify-content: center; align-items: center; background: rgba(0,0,0,0.1); backdrop-filter: blur(1px); }
        .lock-icon { background: #f59e0b; color: white; padding: 5px 10px; border-radius: 20px; font-weight: bold; font-size: 0.85rem; display: flex; align-items: center; gap: 5px; }
        .lock-icon a { color: white; text-decoration: none; }
    </style>
</head>
<body class="dashboard-body">
    <%- include('../acct/partials/sidebar', { active_page: locals.active_page }) %>

    <main class="main-content">
        <%- include('../acct/partials/app_header', { 
            page_title: `CBT Engine Setup`, 
            page_desc: 'Start a timed mock examination.',
            header_style: 'background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);',
            header_icon: '<svg width="20" height="20" fill="white" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>',
            search_placeholder: 'Search exams...'
        }) %>

        <div class="setup-container">
            <div class="rules">
                <strong style="color: #ef4444;">Examination Rules:</strong>
                <ul>
                    <li>You will be placed in a strictly timed session.</li>
                    <li>Questions and options are randomized.</li>
                    <li>You must remain in fullscreen mode.</li>
                    <li>Switching browser tabs will be recorded as a violation.</li>
                    <li>Your answers will auto-save.</li>
                </ul>
            </div>
            
            <form action="/cbt/start" method="POST">
                <h3 style="margin-bottom: 1rem; color: var(--text-color);">Select a Mock Examination</h3>
                
                <% if(mocks.length === 0) { %>
                    <div style="padding: 2rem; text-align: center; color: var(--ntxt-color); border: 1px dashed var(--border-color); border-radius: 8px;">
                        No Mock Examinations are currently available. Check back later!
                    </div>
                <% } else { %>
                    <% mocks.forEach((m, idx) => { %>
                        <% const isLocked = m.is_premium && !isSubscribed; %>
                        
                        <label>
                            <input type="radio" name="mock_id" value="<%= m.id %>" class="mock-input" <%= idx === 0 && !isLocked ? 'checked' : '' %> <%= isLocked ? 'disabled' : '' %> required>
                            
                            <div class="mock-card <%= isLocked ? 'locked' : '' %>">
                                <div>
                                    <strong style="font-size: 1.1rem; color: var(--text-color); display: block;"><%= m.title %></strong>
                                    <small style="color: var(--ntxt-color);"><%= m.body_name %> - <%= m.exam_name %></small>
                                </div>
                                <div style="text-align: right;">
                                    <span style="display: inline-block; padding: 4px 8px; border-radius: 4px; background: var(--bg-color); color: var(--ntxt-color); font-size: 0.85rem;"><%= m.time_limit_minutes %> mins</span>
                                    <% if (m.is_premium) { %>
                                        <span style="display: inline-block; padding: 4px 8px; border-radius: 4px; background: rgba(245, 158, 11, 0.1); color: #f59e0b; font-size: 0.85rem; margin-left: 5px;">Premium</span>
                                    <% } %>
                                </div>

                                <% if (isLocked) { %>
                                    <div class="lock-overlay">
                                        <div class="lock-icon">
                                            🔒 <a href="/payment?locked=true">Unlock Premium Access</a>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        </label>
                    <% }) %>
                    <button type="submit" class="btn btn-primary" style="width: 100%; padding: 14px; font-size: 1.1rem; margin-top: 1.5rem; background: #ef4444; border:none;">Start Examination</button>
                <% } %>
            </form>
        </div>
    </main>
</body>
</html>
