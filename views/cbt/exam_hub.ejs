<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= body.code %> Hub - KelselPDF</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <style>
        .hub-container { max-width: 900px; margin: 3rem auto; }
        .action-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 2rem; }
        .action-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 30px;
            text-decoration: none;
            transition: transform 0.2s ease, border-color 0.2s ease;
            position: relative;
            overflow: hidden;
        }
        .action-card:hover {
            transform: translateY(-5px);
            border-color: var(--primary-color);
        }
        .action-title { font-size: 1.5rem; font-weight: 800; color: var(--text-color); margin-bottom: 10px; }
        .action-desc { color: var(--ntxt-color); font-size: 0.95rem; line-height: 1.5; }
        
        .mock-theme { border-top: 4px solid #ef4444; }
        .practice-theme { border-top: 4px solid #3b82f6; }
        .analytics-theme { border-top: 4px solid #10b981; }
    </style>
</head>
<body class="dashboard-body">
    <%- include('../acct/partials/sidebar', { active_page: 'cbt_hub' }) %>

    <main class="main-content">
        <div style="margin-bottom: 20px;">
            <a href="/cbt" style="color: var(--ntxt-color); text-decoration: none; font-weight: bold;">← Back to Hub</a>
        </div>
        
        <%- include('../acct/partials/app_header', { 
            page_title: `${body.code} Study Hub`, 
            page_desc: body.name,
            header_style: 'background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);'
        }) %>

        <div class="hub-container">
            <h3 style="color: var(--text-color); font-size: 1.5rem; margin-bottom: 10px;">Continue Preparation</h3>
            
            <div class="action-grid">
                <a href="/cbt/setup?body_id=<%= body.id %>" class="action-card mock-theme">
                    <div class="action-title">Take Full Mock 🎯</div>
                    <div class="action-desc">Experience a fully timed, realistic CBT simulation with randomized questions across your selected subjects.</div>
                </a>
                
                <a href="/practice?body=<%= body.id %>" class="action-card practice-theme">
                    <div class="action-title">Past Questions 📚</div>
                    <div class="action-desc">Practice specific subjects and years at your own pace. Untimed, with instant feedback and explanations.</div>
                </a>

                <a href="/payment" class="action-card analytics-theme" style="grid-column: span 2; display: flex; align-items: center; justify-content: space-between;">
                    <div>
                        <div class="action-title">My Performance 📈</div>
                        <div class="action-desc">View your advanced subject accuracy radar charts and recommendations.</div>
                    </div>
                    <div style="background: var(--bg-color); padding: 10px 20px; border-radius: 8px; color: var(--text-color); font-weight: bold;">Coming soon</div>
                </a>
            </div>
        </div>
    </main>
</body>
</html>
