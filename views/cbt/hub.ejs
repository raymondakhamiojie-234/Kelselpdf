<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CBT Hub - KelselPDF</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <style>
        .hub-container { max-width: 900px; margin: 3rem auto; text-align: center; }
        .hub-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 2rem; }
        .body-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 30px 20px;
            text-align: center;
            text-decoration: none;
            transition: transform 0.2s ease, border-color 0.2s ease;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 150px;
        }
        .body-card:hover {
            transform: translateY(-5px);
            border-color: var(--primary-color);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }
        .body-code { font-size: 2rem; font-weight: 800; color: var(--text-color); margin-bottom: 5px; }
        .body-name { font-size: 0.85rem; color: var(--ntxt-color); text-transform: uppercase; letter-spacing: 0.5px; }

        @media (max-width: 768px) {
            .hub-container {
                margin: 1.5rem auto 2.5rem;
                padding: 0 0.5rem;
            }
            .hub-container h2 {
                font-size: 1.4rem !important;
            }
            .hub-container p {
                font-size: 0.92rem !important;
            }
            .hub-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 12px;
                margin-top: 1.25rem;
            }
            .body-card {
                padding: 20px 12px;
                min-height: 120px;
                border-radius: 14px;
            }
            .body-code {
                font-size: 1.5rem;
                margin-bottom: 4px;
            }
            .body-name {
                font-size: 0.72rem;
                line-height: 1.3;
            }
        }
    </style>
</head>
<body class="dashboard-body">
    <%- include('../acct/partials/sidebar', { active_page: 'cbt_hub' }) %>

    <main class="main-content">
        <%- include('../acct/partials/app_header', { 
            page_title: `CBT Study Hub`, 
            page_desc: `Choose your target examination to begin.`,
            header_style: 'background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);'
        }) %>

        <div class="hub-container">
            <!-- AAU Separation Notice -->
            <div style="background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 14px; padding: 14px 18px; margin-bottom: 2rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; text-align: left;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <span style="font-size: 1.6rem;">🎓</span>
                    <div>
                        <strong style="color: #10b981; font-size: 0.95rem; display: block;">AAU Undergraduate Student?</strong>
                        <span style="color: var(--ntxt-color); font-size: 0.82rem;">Looking for your Ambrose Alli University semester courses (GST 111, BIO 111, MTH 112, etc.)?</span>
                    </div>
                </div>
                <a href="/exam/setup" style="background: #10b981; color: white; padding: 8px 16px; border-radius: 8px; font-weight: 600; font-size: 0.85rem; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;">
                    Go to AAU Course CBT &rarr;
                </a>
            </div>

            <h2 style="color: var(--text-color); font-size: 2rem; margin-bottom: 10px;">National Exam Bodies (JAMB, WAEC, NECO)</h2>
            <p style="color: var(--ntxt-color); font-size: 1.05rem;">Select your target examination body below to take official UTME/SSCE mock simulations.</p>
            
            <div class="hub-grid">
                <% examBodies.forEach(b => { %>
                    <a href="/cbt/hub/<%= b.code %>" class="body-card">
                        <div class="body-code"><%= b.code %></div>
                        <div class="body-name"><%= b.name %></div>
                    </a>
                <% }) %>
            </div>
        </div>
    </main>
</body>
</html>
