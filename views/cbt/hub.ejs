<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CBT Hub - KelselPDF</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <style>
        .hub-container { max-width: 900px; margin: 3rem auto; text-align: center; }
        .hub-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 2rem; }
        .body-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 30px 20px;
            text-align: center;
            text-decoration: none;
            transition: transform 0.2s ease, border-color 0.2s ease;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 150px;
        }
        .body-card:hover {
            transform: translateY(-5px);
            border-color: var(--primary-color);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }
        .body-code { font-size: 2rem; font-weight: 800; color: var(--text-color); margin-bottom: 5px; }
        .body-name { font-size: 0.85rem; color: var(--ntxt-color); text-transform: uppercase; letter-spacing: 0.5px; }
    </style>
</head>
<body class="dashboard-body">
    <%- include('../acct/partials/sidebar', { active_page: 'cbt_hub' }) %>

    <main class="main-content">
        <%- include('../acct/partials/app_header', { 
            page_title: `CBT Study Hub`, 
            page_desc: `Choose your target examination to begin.`,
            header_style: 'background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);'
        }) %>

        <div class="hub-container">
            <h2 style="color: var(--text-color); font-size: 2rem; margin-bottom: 10px;">What are you preparing for?</h2>
            <p style="color: var(--ntxt-color); font-size: 1.1rem;">Select an examination body to access Mocks, Past Questions, and Analytics.</p>
            
            <div class="hub-grid">
                <% examBodies.forEach(b => { %>
                    <a href="/cbt/hub/<%= b.code %>" class="body-card">
                        <div class="body-code"><%= b.code %></div>
                        <div class="body-name"><%= b.name %></div>
                    </a>
                <% }) %>
            </div>
        </div>
    </main>
</body>
</html>
